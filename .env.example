# Browser-facing API URL. Keep /api routing on the same origin in production.
PUBLIC_API_URL=http://localhost:8787

# Server-side API URL used by Astro SSR.
API_INTERNAL_URL=http://localhost:8787

# Opt-in same-origin package authentication pilot. Keep false until its
# application-owned migration, email delivery, and browser checks are ready.
PUBLIC_AUTH_PILOT_ENABLED=false

# Cloudflare account containing the Web Analytics sites Observatory reads.
# Find it in Cloudflare Dashboard > Account home. This identifier is not secret,
# but keeping it beside the token makes local configuration easier.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# Server-only Cloudflare API token used by the API Worker to query the GraphQL
# Analytics API. Required permission: Account > Account Analytics > Read.
# Never prefix this variable with PUBLIC_ or expose it to browser code.
CLOUDFLARE_API_TOKEN=your-cloudflare-analytics-read-token
