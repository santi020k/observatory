{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "API_INTERNAL_URL",
    "AUTH_SECRET",
    "CORS_ORIGIN",
    "ENVIRONMENT",
    "GITHUB_TOKEN",
    "MAIL_FROM",
    "OWNER_EMAIL",
    "PUBLIC_API_URL",
    "RESEND_API_KEY"
  ],
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**"]
    },
    "check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
