{
  "name": "@santi020k/observatory-root",
  "version": "0.4.0",
  "private": true,
  "description": "Private portfolio operations control room for product, package, deployment, and repository signals.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "check:auth-pilot-bundle": "node scripts/validate-auth-pilot-bundle.mjs",
    "check:auth-pilot-config": "node scripts/validate-auth-pilot-config.mjs",
    "check:security": "pnpm audit --prod",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "commit": "commitprompt",
    "db:migrate:local": "pnpm --filter @santi020k/observatory-api run db:migrate:local",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @santi020k/observatory-api dev",
    "dev:web": "pnpm --filter @santi020k/observatory-web dev",
    "doctor": "pnpm --filter @santi020k/observatory-web doctor",
    "lint": "pnpm run lint:repo && turbo run lint",
    "lint:fix": "pnpm run lint:repo:fix && turbo run lint:fix",
    "lint:repo": "eslint . --cache --no-warn-ignored --max-warnings=0",
    "lint:repo:fix": "eslint . --cache --fix --no-warn-ignored --max-warnings=0",
    "release:validate-tag": "node scripts/validate-release-tag.mjs",
    "release:status": "changeset status",
    "release:version": "changeset version && node scripts/sync-root-version.mjs",
    "setup:github": "node scripts/setup-github-token.mjs",
    "setup:local": "node scripts/setup-local.mjs && pnpm run hooks:install",
    "test": "turbo run test && node --test scripts/*.test.mjs",
    "type-check": "turbo run type-check",
    "verify": "pnpm run check:auth-pilot-bundle && pnpm run check:auth-pilot-config && pnpm run lint && pnpm run check && pnpm run type-check && pnpm run test && pnpm run doctor && pnpm run check:security && pnpm run build",
    "hooks:install": "node scripts/install-quality-hooks.mjs",
    "pre-push": "pnpm run verify"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@santi020k/commitprompt": "catalog:",
    "@santi020k/eslint-config-astro": "catalog:",
    "@santi020k/eslint-config-basic": "catalog:",
    "@santi020k/eslint-config-extensions": "catalog:",
    "@santi020k/eslint-config-formats": "catalog:",
    "@santi020k/eslint-config-hono": "catalog:",
    "@santi020k/eslint-config-libraries": "catalog:",
    "@santi020k/eslint-config-testing": "catalog:",
    "@santi020k/eslint-config-tools": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-astro": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
