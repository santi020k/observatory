AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_PILOT_ENABLED=false
OWNER_PASSCODE=replace-with-a-private-recovery-code
CORS_ORIGIN=http://localhost:4321,http://localhost:4322
ENVIRONMENT=development
MAIL_FROM=Observatory <observatory@example.com>
OWNER_EMAIL=you@example.com
SITE_URL=http://localhost:4321

# Optional. Enables aggregate App Store Analytics Reports collection. The
# request mapping contains existing ONGOING Analytics Report request IDs;
# Observatory never creates or deletes report requests.
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_PRIVATE_KEY=
APP_STORE_CONNECT_REPORT_REQUESTS_JSON={"postlens":"request-id","betweencontractions":"request-id"}

# Optional. Enables read-only Google Play CSV report collection from the
# account's private reporting bucket. Store the full service-account JSON as a
# secret; never expose it to the web app.
GOOGLE_PLAY_REPORT_BUCKET=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Optional dedicated key for hashing feedback voter and rate-limit identifiers.
# AUTH_SECRET is used when omitted.
FEEDBACK_HASH_SECRET=

# Optional in development because Turnstile is bypassed locally. Configure both
# values in production for public website submissions.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional as a pair. Enables Cloudflare Web Analytics collection.
# Account ID: Cloudflare Dashboard > Account home.
CLOUDFLARE_ACCOUNT_ID=

# Server-only API token. Required permission:
# Account > Account Analytics > Read.
CLOUDFLARE_API_TOKEN=

# Optional in local development. When omitted, the API returns the code in
# `developmentCode` so the full login flow can still be tested.
RESEND_API_KEY=

# Optional. Enables authenticated GitHub traffic metrics and a higher rate limit.
GITHUB_TOKEN=
