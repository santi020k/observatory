{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "santi-observatory-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "observatory",
      "database_id": "4cc1ece3-cd43-4916-b9b5-12c73343c81b",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": {
    "crons": ["17 * * * *", "37 17 * * *"],
  },
  "routes": [
    {
      "pattern": "api.observatory.santi020k.com",
      "custom_domain": true,
    },
    {
      "pattern": "postlens.santi020k.com/api/feedback/*",
      "zone_name": "santi020k.com",
    },
    {
      "pattern": "roadscore.santi020k.com/api/feedback/*",
      "zone_name": "santi020k.com",
    },
    {
      "pattern": "between.santi020k.com/api/feedback/*",
      "zone_name": "santi020k.com",
    },
  ],
  "vars": {
    "ENVIRONMENT": "production",
  },
  "observability": {
    "enabled": true,
  },
}
