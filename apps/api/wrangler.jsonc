{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "santi-observatory-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "observatory",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": {
    "crons": ["17 * * * *"],
  },
  "routes": [
    {
      "pattern": "postlens.santi020k.com/api/feedback/*",
      "zone_name": "santi020k.com",
    },
    {
      "pattern": "roadscore.santi020k.com/api/feedback/*",
      "zone_name": "santi020k.com",
    },
    {
      "pattern": "between.santi020k.com/api/feedback/*",
      "zone_name": "santi020k.com",
    },
  ],
  "vars": {
    "ENVIRONMENT": "production",
  },
  "observability": {
    "enabled": true,
  },
}
