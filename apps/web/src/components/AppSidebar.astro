---
import { Badge, Button, Icon, Sidebar } from '@santi020k/lumen-astro'
import type {
  AnalyticsRange,
  ProjectSettings
} from '@santi020k/observatory-api-types'

import Brand from './Brand.astro'

type SidebarProject = Pick<
  ProjectSettings['projects'][number],
  'category' | 'name' | 'pinned' | 'slug'
>

interface Props {
  projects: SidebarProject[]
  range?: AnalyticsRange
}

const { projects, range = '30d' } = Astro.props

const orderedProjects = [...projects].sort(
  (left, right) => Number(right.pinned) - Number(left.pinned)
)

const currentPath = Astro.url.pathname
const currentSlug = /^\/projects\/([^/]+)/.exec(currentPath)?.[1]

const getCategoryIcon = (
  category: SidebarProject['category']
): 'blocks' | 'layout-dashboard' | 'notebook-tabs' | 'wrench' => {
  if (category === 'app') return 'layout-dashboard'

  if (category === 'content') return 'notebook-tabs'

  if (category === 'tool') return 'wrench'

  return 'blocks'
}
---

<Sidebar
  aria-label="Observatory navigation"
  class="app-sidebar"
  data-app-sidebar
  id="app-sidebar"
>
  <div class="app-sidebar__brand">
    <Brand />
    <Button
      aria-label="Close navigation"
      class="sidebar-close"
      data-sidebar-close
      size="icon"
      type="button"
      variant="ghost"
    >
      <Icon aria-hidden="true" name="x" />
    </Button>
  </div>

  <nav aria-label="Primary navigation" class="sidebar-nav">
    <a
      aria-current={currentPath === '/dashboard/' ? 'page' : undefined}
      class="sidebar-link sidebar-link--overview"
      href={`/dashboard/?range=${range}`}
    >
      <Icon aria-hidden="true" name="layout-dashboard" />
      <span>
        <strong>Main dashboard</strong>
        <small>Portfolio overview</small>
      </span>
    </a>

    <a
      aria-current={currentPath.startsWith('/feedback/') ? 'page' : undefined}
      class="sidebar-link sidebar-link--overview"
      href="/feedback/"
    >
      <Icon aria-hidden="true" name="messages-square" />
      <span>
        <strong>Feedback operations</strong>
        <small>Inbox and kanbans</small>
      </span>
    </a>

    <a
      aria-current={currentPath === '/store/' ? 'page' : undefined}
      class="sidebar-link sidebar-link--overview"
      href={`/store/?range=${range}`}
    >
      <Icon aria-hidden="true" name="download" />
      <span>
        <strong>Published apps</strong>
        <small>Installs and store health</small>
      </span>
    </a>

    <div class="sidebar-projects">
      <div class="sidebar-section-heading">
        <span>Project dashboards</span>
        <Badge variant="outline">{orderedProjects.length}</Badge>
      </div>

      {
        orderedProjects.length > 0 ?
          (
            <ul>
              {orderedProjects.map(project => (
                <li>
                  <a
                    aria-current={
                      currentSlug === project.slug ? 'page' : undefined
                    }
                    class="sidebar-link"
                    href={`/projects/${project.slug}/?range=${range}`}
                  >
                    <span class="sidebar-link__icon">
                      <Icon
                        aria-hidden="true"
                        name={getCategoryIcon(project.category)}
                      />
                    </span>
                    <span>
                      <strong>
                        {project.name}
                        {project.pinned && (
                          <Icon aria-label="Pinned project" name="pin" />
                        )}
                      </strong>
                      <small>{project.category}</small>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          ) :
          (
            <p class="sidebar-empty">Sync projects to populate this list.</p>
          )
      }
    </div>
  </nav>

  <div class="app-sidebar__footer">
    <a
      aria-current={currentPath === '/settings/' ? 'page' : undefined}
      class="sidebar-link"
      href="/settings/"
    >
      <Icon aria-hidden="true" name="settings" />
      <span>
        <strong>Settings</strong>
        <small>Project controls</small>
      </span>
    </a>
    <div class="sidebar-private">
      <span class="status-dot"></span>
      <span>
        <strong>Private workspace</strong>
        <small>Owner access only</small>
      </span>
    </div>
  </div>
</Sidebar>

<button
  aria-label="Close navigation"
  class="sidebar-backdrop"
  data-sidebar-close
  tabindex="-1"
  type="button"
>
</button>

<noscript>
  <style is:global>
    @media (max-width: 52rem) {
      .app-shell { display: block; height: auto; overflow: visible; }
      .app-sidebar { position: relative; width: 100%; height: auto; transform: none; }
      .app-workspace { height: auto; overflow: visible; }
      .sidebar-trigger, .sidebar-close { display: none; }
    }
  </style>
</noscript>
