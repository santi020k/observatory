---
import Badge from '@santi020k/lumen-astro/components/Badge'
import Button from '@santi020k/lumen-astro/components/Button'
import Icon from '@santi020k/lumen-astro/components/Icon'
import ThemeToggle from '@santi020k/lumen-astro/components/ThemeToggle'

interface Props {
  apiUrl: string
  lastSync: string
  syncStatus: 'failed' | 'idle' | 'running' | 'succeeded'
}

const { apiUrl, lastSync, syncStatus } = Astro.props
---

<header class="app-header" data-api-url={apiUrl}>
  <button
    aria-controls="app-sidebar"
    aria-expanded="false"
    aria-label="Open navigation"
    class="sidebar-trigger"
    data-sidebar-trigger
    type="button"
  >
    <Icon aria-hidden="true" name="menu" />
  </button>
  <span class="app-header__context">Observatory workspace</span>
  <div class="app-header__actions">
    <Badge variant="outline"
      ><span class="status-dot"></span> Private workspace</Badge
    >
    {
      syncStatus === 'failed' && (
        <Badge variant="warning">Last sync failed</Badge>
      )
    }
    <span class="sync-meta">Updated {lastSync}</span>
    <Button data-sync-button size="sm" variant="outline">
      <Icon aria-hidden="true" name="refresh-cw" />
      Sync now
    </Button>
    <ThemeToggle title="Toggle color theme" />
    <Button
      data-logout-button
      size="icon"
      variant="ghost"
      aria-label="Sign out"
    >
      <Icon aria-hidden="true" name="log-out" />
    </Button>
  </div>
</header>

<script>
  const syncButtons =
    document.querySelectorAll<HTMLButtonElement>('[data-sync-button]')

  const logoutButton = document.querySelector<HTMLButtonElement>(
    '[data-logout-button]',
  )

  const header = document.querySelector<HTMLElement>('.app-header')
  const apiUrl = header?.dataset.apiUrl ?? '/api'
  const sidebar = document.querySelector<HTMLElement>('[data-app-sidebar]')

  const sidebarTrigger = document.querySelector<HTMLButtonElement>(
    '[data-sidebar-trigger]',
  )

  const sidebarCloseButtons = document.querySelectorAll<HTMLButtonElement>(
    '[data-sidebar-close]',
  )

  const closeSidebar = () => {
    sidebar?.classList.remove('is-open')

    document.body.classList.remove('sidebar-open')

    sidebarTrigger?.setAttribute('aria-expanded', 'false')
  }

  sidebarTrigger?.addEventListener('click', () => {
    const isOpen = !sidebar?.classList.contains('is-open')

    sidebar?.classList.toggle('is-open', isOpen)

    document.body.classList.toggle('sidebar-open', isOpen)

    sidebarTrigger.setAttribute('aria-expanded', String(isOpen))

    if (isOpen)
      sidebar
        ?.querySelector<HTMLAnchorElement>('a, button')
        ?.focus({ preventScroll: true })
  })

  for (const closeButton of sidebarCloseButtons)
    closeButton.addEventListener('click', closeSidebar)

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeSidebar()

      sidebarTrigger?.focus({ preventScroll: true })
    }
  })

  for (const syncButton of syncButtons) {
    syncButton.addEventListener('click', async () => {
      const originalLabels = new Map(
        [...syncButtons].map((button) => [button, button.innerHTML]),
      )

      for (const button of syncButtons) {
        button.disabled = true

        button.setAttribute('aria-busy', 'true')
      }

      syncButton.textContent = 'Syncing…'

      try {
        const response = await fetch(`${apiUrl}/sync`, {
          credentials: 'include',
          method: 'POST',
        })

        if (!response.ok) throw new Error('Sync failed')

        window.location.reload()
      } catch {
        syncButton.textContent = 'Try again'

        window.setTimeout(() => {
          for (const button of syncButtons) {
            button.innerHTML = originalLabels.get(button) ?? 'Sync now'

            button.disabled = false

            button.removeAttribute('aria-busy')
          }
        }, 2_000)
      }
    })
  }

  logoutButton?.addEventListener('click', async () => {
    await fetch(`${apiUrl}/auth/logout`, {
      credentials: 'include',
      method: 'POST',
    })

    window.location.assign('/login/')
  })
</script>
