---
import { Badge, Button, Icon, ThemeToggle } from '@santi020k/lumen-astro'

interface Props {
  apiUrl: string
  lastSync: string
  syncPath?: '/sync' | '/sync/stores'
  syncStatus: 'failed' | 'idle' | 'running' | 'succeeded'
  syncSubject?: string
}

const {
  apiUrl,
  lastSync,
  syncPath = '/sync',
  syncStatus,
  syncSubject = 'project and website analytics data'
} = Astro.props
---

<header
  class="app-header"
  data-api-url={apiUrl}
  data-sync-path={syncPath}
  data-sync-subject={syncSubject}
>
  <Button
    aria-controls="app-sidebar"
    aria-expanded="false"
    aria-label="Open navigation"
    class="sidebar-trigger"
    data-sidebar-trigger
    size="icon"
    type="button"
    variant="ghost"
  >
    <Icon aria-hidden="true" name="menu" />
  </Button>
  <div class="app-header__workspace">
    <span class="app-header__context">Observatory</span>
    <Badge variant="outline"><span class="status-dot"></span> Private workspace
    </Badge
    >
  </div>
  <div class="app-header__actions">
    {
      syncStatus === 'failed' && (
        <Badge variant="warning">Last sync failed</Badge>
      )
    }
    <div class="app-header__sync">
      <span class="sync-meta">Updated {lastSync}</span>
      <Button
        aria-label={`Sync ${syncSubject}`}
        data-sync-button
        size="sm"
        title="Sync now"
        variant="outline"
      >
        <Icon aria-hidden="true" name="refresh-cw" />
        <span data-sync-label>Sync now</span>
      </Button>
    </div>
    <div class="app-header__utilities">
      <ThemeToggle class="header-theme-toggle" title="Toggle color theme" />
      <Button
        class="header-icon-button"
        data-logout-button
        size="icon"
        variant="ghost"
        aria-label="Sign out"
        title="Sign out"
      >
        <Icon aria-hidden="true" name="log-out" />
      </Button>
    </div>
  </div>
  <span
    class="sr-only"
    aria-atomic="true"
    aria-live="polite"
    data-header-status
  >
  </span>
</header>

<script>
import { createSantiAuthHelpers } from '@santi020k/auth-client'

const auth = createSantiAuthHelpers({
  basePath: '/api/auth',
  baseURL: window.location.origin
})

const syncButtons =
  document.querySelectorAll<HTMLButtonElement>('[data-sync-button]')

const logoutButton = document.querySelector<HTMLButtonElement>(
  '[data-logout-button]'
)

const header = document.querySelector<HTMLElement>('.app-header')
const apiUrl = header?.dataset.apiUrl ?? '/api'
const syncPath = header?.dataset.syncPath ?? '/sync'

const syncSubject =
  header?.dataset.syncSubject ?? 'project and website analytics data'

const sidebar = document.querySelector<HTMLElement>('[data-app-sidebar]')

const sidebarTrigger = document.querySelector<HTMLButtonElement>(
  '[data-sidebar-trigger]'
)

const sidebarCloseButtons = document.querySelectorAll<HTMLButtonElement>(
  '[data-sidebar-close]'
)

const mobileSidebarQuery = window.matchMedia('(max-width: 52rem)')

const headerStatus = document.querySelector<HTMLElement>(
  '[data-header-status]'
)

const syncSidebarAccessibility = () => {
  if (!sidebar) return

  const isOpen = sidebar.classList.contains('is-open')
  const isHidden = mobileSidebarQuery.matches && !isOpen

  sidebar.toggleAttribute('inert', isHidden)

  if (isHidden) sidebar.setAttribute('aria-hidden', 'true')
  else sidebar.removeAttribute('aria-hidden')
}

const closeSidebar = (restoreFocus = false) => {
  const wasOpen = sidebar?.classList.contains('is-open') ?? false

  sidebar?.classList.remove('is-open')

  document.body.classList.remove('sidebar-open')

  sidebarTrigger?.setAttribute('aria-expanded', 'false')

  syncSidebarAccessibility()

  if (restoreFocus && wasOpen) sidebarTrigger?.focus({ preventScroll: true })
}

const openSidebar = () => {
  sidebar?.classList.add('is-open')

  document.body.classList.add('sidebar-open')

  sidebarTrigger?.setAttribute('aria-expanded', 'true')

  syncSidebarAccessibility()

  sidebar
    ?.querySelector<HTMLElement>(
      'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
    )
    ?.focus({ preventScroll: true })
}

sidebarTrigger?.addEventListener('click', () => {
  const isOpen = !sidebar?.classList.contains('is-open')

  if (isOpen) openSidebar()
  else closeSidebar(true)
})

for (const closeButton of sidebarCloseButtons)
  closeButton.addEventListener('click', () => closeSidebar(true))

const shouldTrapSidebarFocus = (event: KeyboardEvent): boolean => event.key === 'Tab' &&
  mobileSidebarQuery.matches &&
  sidebar?.classList.contains('is-open') === true

const trapSidebarFocus = (event: KeyboardEvent) => {
  if (!shouldTrapSidebarFocus(event) || !sidebar) return

  const focusable = [
    ...sidebar.querySelectorAll<HTMLElement>(
      'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
    )
  ].filter(element => !element.hasAttribute('hidden'))

  const first = focusable.at(0)
  const last = focusable.at(-1)

  if (!first || !last) return

  if (event.shiftKey && document.activeElement === first) {
    event.preventDefault()

    last.focus()
  } else if (!event.shiftKey && document.activeElement === last) {
    event.preventDefault()

    first.focus()
  }
}

document.addEventListener('keydown', event => {
  if (event.key === 'Escape' && sidebar?.classList.contains('is-open')) {
    closeSidebar(true)

    return
  }

  trapSidebarFocus(event)
})

mobileSidebarQuery.addEventListener('change', () => {
  if (mobileSidebarQuery.matches) syncSidebarAccessibility()
  else closeSidebar()
})

syncSidebarAccessibility()

const setSyncButtonLabel = (button: HTMLButtonElement, label: string) => {
  const labelElement = button.querySelector<HTMLElement>('[data-sync-label]')

  if (labelElement) labelElement.textContent = label
  else button.textContent = label

  button.setAttribute('aria-label', label)
}

for (const syncButton of syncButtons) {
  syncButton.addEventListener('click', async () => {
    const originalContents = new Map(
      [...syncButtons].map(button => [button, button.innerHTML])
    )

    const originalLabels = new Map(
      [...syncButtons].map(button => [
        button,
        button.getAttribute('aria-label') ?? 'Sync now'
      ])
    )

    for (const button of syncButtons) {
      button.disabled = true

      button.setAttribute('aria-busy', 'true')

      setSyncButtonLabel(button, 'Syncing…')
    }

    if (headerStatus)
      headerStatus.textContent = `Syncing ${syncSubject}.`

    try {
      const response = await fetch(`${apiUrl}${syncPath}`, {
        credentials: 'include',
        method: 'POST'
      })

      if (!response.ok) throw new Error('Sync failed')

      if (headerStatus)
        headerStatus.textContent = 'Sync complete. Refreshing the dashboard.'

      window.location.reload()
    } catch {
      setSyncButtonLabel(syncButton, 'Try again')

      if (headerStatus)
        headerStatus.textContent =
          'Sync failed. Check your connection and try again.'

      window.setTimeout(() => {
        for (const button of syncButtons) {
          button.innerHTML = originalContents.get(button) ?? 'Sync now'

          button.setAttribute(
            'aria-label', originalLabels.get(button) ?? 'Sync now'
          )

          button.disabled = false

          button.removeAttribute('aria-busy')
        }
      }, 2_000)
    }
  })
}

logoutButton?.addEventListener('click', async () => {
  logoutButton.disabled = true

  logoutButton.setAttribute('aria-busy', 'true')

  if (headerStatus) headerStatus.textContent = 'Signing out.'

  try {
    const result = await auth.signOut()

    if (!result.ok) throw new Error(result.error.message)

    const recoveryResponse = await fetch('/api/recovery', {
      method: 'DELETE'
    })

    if (!recoveryResponse.ok) throw new Error('Recovery sign out failed')

    window.location.assign('/login/')
  } catch {
    logoutButton.disabled = false

    logoutButton.removeAttribute('aria-busy')

    if (headerStatus)
      headerStatus.textContent =
        'Could not sign out. Check your connection and try again.'
  }
})
</script>
