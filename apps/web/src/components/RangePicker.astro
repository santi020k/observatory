---
import { analyticsRangeOptions } from '@/lib/analytics-range'

import type { AnalyticsRange } from '@santi020k/observatory-api-types'

interface Props {
  range: AnalyticsRange
}

const { range } = Astro.props
---

<nav aria-label="Analytics time range" class="range-picker">
  {
    analyticsRangeOptions.map(item => (
      <a
        aria-current={range === item.value ? 'page' : undefined}
        href={`?range=${item.value}`}
      >
        {item.label}
      </a>
    ))
  }
</nav>
