---
import { Card, Icon, Sparkline, Stat } from '@santi020k/lumen-astro'

interface Trend {
  label: string
  tone?: 'accent' | 'brand' | 'danger' | 'neutral' | 'success' | 'warning'
  values: readonly number[]
}

interface Props {
  context: string
  icon:
    | 'activity' |
    'blocks' |
    'circle-dot-dashed' |
    'download' |
    'eye' |
    'git-fork' |
    'history' |
    'mouse-pointer-click' |
    'monitor' |
    'star' |
    'users'
  label: string
  trend?: Trend
  value: string
}

const { context, icon, label, trend, value } = Astro.props
const showTrend = trend && trend.values.length >= 2
const trendTone = trend?.tone ? { tone: trend.tone } : {}
---

<Card class="metric-card">
  <div class="metric-card__top">
    <span class="metric-card__icon">
      <Icon aria-hidden="true" name={icon} />
    </span>
    {
      showTrend && (
        <Sparkline
          area
          class="metric-card__sparkline"
          label={trend.label}
          {...trendTone}
          values={trend.values}
        />
      )
    }
  </div>
  <Stat label={label} value={value}>
    <p>{context}</p>
  </Stat>
</Card>
