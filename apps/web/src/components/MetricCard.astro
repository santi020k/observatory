---
import Card from '@santi020k/lumen-astro/components/Card'
import Icon from '@santi020k/lumen-astro/components/Icon'
import Stat from '@santi020k/lumen-astro/components/Stat'

interface Props {
  context: string
  icon:
    | 'activity'
    | 'circle-dot-dashed'
    | 'download'
    | 'eye'
    | 'git-fork'
    | 'history'
    | 'mouse-pointer-click'
    | 'star'
    | 'users'
  label: string
  value: string
}

const { context, icon, label, value } = Astro.props
---

<Card class="metric-card">
  <span class="metric-card__icon"><Icon aria-hidden="true" name={icon} /></span>
  <Stat label={label} value={value}>
    <p>{context}</p>
  </Stat>
</Card>
