---
import Icon from '@santi020k/lumen-astro/components/Icon'

interface Props {
  compact?: boolean
}

const { compact = false } = Astro.props
---

<a
  class:list={['brand-lockup', compact && 'brand-lockup--compact']}
  href="/"
  aria-label="Observatory home"
>
  <span class="brand-mark"><Icon aria-hidden="true" name="orbit" /></span>
  <span>
    <strong>Observatory</strong>
    {!compact && <small>Project intelligence</small>}
  </span>
</a>
