---
import AppHeader from '@/components/AppHeader.astro'
import AppSidebar from '@/components/AppSidebar.astro'
import MetricCard from '@/components/MetricCard.astro'
import RangePicker from '@/components/RangePicker.astro'
import StatusBadge from '@/components/StatusBadge.astro'
import AppLayout from '@/layouts/AppLayout.astro'

import {
  analyticsRangeMeta,
  formatHistoryLabel,
  getHistoryCoverage,
  getNpmChart
} from '@/lib/analytics-range'
import { getBrowserApiUrl, getDashboard } from '@/lib/api'
import { needsAttention } from '@/lib/attention'
import {
  formatDate,
  formatDuration,
  formatNumber,
  formatRelativeDate
} from '@/lib/format'

import Badge from '@santi020k/lumen-astro/components/Badge'
import BarChart from '@santi020k/lumen-astro/components/BarChart'
import Button from '@santi020k/lumen-astro/components/Button'
import ButtonLink from '@santi020k/lumen-astro/components/ButtonLink'
import Card from '@santi020k/lumen-astro/components/Card'
import Empty from '@santi020k/lumen-astro/components/Empty'
import Icon from '@santi020k/lumen-astro/components/Icon'
import LineChart from '@santi020k/lumen-astro/components/LineChart'
import NativeSelect from '@santi020k/lumen-astro/components/NativeSelect'
import SearchField from '@santi020k/lumen-astro/components/SearchField'
import Table from '@santi020k/lumen-astro/components/Table'
import Tabs from '@santi020k/lumen-astro/components/Tabs'

const response = await getDashboard(Astro.request, Astro.url)

if (response.status === 401) return Astro.redirect('/login/')

if (!response.ok || !response.parsed)
  throw new Error('Observatory API is unavailable.')

const dashboard = response.parsed
const apiUrl = getBrowserApiUrl()
const rangeMeta = analyticsRangeMeta[dashboard.range]
const rangeLabel = rangeMeta.longLabel

const historyCoverage = getHistoryCoverage(
  dashboard.period.availableFrom, dashboard.period.availableTo, dashboard.range
)

const downloadsByProject = dashboard.npmAnalytics.packages.reduce<
  Map<string, number[]>
>((downloads, packageDownloads) => {
  const projectDownloads = downloads.get(packageDownloads.slug) ?? []

  projectDownloads.push(packageDownloads.downloads)

  downloads.set(packageDownloads.slug, projectDownloads)

  return downloads
}, new Map())

const averageDownloads = (downloads: readonly number[]): number => {
  if (downloads.length === 0) return 0

  return Math.round(
    downloads.reduce((total, value) => total + value, 0) / downloads.length
  )
}

const projectsByDownloads = dashboard.projects
  .map(project => {
    const projectDownloads = downloadsByProject.get(project.slug) ?? []

    return {
      downloads: averageDownloads(projectDownloads),
      name: project.name
    }
  })
  .sort((left, right) => right.downloads - left.downloads)

const chartProjects = projectsByDownloads
  .filter(project => project.downloads > 0)
  .slice(0, 6)

const projectDownloadSeries = [
  {
    data: chartProjects.map(project => ({
      label: formatNumber(project.downloads),
      x: project.name,
      y: project.downloads
    })),
    id: 'downloads',
    label: 'Downloads',
    tone: 'brand'
  }
] as const

const portfolioHistorySeries = [
  {
    data: dashboard.history.map(point => ({
      label: `${formatNumber(point.npmDownloads30d)} downloads`,
      x: formatHistoryLabel(point.collectedAt, dashboard.range),
      y: point.npmDownloads30d
    })),
    id: 'downloads',
    label: 'Rolling 30-day downloads',
    tone: 'brand'
  }
] as const

const portfolioStarsSeries = [
  {
    data: dashboard.history.map(point => ({
      label: `${formatNumber(point.stars)} stars`,
      x: formatHistoryLabel(point.collectedAt, dashboard.range),
      y: point.stars
    })),
    id: 'stars',
    label: 'Total stars',
    tone: 'accent'
  }
] as const

const formatNpmPeriodLabel = (
  value: string,
  cadence: 'daily' | 'monthly' | 'weekly' | 'yearly'
): string => {
  let options: Intl.DateTimeFormatOptions

  if (cadence === 'yearly') options = { year: 'numeric' }
  else if (cadence === 'monthly') options = { month: 'short', year: '2-digit' }
  else options = { day: 'numeric', month: 'short' }

  return new Intl.DateTimeFormat('en', options).format(new Date(value))
}

const toNpmSeries = (
  points: typeof dashboard.npmAnalytics.daily,
  cadence: 'daily' | 'monthly' | 'weekly' | 'yearly'
) => [
  {
    data: points.map(point => ({
      label: `${formatNumber(point.downloads)} downloads`,
      x: formatNpmPeriodLabel(point.periodStart, cadence),
      y: point.downloads
    })),
    id: `${cadence}-downloads`,
    label: 'Downloads',
    tone: 'brand'
  }
] as const

const npmChart = getNpmChart(dashboard.npmAnalytics, dashboard.range)
const npmChartSeries = toNpmSeries(npmChart.points, npmChart.cadence)
const npmTopPackage = dashboard.npmAnalytics.packages[0]

const npmRawDownloads = dashboard.npmAnalytics.packages.reduce(
  (total, packageDownloads) => total + packageDownloads.downloads, 0
)

const npmPeakDay = dashboard.npmAnalytics.daily.reduce<
  (typeof dashboard.npmAnalytics.daily)[number] | null
>(
  (peak, point) => (!peak || point.downloads > peak.downloads ? point : peak), null
)

const npmAveragePerDay =
  dashboard.npmAnalytics.daily.length > 0 ?
    Math.round(
      dashboard.npmAnalytics.totalDownloads /
      dashboard.npmAnalytics.daily.length
    ) :
    0

const projectNameBySlug = new Map(
  dashboard.projects.map(project => [project.slug, project.name])
)

const npmAvailableRangeLabel =
  dashboard.npmAnalytics.availableFrom && dashboard.npmAnalytics.availableTo ?
    `${formatDate(dashboard.npmAnalytics.availableFrom)} – ${formatDate(
      dashboard.npmAnalytics.availableTo
    )}` :
    'Awaiting npm history'

const vscodeHistorySeries = [
  {
    data: dashboard.vscodeAnalytics.history.map(point => ({
      label: `${formatNumber(point.downloads)} downloads`,
      x: formatHistoryLabel(point.collectedAt, dashboard.range),
      y: point.downloads
    })),
    id: 'vscode-downloads',
    label: 'Marketplace downloads',
    tone: 'brand'
  },
  {
    data: dashboard.vscodeAnalytics.history.map(point => ({
      label: `${formatNumber(point.installs)} installs`,
      x: formatHistoryLabel(point.collectedAt, dashboard.range),
      y: point.installs
    })),
    id: 'vscode-installs',
    label: 'Current installs',
    tone: 'accent'
  }
] as const

const vscodeAvailableRangeLabel =
  dashboard.vscodeAnalytics.availableFrom &&
  dashboard.vscodeAnalytics.availableTo ?
    `${formatDate(dashboard.vscodeAnalytics.availableFrom)} – ${formatDate(
      dashboard.vscodeAnalytics.availableTo
    )}` :
    'Awaiting Marketplace history'

const openVsxHistorySeries = [
  {
    data: dashboard.openVsxAnalytics.history.map(point => ({
      label: `${formatNumber(point.downloads)} downloads`,
      x: formatHistoryLabel(point.collectedAt, dashboard.range),
      y: point.downloads
    })),
    id: 'open-vsx-downloads',
    label: 'Open VSX downloads',
    tone: 'accent'
  }
] as const

const openVsxAvailableRangeLabel =
  dashboard.openVsxAnalytics.availableFrom &&
  dashboard.openVsxAnalytics.availableTo ?
    `${formatDate(dashboard.openVsxAnalytics.availableFrom)} – ${formatDate(
      dashboard.openVsxAnalytics.availableTo
    )}` :
    'Awaiting Open VSX history'

const getOpenVsxUrl = (extensionId: string): string => {
  const extensionParts = extensionId.split('.', 2)
  const namespace = extensionParts[0] ?? 'santi020k'
  const name = extensionParts[1] ?? extensionId

  return `https://open-vsx.org/extension/${namespace}/${name}`
}

const formatDownloadShare = (downloads: number, total: number): string => total > 0 ? `${((downloads / total) * 100).toFixed(1)}%` : '0%'
const formatSignedNumber = (value: number): string => `${value > 0 ? '+' : ''}${formatNumber(value)}`

const attentionProjects = dashboard.projects
  .filter(project => needsAttention(project))
  .sort((left, right) => right.openIssues - left.openIssues)
  .slice(0, 5)

const categoryCounts = dashboard.projects.reduce<Record<string, number>>(
  (counts, project) => {
    counts[project.category] = (counts[project.category] ?? 0) + 1

    return counts
  }, {}
)

const getCategoryIcon = (
  category: (typeof dashboard.projects)[number]['category']
): 'blocks' | 'layout-dashboard' | 'notebook-tabs' | 'wrench' => {
  if (category === 'app') return 'layout-dashboard'

  if (category === 'content') return 'notebook-tabs'

  if (category === 'tool') return 'wrench'

  return 'blocks'
}

const lastSync = dashboard.sync.completedAt ?
  formatRelativeDate(dashboard.sync.completedAt) :
  'awaiting first sync'

const hourInBogota = Number(
  new Intl.DateTimeFormat('en-US', {
    hour: 'numeric',
    hourCycle: 'h23',
    timeZone: 'America/Bogota'
  }).format(new Date())
)

let greeting = 'Good evening'

if (hourInBogota < 12) greeting = 'Good morning'
else if (hourInBogota < 18) greeting = 'Good afternoon'
---

<AppLayout
  description="Private project analytics and operational health dashboard."
  title="Overview · Observatory"
>
  <div class="app-shell">
    <AppSidebar projects={dashboard.projects} range={dashboard.range} />
    <div class="app-workspace">
      <AppHeader
        apiUrl={apiUrl}
        lastSync={lastSync}
        syncStatus={dashboard.sync.status}
      />

      <main class="dashboard" id="main-content">
        <section class="hero-row" aria-labelledby="overview-title">
          <div>
            <span class="eyebrow">Portfolio overview</span>
            <h1 id="overview-title">{greeting}, Santiago.</h1>
            <p>
              A focused read on what is growing, what needs attention, and where
              your product energy is going.
            </p>
          </div>
          <div class="hero-controls">
            <RangePicker range={dashboard.range} />
          </div>
        </section>

        <Tabs
          class="dashboard-tabs"
          initialValue="pulse"
          storageKey="observatory.dashboard.view"
        >
          <div
            aria-label="Dashboard views"
            class="dashboard-tablist"
            role="tablist"
          >
            <button aria-selected="true" data-value="pulse" role="tab">
              <Icon aria-hidden="true" name="gauge" />
              Pulse
            </button>
            {
              dashboard.projects.length > 0 && (
                <>
                  <button aria-selected="false" data-value="focus" role="tab">
                    <Icon aria-hidden="true" name="scan-eye" />
                    Focus
                  </button>
                  <button
                    aria-selected="false"
                    data-value="packages"
                    role="tab"
                  >
                    <Icon aria-hidden="true" name="package" />
                    Packages
                  </button>
                  <button
                    aria-selected="false"
                    data-value="extensions"
                    role="tab"
                  >
                    <Icon aria-hidden="true" name="blocks" />
                    Extensions
                  </button>
                  <button
                    aria-selected="false"
                    data-value="momentum"
                    role="tab"
                  >
                    <Icon aria-hidden="true" name="chart-no-axes-combined" />
                    Momentum
                  </button>
                  <button
                    aria-selected="false"
                    data-value="projects"
                    role="tab"
                  >
                    <Icon aria-hidden="true" name="layout-grid" />
                    Projects
                  </button>
                </>
              )
            }
            <button aria-selected="false" data-value="sources" role="tab">
              <Icon aria-hidden="true" name="database" />
              Sources
            </button>
          </div>

          <div
            class="dashboard-tab-panel dashboard-tab-panel--pulse"
            data-value="pulse"
            role="tabpanel"
          >
            <section class="metric-grid" aria-label="Portfolio metrics">
              <MetricCard
                context={`${dashboard.summary.publicProjects} public repositories tracked`}
                icon="circle-dot-dashed"
                label="Active projects"
                value={formatNumber(dashboard.summary.activeProjects)}
              />
              <MetricCard
                context={`Exact completed-day total · ${rangeLabel}`}
                icon="download"
                label="Package downloads"
                value={formatNumber(dashboard.npmAnalytics.totalDownloads)}
              />
              <MetricCard
                context="Current authenticated 14-day repository traffic"
                icon="eye"
                label="GitHub views"
                value={formatNumber(dashboard.summary.githubViews14d)}
              />
              <MetricCard
                context={`Change in rolling download velocity · ${rangeLabel}`}
                icon="activity"
                label="Download momentum"
                value={formatSignedNumber(
                  dashboard.period.downloadVelocityChange
                )}
              />
              <MetricCard
                context={`Net portfolio change · ${rangeLabel}`}
                icon="star"
                label="Stars gained"
                value={formatSignedNumber(dashboard.period.starsGained)}
              />
              <MetricCard
                context={`${formatNumber(dashboard.summary.openIssues)} currently open · ${rangeLabel}`}
                icon="circle-dot-dashed"
                label="Issue change"
                value={formatSignedNumber(dashboard.period.issueChange)}
              />
            </section>
          </div>

          <div class="dashboard-tab-panel" data-value="sources" role="tabpanel">
            <section class="source-section" aria-labelledby="sources-heading">
              <div class="section-heading">
                <div>
                  <span class="eyebrow">Data provenance</span>
                  <h2 id="sources-heading">What Observatory reads</h2>
                  <p>
                    Every signal stays grouped by provider so totals never hide
                    where the information came from.
                  </p>
                </div>
              </div>
              <div class="source-grid">
                <Card class="source-card">
                  <span class="source-card__icon"><Icon aria-hidden="true" name="git-fork" />
                  </span>
                  <div>
                    <h3>GitHub</h3>
                    <p>
                      Repositories, stars, forks, issues, pushes, and
                      authenticated 14-day traffic.
                    </p>
                    <a
                      href="https://docs.github.com/en/rest"
                      rel="noreferrer"
                      target="_blank"
                    >
                      GitHub REST API
                      <Icon aria-hidden="true" name="arrow-up-right" />
                    </a>
                  </div>
                </Card>
                <Card class="source-card">
                  <span class="source-card__icon">
                    <Icon aria-hidden="true" name="package" />
                  </span>
                  <div>
                    <h3>npm</h3>
                    <p>
                      Exact daily package downloads and the latest published
                      version for every discovered package.
                    </p>
                    <a
                      href="https://github.com/npm/registry/blob/main/docs/download-counts.md"
                      rel="noreferrer"
                      target="_blank"
                    >
                      npm downloads API
                      <Icon aria-hidden="true" name="arrow-up-right" />
                    </a>
                  </div>
                </Card>
                <Card class="source-card">
                  <span class="source-card__icon">
                    <Icon aria-hidden="true" name="monitor" />
                  </span>
                  <div>
                    <h3>VS Code</h3>
                    <p>
                      Marketplace downloads, current installs, versions,
                      ratings, updates, and publish activity.
                    </p>
                    <a
                      href="https://marketplace.visualstudio.com/publishers/Santi020k"
                      rel="noreferrer"
                      target="_blank"
                    >
                      VS Code Marketplace
                      <Icon aria-hidden="true" name="arrow-up-right" />
                    </a>
                  </div>
                </Card>
                <Card class="source-card">
                  <span class="source-card__icon">
                    <Icon aria-hidden="true" name="blocks" />
                  </span>
                  <div>
                    <h3>Open VSX</h3>
                    <p>
                      Registry downloads, versions, ratings, reviews, and
                      publish activity for open editor ecosystems.
                    </p>
                    <a
                      href="https://open-vsx.org/namespace/santi020k"
                      rel="noreferrer"
                      target="_blank"
                    >
                      Open VSX Registry
                      <Icon aria-hidden="true" name="arrow-up-right" />
                    </a>
                  </div>
                </Card>
                <Card class="source-card">
                  <span class="source-card__icon">
                    <Icon aria-hidden="true" name="globe" />
                  </span>
                  <div>
                    <h3>Website</h3>
                    <p>
                      Cloudflare Web Analytics page views and visits, kept
                      separate from direct uptime and response-time probes.
                    </p>
                    <a
                      href="https://developers.cloudflare.com/analytics/graphql-api/"
                      rel="noreferrer"
                      target="_blank"
                    >
                      Cloudflare Analytics
                      <Icon aria-hidden="true" name="arrow-up-right" />
                    </a>
                  </div>
                </Card>
              </div>
            </section>
          </div>

          {
            dashboard.projects.length === 0 ?
              (
                <Empty class="first-sync">
                  <span class="empty-icon">
                    <Icon aria-hidden="true" name="telescope" />
                  </span>
                  <h2>Your catalog is ready for first light</h2>
                  <p>
                    Run the first sync to collect GitHub, npm, and website health
                    metrics.
                  </p>
                  <button
                    class="ui-button ui-button--default"
                    data-sync-button
                    type="button"
                  >
                    Sync public projects
                  </button>
                </Empty>
              ) :
              (
                <>
                  <div
                    class="dashboard-tab-panel"
                    data-value="focus"
                    role="tabpanel"
                  >
                    <section class="insight-grid">
                      <Card
                        as="section"
                        class="panel reach-panel"
                        aria-labelledby="reach-heading"
                      >
                        <div class="panel-heading">
                          <div>
                            <span class="eyebrow">Reach</span>
                            <h2 id="reach-heading">Package downloads</h2>
                          </div>
                          <span>{rangeLabel}</span>
                        </div>

                        {chartProjects.length > 0 ?
                          (
                            <BarChart
                              aria-label={`Package downloads by project for ${rangeLabel}`}
                              caption={`Average npm downloads per package, grouped by project for ${rangeLabel}.`}
                              orientation="horizontal"
                              series={projectDownloadSeries}
                            />
                          ) :
                          (
                            <Empty>
                              <p>No mapped npm package has download data yet.</p>
                            </Empty>
                          )}
                      </Card>

                      <Card
                        as="section"
                        class="panel attention-panel"
                        aria-labelledby="attention-heading"
                      >
                        <div class="panel-heading">
                          <div>
                            <span class="eyebrow">Focus</span>
                            <h2 id="attention-heading">Attention queue</h2>
                          </div>
                          <Badge
                            variant={
                              attentionProjects.length > 0 ? 'warning' : 'success'
                            }
                          >
                            {attentionProjects.length} signals
                          </Badge>
                        </div>

                        {attentionProjects.length > 0 ?
                          (
                            <ul class="attention-list">
                              {attentionProjects.map(project => (
                                <li>
                                  <span
                                    class:list={[
                                      'health-dot',
                                      `health-dot--${project.healthStatus}`
                                    ]}
                                  />
                                  <div>
                                    <strong>{project.name}</strong>
                                    <span>
                                      {project.openIssues > 0 ?
                                        `${project.openIssues} open issue${project.openIssues === 1 ? '' : 's'}` :
                                        `Last push ${formatRelativeDate(project.pushedAt)}`}
                                    </span>
                                  </div>
                                  <ButtonLink
                                    ariaLabel={`Open ${project.name} on GitHub`}
                                    href={project.sources.github}
                                    newTab
                                    shape="icon"
                                    variant="ghost"
                                  >
                                    <Icon
                                      aria-hidden="true"
                                      name="arrow-up-right"
                                    />
                                  </ButtonLink>
                                </li>
                              ))}
                            </ul>
                          ) :
                          (
                            <Empty>
                              <Icon aria-hidden="true" name="circle-check-big" />
                              <p>No public projects need immediate attention.</p>
                            </Empty>
                          )}
                      </Card>
                    </section>
                  </div>

                  <div
                    class="dashboard-tab-panel dashboard-tab-panel--extensions"
                    data-value="extensions"
                    role="tabpanel"
                  >
                    <section
                      aria-labelledby="open-vsx-analytics-heading"
                      class="vscode-analytics-section"
                    >
                      <div class="section-heading">
                        <div>
                          <span class="eyebrow">Open editor adoption</span>
                          <h2 id="open-vsx-analytics-heading">
                            Open VSX analytics
                          </h2>
                          <p>
                            Registry reach for VSCodium, Eclipse Theia, Gitpod,
                            and other editors that consume the Open VSX ecosystem.
                          </p>
                        </div>
                        <div class="section-source">
                          <Badge
                            variant={
                              dashboard.openVsxAnalytics.extensions.length > 0 ?
                                'outline' :
                                'warning'
                            }
                          >
                            {openVsxAvailableRangeLabel}
                          </Badge>
                          <a
                            href="https://open-vsx.org/namespace/santi020k"
                            rel="noreferrer"
                            target="_blank"
                          >
                            Source: Open VSX Registry
                            <Icon aria-hidden="true" name="arrow-up-right" />
                          </a>
                        </div>
                      </div>

                      {dashboard.openVsxAnalytics.extensions.length > 0 ?
                        (
                          <>
                            <dl class="npm-summary-grid vscode-summary-grid">
                              <div>
                                <dt>Cumulative downloads</dt>
                                <dd>
                                  {formatNumber(
                                    dashboard.openVsxAnalytics.totalDownloads
                                  )}
                                </dd>
                                <small>Open VSX total</small>
                              </div>
                              <div>
                                <dt>Extensions</dt>
                                <dd>
                                  {formatNumber(
                                    dashboard.openVsxAnalytics.extensions.length
                                  )}
                                </dd>
                                <small>Mapped registry entries</small>
                              </div>
                              <div>
                                <dt>Reviews</dt>
                                <dd>
                                  {formatNumber(
                                    dashboard.openVsxAnalytics.extensions.reduce(
                                      (total, extension) => total + extension.reviewCount, 0
                                    )
                                  )}
                                </dd>
                                <small>Registry reviews</small>
                              </div>
                            </dl>

                            {dashboard.openVsxAnalytics.history.length > 1 && (
                              <Card
                                as="section"
                                class="panel vscode-history-panel"
                                aria-labelledby="open-vsx-history-heading"
                              >
                                <div class="panel-heading">
                                  <div>
                                    <span class="eyebrow">Observed growth</span>
                                    <h3 id="open-vsx-history-heading">
                                      Open VSX reach
                                    </h3>
                                  </div>
                                  <span>{rangeLabel}</span>
                                </div>
                                <LineChart
                                  markers={
                                    dashboard.openVsxAnalytics.history.length <= 24
                                  }
                                  aria-label={`Open VSX downloads for ${rangeLabel}`}
                                  caption="Cumulative Open VSX downloads captured at each successful Observatory sync."
                                  series={openVsxHistorySeries}
                                />
                              </Card>
                            )}

                            <Card
                              as="section"
                              class="vscode-extension-panel"
                              aria-labelledby="open-vsx-extensions-heading"
                            >
                              <div class="npm-package-heading">
                                <div>
                                  <span class="eyebrow">Extension ranking</span>
                                  <h3 id="open-vsx-extensions-heading">
                                    Open VSX extensions
                                  </h3>
                                </div>
                                <Badge variant="secondary">Registry snapshot</Badge>
                              </div>
                              <Table class="vscode-extension-table">
                                <table>
                                  <caption class="sr-only">
                                    Open VSX extension analytics
                                  </caption>
                                  <thead>
                                    <tr>
                                      <th scope="col">Extension</th>
                                      <th scope="col">Version</th>
                                      <th scope="col">Downloads</th>
                                      <th scope="col">Rating</th>
                                      <th scope="col">Reviews</th>
                                      <th scope="col">Updated</th>
                                    </tr>
                                  </thead>
                                  <tbody>
                                    {dashboard.openVsxAnalytics.extensions.map(
                                      extension => (
                                        <tr>
                                          <td>
                                            <a
                                              class="npm-package-link"
                                              href={getOpenVsxUrl(
                                                extension.extensionId
                                              )}
                                              rel="noreferrer"
                                              target="_blank"
                                            >
                                              {projectNameBySlug.get(
                                                extension.slug
                                              ) ?? extension.extensionId}
                                              <Icon
                                                aria-hidden="true"
                                                name="arrow-up-right"
                                              />
                                            </a>
                                            <small>{extension.extensionId}</small>
                                          </td>
                                          <td>{extension.version}</td>
                                          <td>
                                            <strong>
                                              {formatNumber(extension.downloads)}
                                            </strong>
                                          </td>
                                          <td>
                                            {extension.rating === null ?
                                              '—' :
                                              extension.rating.toFixed(1)}
                                          </td>
                                          <td>
                                            {formatNumber(extension.reviewCount)}
                                          </td>
