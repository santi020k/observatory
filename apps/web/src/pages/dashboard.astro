---
import AppHeader from '@/components/AppHeader.astro'
import AppSidebar from '@/components/AppSidebar.astro'
import GrowthMap from '@/components/GrowthMap.astro'
import MetricCard from '@/components/MetricCard.astro'
import RangePicker from '@/components/RangePicker.astro'
import StatusBadge from '@/components/StatusBadge.astro'
import AppLayout from '@/layouts/AppLayout.astro'

import {
  analyticsRangeMeta,
  formatHistoryLabel,
  getHistoryCoverage,
  getNpmChart
} from '@/lib/analytics-range'
import { getBrowserApiUrl, getDashboard } from '@/lib/api'
import { needsAttention } from '@/lib/attention'
import {
  formatDate,
  formatDuration,
  formatNumber,
  formatRelativeDate
} from '@/lib/format'
import { buildGrowthMap } from '@/lib/growth-map'

import {
  Badge,
  BarChart,
  Button,
  ButtonLink,
  Card,
  Empty,
  Icon,
  LineChart,
  NativeSelect,
  SearchField,
  Sparkline,
  Table,
  Tabs
} from '@santi020k/lumen-astro'

const response = await getDashboard(Astro.request, Astro.url)

if (response.status === 401) return Astro.redirect('/login/')

if (!response.ok || !response.parsed)
  throw new Error('Observatory API is unavailable.')

const dashboard = response.parsed
const apiUrl = getBrowserApiUrl()
const rangeMeta = analyticsRangeMeta[dashboard.range]
const rangeLabel = rangeMeta.longLabel

const historyCoverage = getHistoryCoverage(
  dashboard.period.availableFrom,
  dashboard.period.availableTo,
  dashboard.range
)

const downloadsByProject = dashboard.npmAnalytics.packages.reduce<
  Map<string, number[]>
>((downloads, packageDownloads) => {
  const projectDownloads = downloads.get(packageDownloads.slug) ?? []

  projectDownloads.push(packageDownloads.downloads)

  downloads.set(packageDownloads.slug, projectDownloads)

  return downloads
}, new Map())

const averageDownloads = (downloads: readonly number[]): number => {
  if (downloads.length === 0) return 0

  return Math.round(
    downloads.reduce((total, value) => total + value, 0) / downloads.length
  )
}

const projectsByDownloads = dashboard.projects
  .map(project => {
    const projectDownloads = downloadsByProject.get(project.slug) ?? []

    return {
      downloads: averageDownloads(projectDownloads),
      name: project.name
    }
  })
  .sort((left, right) => right.downloads - left.downloads)

const chartProjects = projectsByDownloads
  .filter(project => project.downloads > 0)
  .slice(0, 6)

const projectDownloadSeries = [
  {
    data: chartProjects.map(project => ({
      label: formatNumber(project.downloads),
      x: project.name,
      y: project.downloads
    })),
    id: 'downloads',
    label: 'Downloads',
    tone: 'brand'
  }
] as const

const portfolioHistorySeries = [
  {
    data: dashboard.history.map(point => ({
      label: `${formatNumber(point.npmDownloads30d)} downloads`,
      x: formatHistoryLabel(point.collectedAt, dashboard.range),
      y: point.npmDownloads30d
    })),
    id: 'downloads',
    label: 'Rolling 30-day downloads',
    tone: 'brand'
  }
] as const

const portfolioStarsSeries = [
  {
    data: dashboard.history.map(point => ({
      label: `${formatNumber(point.stars)} stars`,
      x: formatHistoryLabel(point.collectedAt, dashboard.range),
      y: point.stars
    })),
    id: 'stars',
    label: 'Total stars',
    tone: 'accent'
  }
] as const

const formatNpmPeriodLabel = (
  value: string,
  cadence: 'daily' | 'monthly' | 'weekly' | 'yearly'
): string => {
  let options: Intl.DateTimeFormatOptions

  if (cadence === 'yearly') options = { year: 'numeric' }
  else if (cadence === 'monthly') options = { month: 'short', year: '2-digit' }
  else options = { day: 'numeric', month: 'short' }

  return new Intl.DateTimeFormat('en', options).format(new Date(value))
}

const toNpmSeries = (
  points: typeof dashboard.npmAnalytics.daily,
  cadence: 'daily' | 'monthly' | 'weekly' | 'yearly'
) => [
  {
    data: points.map(point => ({
      label: `${formatNumber(point.downloads)} downloads`,
      x: formatNpmPeriodLabel(point.periodStart, cadence),
      y: point.downloads
    })),
    id: `${cadence}-downloads`,
    label: 'Downloads',
    tone: 'brand'
  }
] as const

const npmChart = getNpmChart(dashboard.npmAnalytics, dashboard.range)
const npmChartSeries = toNpmSeries(npmChart.points, npmChart.cadence)
const npmTopPackage = dashboard.npmAnalytics.packages[0]

const npmRawDownloads = dashboard.npmAnalytics.packages.reduce(
  (total, packageDownloads) => total + packageDownloads.downloads,
  0
)

const npmLast7Days =
  dashboard.npmAnalytics.daily.length >= 7 ?
    dashboard.npmAnalytics.daily
      .slice(-7)
      .reduce((total, point) => total + point.downloads, 0) :
    null

const npmPeakDay = dashboard.npmAnalytics.daily.reduce<
  (typeof dashboard.npmAnalytics.daily)[number] | null
>(
  (peak, point) => (!peak || point.downloads > peak.downloads ? point : peak),
  null
)

const projectNameBySlug = new Map(
  dashboard.projects.map(project => [project.slug, project.name])
)

const npmAvailableRangeLabel =
  dashboard.npmAnalytics.availableFrom && dashboard.npmAnalytics.availableTo ?
    `${formatDate(dashboard.npmAnalytics.availableFrom)} – ${formatDate(
      dashboard.npmAnalytics.availableTo
    )}` :
    'Awaiting npm history'

const vscodeHistorySeries = [
  {
    data: dashboard.vscodeAnalytics.history.map(point => ({
      label: `${formatNumber(point.downloads)} downloads`,
      x: formatHistoryLabel(point.collectedAt, dashboard.range),
      y: point.downloads
    })),
    id: 'vscode-downloads',
    label: 'Marketplace downloads',
    tone: 'brand'
  },
  {
    data: dashboard.vscodeAnalytics.history.map(point => ({
      label: `${formatNumber(point.installs)} installs`,
      x: formatHistoryLabel(point.collectedAt, dashboard.range),
      y: point.installs
    })),
    id: 'vscode-installs',
    label: 'Current installs',
    tone: 'accent'
  }
] as const

const vscodeAvailableRangeLabel =
  dashboard.vscodeAnalytics.availableFrom &&
  dashboard.vscodeAnalytics.availableTo ?
    `${formatDate(dashboard.vscodeAnalytics.availableFrom)} – ${formatDate(
      dashboard.vscodeAnalytics.availableTo
    )}` :
    'Awaiting Marketplace history'

const openVsxHistorySeries = [
  {
    data: dashboard.openVsxAnalytics.history.map(point => ({
      label: `${formatNumber(point.downloads)} downloads`,
      x: formatHistoryLabel(point.collectedAt, dashboard.range),
      y: point.downloads
    })),
    id: 'open-vsx-downloads',
    label: 'Open VSX downloads',
    tone: 'accent'
  }
] as const

const openVsxAvailableRangeLabel =
  dashboard.openVsxAnalytics.availableFrom &&
  dashboard.openVsxAnalytics.availableTo ?
    `${formatDate(dashboard.openVsxAnalytics.availableFrom)} – ${formatDate(
      dashboard.openVsxAnalytics.availableTo
    )}` :
    'Awaiting Open VSX history'

const getOpenVsxUrl = (extensionId: string): string => {
  const extensionParts = extensionId.split('.', 2)
  const namespace = extensionParts[0] ?? 'santi020k'
  const name = extensionParts[1] ?? extensionId

  return `https://open-vsx.org/extension/${namespace}/${name}`
}

const formatDownloadShare = (downloads: number, total: number): string => total > 0 ? `${((downloads / total) * 100).toFixed(1)}%` : '0%'
const formatSignedNumber = (value: number): string => `${value > 0 ? '+' : ''}${formatNumber(value)}`

const attentionProjects = dashboard.projects
  .filter(project => needsAttention(project))
  .sort((left, right) => right.openIssues - left.openIssues)
  .slice(0, 5)

const growthSignalPriority = {
  accelerating: 4,
  growing: 3,
  steady: 2,
  slowing: 1,
  insufficient: 0
} as const

const growthBySlug = new Map(
  dashboard.growth.map(growth => [growth.slug, growth])
)

const operationalHealth = [...dashboard.operationalHealth].sort(
  (left, right) => Number(right.currentStatus === 'degraded') -
    Number(left.currentStatus === 'degraded') ||
    (left.availabilityPercent ?? Number.POSITIVE_INFINITY) -
    (right.availabilityPercent ?? Number.POSITIVE_INFINITY)
)

const observedHealth = operationalHealth.filter(
  health => health.observations > 0
)

const portfolioHealthChecks = observedHealth.reduce(
  (total, health) => total + health.observations,
  0
)

const portfolioHealthyChecks = observedHealth.reduce(
  (total, health) => total + health.healthyChecks,
  0
)

const portfolioAvailability = portfolioHealthChecks === 0 ?
  null :
  (portfolioHealthyChecks / portfolioHealthChecks) * 100

const activeIncidents = observedHealth.filter(
  health => health.currentStatus === 'degraded'
).length

const missedAvailabilityTargets = observedHealth.filter(
  health => health.meetsTarget === false
).length

const formatAvailability = (value: number | null): string => value === null ?
  '—' :
  `${value.toFixed(value === 100 ? 0 : 2)}%`

const getHealthBadgeVariant = (
  status: (typeof operationalHealth)[number]['currentStatus']
): 'outline' | 'success' | 'warning' => {
  if (status === 'healthy') return 'success'

  if (status === 'degraded') return 'warning'

  return 'outline'
}

const npmGrowthMap = buildGrowthMap(
  dashboard.projects
    .filter(project => project.sources.npm.length > 0)
    .map(project => {
      const growth = growthBySlug.get(project.slug)

      return {
        momentumPercent: growth?.downloadVelocityPercent ?? null,
        name: project.name,
        observations: growth?.observations ?? 0,
        reach: project.npmDownloads30d,
        signal: growth?.signal ?? 'insufficient',
        slug: project.slug
      }
    })
)

const scaleProjects = npmGrowthMap.points.filter(
  point => point.quadrant === 'scale'
)

const growthMapTakeaway = (() => {
  if (scaleProjects.length > 0)
    return `${scaleProjects.map(point => point.name).join(', ')} ${scaleProjects.length === 1 ? 'combines' : 'combine'} above-median npm reach with positive momentum.`

  const strongestProject = npmGrowthMap.points[0]

  if (strongestProject)
    return `${strongestProject.name} has the strongest comparable npm momentum, but no project is in the scale zone yet.`

  return 'The map needs at least two observations and a non-zero npm baseline per project.'
})()

const rankedGrowth = dashboard.growth
  .flatMap(growth => {
    const project = dashboard.projects.find(
      candidate => candidate.slug === growth.slug
    )

    return project ? [{ growth, project }] : []
  })
  .sort(
    (left, right) => growthSignalPriority[right.growth.signal] -
      growthSignalPriority[left.growth.signal] ||
      right.growth.downloadVelocityChange -
      left.growth.downloadVelocityChange ||
      right.growth.starsGained - left.growth.starsGained
  )

const observedGrowth = rankedGrowth.filter(
  item => item.growth.observations >= 2
)

const growthLeader =
  observedGrowth.find(
    item => item.growth.signal === 'accelerating' || item.growth.signal === 'growing'
  ) ?? observedGrowth[0]

const formatGrowthPercent = (value: number | null): string | null => value === null ?
  null :
  `${new Intl.NumberFormat('en', {
    maximumFractionDigits: 1,
    signDisplay: 'exceptZero'
  }).format(value)}%`

const getGrowthBadgeVariant = (
  signal: (typeof dashboard.growth)[number]['signal']
): 'outline' | 'secondary' | 'success' | 'warning' => {
  if (signal === 'accelerating' || signal === 'growing') return 'success'

  if (signal === 'slowing') return 'warning'

  if (signal === 'steady') return 'secondary'

  return 'outline'
}

const getGrowthTrendTone = (
  signal: (typeof dashboard.growth)[number]['signal']
): 'danger' | 'neutral' | 'success' | 'warning' => {
  if (signal === 'accelerating' || signal === 'growing') return 'success'

  if (signal === 'slowing') return 'warning'

  return 'neutral'
}

const getGrowthAction = (
  signal: (typeof dashboard.growth)[number]['signal']
): string => {
  if (signal === 'accelerating')
    return 'Protect this momentum: ship the next high-confidence improvement and amplify the channels already working.'

  if (signal === 'growing')
    return 'Turn early traction into a repeatable loop: release, distribute, listen, and measure again.'

  if (signal === 'slowing')
    return 'Inspect release cadence and discovery before investing more product work.'

  return 'Run a small distribution or product experiment so the next sync has a clearer signal.'
}

const getGrowthMetricLabel = (item: (typeof rankedGrowth)[number]): string => {
  const percent = formatGrowthPercent(item.growth.downloadVelocityPercent)

  const hasDownloadSignal =
    item.project.sources.npm.length > 0 ||
    item.project.npmDownloads30d > 0 ||
    item.growth.downloadVelocityChange !== 0

  if (hasDownloadSignal)
    return percent ?
      `${percent} download velocity` :
      `${formatSignedNumber(item.growth.downloadVelocityChange)} download velocity`

  return `${formatSignedNumber(item.growth.starsGained)} stars`
}

const categoryCounts = dashboard.projects.reduce<Record<string, number>>(
  (counts, project) => {
    counts[project.category] = (counts[project.category] ?? 0) + 1

    return counts
  },
  {}
)

const getCategoryIcon = (
  category: (typeof dashboard.projects)[number]['category']
): 'blocks' | 'layout-dashboard' | 'notebook-tabs' | 'wrench' => {
  if (category === 'app') return 'layout-dashboard'

  if (category === 'content') return 'notebook-tabs'

  if (category === 'tool') return 'wrench'

  return 'blocks'
}

const lastSync = dashboard.sync.completedAt ?
  formatRelativeDate(dashboard.sync.completedAt) :
  'awaiting first sync'

const hourInBogota = Number(
  new Intl.DateTimeFormat('en-US', {
    hour: 'numeric',
    hourCycle: 'h23',
    timeZone: 'America/Bogota'
  }).format(new Date())
)

let greeting = 'Good evening'

if (hourInBogota < 12) greeting = 'Good morning'
else if (hourInBogota < 18) greeting = 'Good afternoon'
---

<AppLayout
  description="Private project analytics and operational health dashboard."
  title="Overview · Observatory"
>
  <div class="app-shell">
    <AppSidebar projects={dashboard.projects} range={dashboard.range} />
    <div class="app-workspace">
      <AppHeader
        apiUrl={apiUrl}
        lastSync={lastSync}
        syncStatus={dashboard.sync.status}
      />

      <main class="dashboard" id="main-content">
        <section class="hero-row" aria-labelledby="overview-title">
          <div>
            <span class="eyebrow">Portfolio overview</span>
            <h1 id="overview-title">{greeting}, Santiago.</h1>
            <p>
              A focused read on what is growing, what needs attention, and where
              your product energy is going.
            </p>
          </div>
          <div class="hero-controls">
            <RangePicker range={dashboard.range} />
          </div>
        </section>

        <Tabs
          class="dashboard-tabs"
          initialValue="pulse"
          storageKey="observatory.dashboard.view"
        >
          <div
            aria-label="Dashboard views"
            class="dashboard-tablist"
            role="tablist"
          >
            <button aria-selected="true" data-value="pulse" role="tab">
              <Icon aria-hidden="true" name="gauge" />
              Pulse
            </button>
            {
              dashboard.projects.length > 0 && (
                <>
                  <button aria-selected="false" data-value="focus" role="tab">
                    <Icon aria-hidden="true" name="scan-eye" />
                    Focus
                  </button>
                  {dashboard.operationalHealth.length > 0 && (
                    <button
                      aria-selected="false"
                      data-value="operations"
                      role="tab"
                    >
                      <Icon aria-hidden="true" name="activity" />
                      Operations
                    </button>
                  )}
                  <button
                    aria-selected="false"
                    data-value="packages"
                    role="tab"
                  >
                    <Icon aria-hidden="true" name="package" />
                    Packages
                  </button>
                  <button
                    aria-selected="false"
                    data-value="extensions"
                    role="tab"
                  >
                    <Icon aria-hidden="true" name="blocks" />
                    Extensions
                  </button>
                  <button
                    aria-selected="false"
                    data-value="momentum"
                    role="tab"
                  >
                    <Icon aria-hidden="true" name="chart-no-axes-combined" />
                    Momentum
                  </button>
                  <button
                    aria-selected="false"
                    data-value="projects"
                    role="tab"
                  >
                    <Icon aria-hidden="true" name="layout-grid" />
                    Projects
                  </button>
                </>
              )
            }
            <button aria-selected="false" data-value="sources" role="tab">
              <Icon aria-hidden="true" name="database" />
              Sources
            </button>
          </div>

          <div
            class="dashboard-tab-panel dashboard-tab-panel--pulse"
            data-value="pulse"
            role="tabpanel"
          >
            <section
              aria-labelledby="growth-brief-heading"
              class="growth-brief"
            >
              <div class="section-heading">
                <div>
                  <span class="eyebrow">Decision brief</span>
                  <h2 id="growth-brief-heading">
                    Where to place your next bet
                  </h2>
                  <p>
                    Projects ranked by observed momentum in {rangeLabel}, with
                    the evidence kept visible instead of compressed into an
                    opaque score.
                  </p>
                </div>
                <Badge
                  variant={observedGrowth.length > 0 ? 'outline' : 'warning'}
                >
                  {observedGrowth.length} of {rankedGrowth.length} comparable
                </Badge>
              </div>

              {
                growthLeader ?
                  (
                    <div class="growth-brief-grid">
                      <Card
                        as="article"
                        class="growth-leader"
                        aria-labelledby="growth-leader-heading"
                      >
                        <div class="growth-leader__header">
                          <span class="growth-leader__icon">
                            <Icon aria-hidden="true" name="sparkles" />
                          </span>
                          <Badge
                            variant={getGrowthBadgeVariant(
                              growthLeader.growth.signal
                            )}
                          >
                            {growthLeader.growth.signal}
                          </Badge>
                        </div>
                        <span class="eyebrow">Best current signal</span>
                        <h3 id="growth-leader-heading">
                          {growthLeader.project.name}
                        </h3>
                        <p>{getGrowthAction(growthLeader.growth.signal)}</p>
                        <dl class="growth-evidence">
                          <div>
                            <dt>Download velocity</dt>
                            <dd>
                              {formatSignedNumber(
                                growthLeader.growth.downloadVelocityChange
                              )}
                              {formatGrowthPercent(
                                growthLeader.growth.downloadVelocityPercent
                              ) && (
                                <small>
                                  {formatGrowthPercent(
                                    growthLeader.growth.downloadVelocityPercent
                                  )}
                                </small>
                              )}
                            </dd>
                          </div>
                          <div>
                            <dt>Stars gained</dt>
                            <dd>
                              {formatSignedNumber(
                                growthLeader.growth.starsGained
                              )}
                            </dd>
                          </div>
                          <div>
                            <dt>Issue change</dt>
                            <dd>
                              {formatSignedNumber(
                                growthLeader.growth.issueChange
                              )}
                            </dd>
                          </div>
                        </dl>
                        <div class="growth-leader__footer">
                          <span>
                            {growthLeader.growth.observations} observations
                          </span>
                          <ButtonLink
                            href={`/projects/${growthLeader.project.slug}/?range=${dashboard.range}`}
                            variant="secondary"
                          >
                            Open project
                            <Icon aria-hidden="true" name="arrow-right" />
                          </ButtonLink>
                        </div>
                      </Card>

                      <Card
                        as="section"
                        class="growth-ranking"
                        aria-labelledby="growth-ranking-heading"
                      >
                        <div class="panel-heading">
                          <div>
                            <span class="eyebrow">Momentum ranking</span>
                            <h3 id="growth-ranking-heading">Projects to watch</h3>
                          </div>
                          <span>{rangeLabel}</span>
                        </div>
                        <ol>
                          {observedGrowth.slice(0, 5).map((item, index) => (
                            <li>
                              <span class="growth-ranking__position">
                                {index + 1}
                              </span>
                              <div>
                                <a
                                  href={`/projects/${item.project.slug}/?range=${dashboard.range}`}
                                >
                                  {item.project.name}
                                </a>
                                <small>{getGrowthMetricLabel(item)}</small>
                              </div>
                              <Badge
                                variant={getGrowthBadgeVariant(
                                  item.growth.signal
                                )}
                              >
                                {item.growth.signal}
                              </Badge>
                            </li>
                          ))}
                        </ol>
                      </Card>
                    </div>
                  ) :
                  (
                    <Card class="growth-brief-empty">
                      <Empty>
                        <span class="empty-icon">
                          <Icon
                            aria-hidden="true"
                            name="chart-no-axes-combined"
                          />
                        </span>
                        <h3>One more sync will reveal momentum</h3>
                        <p>
                          Growth comparisons need at least two persisted
                          observations in the selected range.
                        </p>
                      </Empty>
                    </Card>
                  )
              }
            </section>

            <section class="metric-grid" aria-label="Portfolio metrics">
              <MetricCard
                context={`${dashboard.summary.publicProjects} public repositories tracked`}
                icon="circle-dot-dashed"
                label="Active projects"
                value={formatNumber(dashboard.summary.activeProjects)}
              />
              <MetricCard
                context={`Project-adjusted total · ${rangeLabel}`}
                icon="download"
                label="Project downloads"
                value={formatNumber(dashboard.npmAnalytics.totalDownloads)}
              />
              <MetricCard
                context="Current authenticated 14-day repository traffic"
                icon="eye"
                label="GitHub views"
                value={formatNumber(dashboard.summary.githubViews14d)}
              />
              <MetricCard
                context={`Change in rolling download velocity · ${rangeLabel}`}
                icon="activity"
                label="Download momentum"
                trend={{
                  label: `Download velocity trend for ${rangeLabel}`,
                  tone: 'brand',
                  values: dashboard.history.map(point => point.npmDownloads30d)
                }}
                value={formatSignedNumber(
                  dashboard.period.downloadVelocityChange
                )}
              />
              <MetricCard
                context={`Net portfolio change · ${rangeLabel}`}
                icon="star"
                label="Stars gained"
                trend={{
                  label: `Portfolio star trend for ${rangeLabel}`,
                  tone: 'accent',
                  values: dashboard.history.map(point => point.stars)
                }}
                value={formatSignedNumber(dashboard.period.starsGained)}
              />
              <MetricCard
                context={`${formatNumber(dashboard.summary.openIssues)} currently open · ${rangeLabel}`}
                icon="circle-dot-dashed"
                label="Issue change"
                trend={{
                  label: `Open issue trend for ${rangeLabel}`,
                  tone:
                    dashboard.period.issueChange > 0 ? 'warning' : 'neutral',
                  values: dashboard.history.map(point => point.openIssues)
                }}
                value={formatSignedNumber(dashboard.period.issueChange)}
              />
            </section>
          </div>

          <div class="dashboard-tab-panel" data-value="sources" role="tabpanel">
            <section class="source-section" aria-labelledby="sources-heading">
              <div class="section-heading">
                <div>
                  <span class="eyebrow">Data provenance</span>
                  <h2 id="sources-heading">What Observatory reads</h2>
                  <p>
                    Every signal stays grouped by provider so totals never hide
                    where the information came from.
                  </p>
                </div>
              </div>
              <div class="source-grid">
                <Card class="source-card">
                  <span class="source-card__icon"><Icon aria-hidden="true" name="git-fork" />
                  </span>
                  <div>
                    <h3>GitHub</h3>
                    <p>
                      Repositories, stars, forks, issues, pushes, and
                      authenticated 14-day traffic.
                    </p>
                    <a
                      href="https://docs.github.com/en/rest"
                      rel="noreferrer"
                      target="_blank"
                    >
                      GitHub REST API
                      <Icon aria-hidden="true" name="arrow-up-right" />
                    </a>
                  </div>
                </Card>
                <Card class="source-card">
                  <span class="source-card__icon">
                    <Icon aria-hidden="true" name="package" />
                  </span>
                  <div>
                    <h3>npm</h3>
                    <p>
                      Exact daily package downloads and the latest published
                      version for every discovered package.
                    </p>
                    <a
                      href="https://github.com/npm/registry/blob/main/docs/download-counts.md"
                      rel="noreferrer"
                      target="_blank"
                    >
                      npm downloads API
                      <Icon aria-hidden="true" name="arrow-up-right" />
                    </a>
                  </div>
                </Card>
                <Card class="source-card">
                  <span class="source-card__icon">
                    <Icon aria-hidden="true" name="monitor" />
                  </span>
                  <div>
                    <h3>VS Code</h3>
                    <p>
