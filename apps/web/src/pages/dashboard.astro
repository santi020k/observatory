                                              ) :
                                              (
                                                <span>{packageDownloads.slug}</span>
                                              )}
                                          </td>
                                          <td>
                                            {formatDownloadShare(
                                              packageDownloads.downloads,
                                              npmRawDownloads
                                            )}
                                          </td>
                                          <td>
                                            <strong>
                                              {formatNumber(
                                                packageDownloads.downloads
                                              )}
                                            </strong>
                                          </td>
                                        </tr>
                                      )
                                    )}
                                  </tbody>
                                  <tfoot>
                                    <tr>
                                      <th colspan={3} scope="row">
                                        Raw package total
                                      </th>
                                      <td>
                                        <strong>
                                          {formatNumber(npmRawDownloads)}
                                        </strong>
                                      </td>
                                    </tr>
                                  </tfoot>
                                </table>
                              </Table>
                              <p class="npm-method-note">
                                The table contains raw counts for each package. The
                                project-adjusted figure averages sibling packages so
                                one multi-package project does not dominate the
                                portfolio. npm’s package page usually highlights a
                                7-day count.
                              </p>
                            </Card>
                          </>
                        ) :
                        (
                          <Card class="panel npm-analytics-empty">
                            <Empty>
                              <span class="empty-icon">
                                <Icon
                                  aria-hidden="true"
                                  name="chart-no-axes-column"
                                />
                              </span>
                              <h3>Download history starts with the next sync</h3>
                              <p>
                                Observatory will backfill up to one year of daily
                                npm data, then keep it current with every
                                public-project sync.
                              </p>
                            </Empty>
                          </Card>
                        )}
                    </section>
                  </div>

                  <div
                    class="dashboard-tab-panel"
                    data-value="momentum"
                    role="tabpanel"
                  >
                    <section
                      aria-labelledby="history-heading"
                      class="history-section"
                    >
                      <div class="section-heading">
                        <div>
                          <span class="eyebrow">Momentum</span>
                          <h2 id="history-heading">Growth over time</h2>
                          <p>
                            {rangeMeta.bucketLabel} points built from{' '}
                            {formatNumber(dashboard.period.syncs)} persisted{' '}
                            {dashboard.period.syncs === 1 ? 'sync' : 'syncs'}.
                          </p>
                        </div>
                        <Badge
                          variant={
                            historyCoverage.isPartial ? 'warning' : 'outline'
                          }
                        >
                          {historyCoverage.label}
                        </Badge>
                      </div>

                      {npmGrowthMap.points.length >= 2 ?
                        (
                          <Card
                            as="section"
                            class="growth-map-panel"
                            aria-labelledby="growth-map-heading"
                          >
                            <div class="panel-heading">
                              <div>
                                <span class="eyebrow">Portfolio strategy</span>
                                <h3 id="growth-map-heading">
                                  npm reach × momentum
                                </h3>
                                <p>{growthMapTakeaway}</p>
                              </div>
                              <Badge variant="outline">
                                {npmGrowthMap.points.length} plotted
                                {npmGrowthMap.excludedCount > 0 &&
                                  ` · ${npmGrowthMap.excludedCount} awaiting baseline`}
                              </Badge>
                            </div>
                            <GrowthMap
                              points={npmGrowthMap.points}
                              range={dashboard.range}
                              rangeLabel={rangeLabel}
                              reachDividerX={npmGrowthMap.reachDividerX}
                            />
                          </Card>
                        ) :
                        (
                          <Card class="growth-map-empty">
                            <Empty>
                              <span class="empty-icon">
                                <Icon
                                  aria-hidden="true"
                                  name="chart-no-axes-combined"
                                />
                              </span>
                              <h3>Growth map needs comparable projects</h3>
                              <p>
                                Two npm projects with a non-zero baseline and at
                                least two observations are required.
                              </p>
                            </Empty>
                          </Card>
                        )}

                      {dashboard.history.length > 1 ?
                        (
                          <div class="momentum-grid">
                            <Card
                              as="section"
                              class="panel history-panel"
                              aria-labelledby="download-history-heading"
                            >
                              <div class="panel-heading">
                                <div>
                                  <span class="eyebrow">Usage</span>
                                  <h3 id="download-history-heading">
                                    Download velocity
                                  </h3>
                                </div>
                                <span>
                                  {formatSignedNumber(
                                    dashboard.period.downloadVelocityChange
                                  )}
                                </span>
                              </div>
                              <LineChart
                                area
                                markers={dashboard.history.length <= 24}
                                aria-label={`Portfolio download velocity for ${rangeLabel}`}
                                caption={`Rolling 30-day npm downloads observed during ${rangeLabel}.`}
                                series={portfolioHistorySeries}
                              />
                            </Card>

                            <Card
                              as="section"
                              class="panel history-panel"
                              aria-labelledby="star-history-heading"
                            >
                              <div class="panel-heading">
                                <div>
                                  <span class="eyebrow">Adoption</span>
                                  <h3 id="star-history-heading">Portfolio stars</h3>
                                </div>
                                <span>
                                  {formatSignedNumber(dashboard.period.starsGained)}
                                </span>
                              </div>
                              <LineChart
                                markers={dashboard.history.length <= 24}
                                aria-label={`Portfolio star growth for ${rangeLabel}`}
                                caption={`Total GitHub stars across enabled public projects during ${rangeLabel}.`}
                                series={portfolioStarsSeries}
                              />
                            </Card>
                          </div>
                        ) :
                        (
                          <Card class="panel history-empty">
                            <Empty>
                              <p>
                                Run another sync to establish a trend. Every
                                successful sync is stored in D1 and becomes part of
                                this range.
                              </p>
                            </Empty>
                          </Card>
                        )}
                    </section>
                  </div>

                  <div
                    class="dashboard-tab-panel"
                    data-value="projects"
                    role="tabpanel"
                  >
                    <section
                      class="portfolio-section"
                      aria-labelledby="portfolio-heading"
                      id="portfolio"
                    >
                      <div class="section-heading">
                        <div>
                          <span class="eyebrow">Public portfolio</span>
                          <h2 id="portfolio-heading">
                            Every published and open-source project
                          </h2>
                          <p>
                            Automatically discovered from GitHub, with product
                            metadata layered on top.
                          </p>
                        </div>
                        <div
                          class="category-summary"
                          aria-label="Projects by category"
                        >
                          {Object.entries(categoryCounts).map(
                            ([category, count]) => (
                              <span>
                                <strong>{count}</strong> {category}
                              </span>
                            )
                          )}
                        </div>
                      </div>

                      <div class="portfolio-toolbar" aria-label="Project filters">
                        <div class="portfolio-search">
                          <label class="sr-only" for="project-search">
                            Search projects
                          </label>
                          <SearchField
                            id="project-search"
                            autocomplete="off"
                            data-project-search
                            placeholder="Search projects…"
                          />
                        </div>
                        <div class="portfolio-selects">
                          <label class="sr-only" for="project-category">
                            Filter by category
                          </label>
                          <NativeSelect
                            id="project-category"
                            data-project-category
                            options={[
                              { label: 'All categories', value: 'all' },
                              { label: 'Apps', value: 'app' },
                              { label: 'Content', value: 'content' },
                              { label: 'Libraries', value: 'library' },
                              { label: 'Tools', value: 'tool' }
                            ]}
                            size="sm"
                          />
                          <label class="sr-only" for="project-status">
                            Filter by status
                          </label>
                          <NativeSelect
                            id="project-status"
                            data-project-status
                            options={[
                              { label: 'All statuses', value: 'all' },
                              { label: 'Active', value: 'active' },
                              { label: 'Maintained', value: 'maintained' },
                              { label: 'Paused', value: 'paused' },
                              { label: 'Archived', value: 'archived' }
                            ]}
                            size="sm"
                          />
                          <label class="sr-only" for="project-sort">
                            Sort projects
                          </label>
                          <NativeSelect
                            id="project-sort"
                            data-project-sort
                            options={[
                              { label: 'Most relevant', value: 'relevance' },
                              { label: 'Fastest growth', value: 'momentum' },
                              { label: 'Most downloads', value: 'downloads' },
                              { label: 'Most stars', value: 'stars' },
                              { label: 'Recently updated', value: 'updated' },
                              { label: 'Name', value: 'name' }
                            ]}
                            size="sm"
                          />
                          <Button
                            data-project-clear
                            size="sm"
                            type="button"
                            variant="ghost"
                          >
                            Clear
                          </Button>
                        </div>
                        <span
                          aria-live="polite"
                          class="portfolio-result-count"
                          data-project-result-count
                        >
                          {dashboard.projects.length} projects
                        </span>
                      </div>

                      <Table
                        aria-label="Project catalog. Scroll horizontally to see all columns."
                        class="portfolio-table"
                        role="region"
                        tabindex="0"
                      >
                        <table>
                          <thead>
                            <tr>
                              <th scope="col">Project</th>
                              <th scope="col">Status</th>
                              <th scope="col">Reach</th>
                              <th scope="col">Growth</th>
                              <th scope="col">Maintenance</th>
                              <th scope="col">Health</th>
                              <th scope="col">Last push</th>
                              <th scope="col">
                                <span class="sr-only">Open</span>
                              </th>
                            </tr>
                          </thead>
                          <tbody data-project-rows>
                            {dashboard.projects.map(project => {
                              const growth = growthBySlug.get(project.slug)
                              const growthItem = growth ? { growth, project } : null

                              return (
                                <tr
                                  data-project-category={project.category}
                                  data-project-downloads={project.npmDownloads30d}
                                  data-project-growth-change={growth?.downloadVelocityChange ?? 0}
                                  data-project-growth-priority={
                                    growth ? growthSignalPriority[growth.signal] : 0
                                  }
                                  data-project-name={project.name.toLocaleLowerCase()}
                                  data-project-relevance={project.relevanceScore}
                                  data-project-stars={project.stars}
                                  data-project-status={project.status}
                                  data-project-updated={
                                    project.pushedAt ?
                                      Date.parse(project.pushedAt) :
                                      0
                                  }
                                >
                                  <td>
                                    <div class="project-cell">
                                      <span class="project-icon">
                                        <Icon
                                          aria-hidden="true"
                                          name={getCategoryIcon(project.category)}
                                        />
                                      </span>
                                      <span>
                                        <strong>
                                          <a
                                            class="project-link"
                                            href={`/projects/${project.slug}/?range=${dashboard.range}`}
                                          >
                                            {project.name}
                                          </a>
                                        </strong>
                                        <small>
                                          {project.description ?? project.slug}
                                        </small>
                                      </span>
                                    </div>
                                  </td>
                                  <td>
                                    <StatusBadge status={project.status} />
                                  </td>
                                  <td>
                                    <strong>
                                      {formatNumber(project.npmDownloads30d)}
                                    </strong>
                                    <small>
                                      npm / 30d · relevance {project.relevanceScore}
                                    </small>
                                  </td>
                                  <td>
                                    {growthItem ?
                                      (
                                        <div class="project-growth-cell">
                                          <span>
                                            <Badge
                                              variant={getGrowthBadgeVariant(
                                                growthItem.growth.signal
                                              )}
                                            >
                                              {growthItem.growth.signal}
                                            </Badge>
                                            <small>
                                              {growthItem.growth.observations >= 2 ?
                                                getGrowthMetricLabel(growthItem) :
                                                'Needs another observation'}
                                            </small>
                                          </span>
                                          {growthItem.growth.npmDownloads30dTrend.length >= 2 && (
                                            <Sparkline
                                              area
                                              class="project-growth-cell__sparkline"
                                              label={`${growthItem.project.name} rolling 30-day npm download trend across ${growthItem.growth.observations} observations for ${rangeLabel}`}
                                              tone={getGrowthTrendTone(
                                                growthItem.growth.signal
                                              )}
                                              values={growthItem.growth.npmDownloads30dTrend}
                                            />
                                          )}
                                        </div>
                                      ) :
                                      (
                                        <small>Not available</small>
                                      )}
                                  </td>
                                  <td>
                                    <strong>{project.openIssues} issues</strong>
                                    <small>
                                      {project.stars} stars · {project.forks} forks
                                    </small>
                                  </td>
                                  <td>
                                    <span
                                      class={`health-label health-label--${project.healthStatus}`}
                                    >
                                      <span class="health-dot" />
                                      {project.healthStatus}
                                    </span>
                                    <small>
                                      {formatDuration(project.responseTimeMs)}
                                    </small>
                                  </td>
                                  <td>
                                    <strong>
                                      {formatRelativeDate(project.pushedAt)}
                                    </strong>
                                    <small>{formatDate(project.pushedAt)}</small>
                                  </td>
                                  <td>
                                    <ButtonLink
                                      ariaLabel={`View ${project.name} dashboard`}
                                      href={`/projects/${project.slug}/?range=${dashboard.range}`}
                                      shape="icon"
                                      variant="ghost"
                                    >
                                      <Icon aria-hidden="true" name="arrow-right" />
                                    </ButtonLink>
                                  </td>
                                </tr>
                              )
                            })}
                          </tbody>
                        </table>
                      </Table>
                      <Card
                        class="portfolio-filter-empty"
                        data-project-filter-empty
                        hidden
                      >
                        <Empty>
                          <Icon aria-hidden="true" name="search-x" />
                          <p>No projects match those filters.</p>
                          <Button
                            data-project-clear
                            type="button"
                            variant="outline"
                          >
                            Clear filters
                          </Button>
                        </Empty>
                      </Card>
                    </section>
                  </div>
                </>
              )
          }
        </Tabs>
      </main>

      <footer class="app-footer">
        <span>Observatory is private by design.</span>
        <span>
          Last successful sync {
            dashboard.sync.completedAt ?
              formatDate(dashboard.sync.completedAt) :
              'not run'
          }
        </span>
      </footer>
    </div>
  </div>
</AppLayout>

<script>
  import {
    compareProjectSortRecords,
    type ProjectSortRecord
  } from '@/lib/project-sort'

  const search = document.querySelector<HTMLInputElement>(
    '[data-project-search]'
)

  const category = document.querySelector<HTMLSelectElement>(
    '[data-project-category]'
)

  const status = document.querySelector<HTMLSelectElement>(
    '[data-project-status]'
)

  const sort = document.querySelector<HTMLSelectElement>('[data-project-sort]')

  const rowsContainer = document.querySelector<HTMLTableSectionElement>(
    '[data-project-rows]'
)

  const resultCount = document.querySelector<HTMLElement>(
    '[data-project-result-count]'
)

  const empty = document.querySelector<HTMLElement>(
    '[data-project-filter-empty]'
)

  const table = rowsContainer?.closest<HTMLElement>('[role="region"]')

  const rows = rowsContainer ?
  [...rowsContainer.querySelectorAll<HTMLTableRowElement>('tr')] :
  []

  const toProjectSortRecord = (
    row: HTMLTableRowElement
  ): ProjectSortRecord => ({
    downloads: Number(row.dataset.projectDownloads ?? 0),
    growthChange: Number(row.dataset.projectGrowthChange ?? 0),
    growthPriority: Number(row.dataset.projectGrowthPriority ?? 0),
    name: row.dataset.projectName ?? '',
    relevance: Number(row.dataset.projectRelevance ?? 0),
    stars: Number(row.dataset.projectStars ?? 0),
    updated: Number(row.dataset.projectUpdated ?? 0)
  })

  const compareProjectRows = (
    left: HTMLTableRowElement,
    right: HTMLTableRowElement,
    selectedSort: string
  ): number => compareProjectSortRecords(
      toProjectSortRecord(left),
      toProjectSortRecord(right),
      selectedSort
    )

  const rowMatchesFilters = (
    row: HTMLTableRowElement,
    query: string,
    selectedCategory: string,
    selectedStatus: string
): boolean => {
    const matchesQuery =
      query.length === 0 ||
      row.textContent?.toLocaleLowerCase().includes(query) === true

    const matchesCategory =
      selectedCategory === 'all' ||
      row.dataset.projectCategory === selectedCategory

    const matchesStatus =
      selectedStatus === 'all' || row.dataset.projectStatus === selectedStatus

    return matchesQuery && matchesCategory && matchesStatus
  }

  const formatProjectCount = (count: number): string => `${count} project${count === 1 ? '' : 's'}`

  const readFilterValue = (
    control: HTMLInputElement | HTMLSelectElement | null,
    fallback: string
): string => control?.value ?? fallback

  const applyRowVisibility = (row: HTMLTableRowElement, isVisible: boolean) => {
    row.hidden = !isVisible

    rowsContainer?.append(row)
  }

  const updateFilterSummary = (visibleCount: number) => {
    if (resultCount) resultCount.textContent = formatProjectCount(visibleCount)

    table?.toggleAttribute('hidden', visibleCount === 0)

    empty?.toggleAttribute('hidden', visibleCount > 0)
  }

  const updateProjects = () => {
    const query = readFilterValue(search, '').trim().toLocaleLowerCase()
    const selectedCategory = readFilterValue(category, 'all')
    const selectedStatus = readFilterValue(status, 'all')
    const selectedSort = readFilterValue(sort, 'relevance')

    rows.sort((left, right) => compareProjectRows(left, right, selectedSort))

    let visibleCount = 0

    for (const row of rows) {
      const isVisible = rowMatchesFilters(
        row,
        query,
        selectedCategory,
        selectedStatus
    )

      if (isVisible) visibleCount += 1

      applyRowVisibility(row, isVisible)
    }

    updateFilterSummary(visibleCount)
  }

  search?.addEventListener('input', updateProjects)

  category?.addEventListener('change', updateProjects)

  status?.addEventListener('change', updateProjects)

  sort?.addEventListener('change', updateProjects)

  for (const clear of document.querySelectorAll<HTMLButtonElement>(
    '[data-project-clear]'
)) {
    clear.addEventListener('click', () => {
      if (search) search.value = ''

      if (category) category.value = 'all'

      if (status) status.value = 'all'

      if (sort) sort.value = 'relevance'

      updateProjects()

      search?.focus()
    })
  }
</script>
