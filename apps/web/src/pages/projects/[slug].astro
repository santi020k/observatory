---
import AppHeader from '@/components/AppHeader.astro'
import AppSidebar from '@/components/AppSidebar.astro'
import MetricCard from '@/components/MetricCard.astro'
import RangePicker from '@/components/RangePicker.astro'
import StatusBadge from '@/components/StatusBadge.astro'
import AppLayout from '@/layouts/AppLayout.astro'

import {
  analyticsRangeMeta,
  formatHistoryLabel,
  getNpmChart
} from '@/lib/analytics-range'
import {
  getBrowserApiUrl,
  getProjectDashboard,
  getProjectSettings
} from '@/lib/api'
import {
  formatDate,
  formatDuration,
  formatNumber,
  formatRelativeDate
} from '@/lib/format'
import { aggregateWebsiteAnalytics } from '@/lib/website-analytics'

import Badge from '@santi020k/lumen-astro/components/Badge'
import ButtonLink from '@santi020k/lumen-astro/components/ButtonLink'
import Card from '@santi020k/lumen-astro/components/Card'
import Empty from '@santi020k/lumen-astro/components/Empty'
import Icon from '@santi020k/lumen-astro/components/Icon'
import LineChart from '@santi020k/lumen-astro/components/LineChart'
import Table from '@santi020k/lumen-astro/components/Table'
import Tabs from '@santi020k/lumen-astro/components/Tabs'
import { analyticsRangeSchema } from '@santi020k/observatory-api-types'

const slug = Astro.params.slug

if (!slug) return Astro.redirect('/dashboard/')

const range = analyticsRangeSchema
  .catch('30d')
  .parse(Astro.url.searchParams.get('range'))

const [response, settingsResponse] = await Promise.all([
  getProjectDashboard(slug, range, Astro.request, Astro.url),
  getProjectSettings(Astro.request, Astro.url)
])

if (response.status === 401) return Astro.redirect('/login/')

if (response.status === 404) return Astro.redirect('/404/')

if (
  !response.ok ||
  !response.parsed ||
  !settingsResponse.ok ||
  !settingsResponse.parsed
)
  throw new Error('Observatory API is unavailable.')

const dashboard = response.parsed
const project = dashboard.project
const websiteAnalytics = dashboard.websiteAnalytics

const sidebarProjects = settingsResponse.parsed.projects.filter(
  candidate => candidate.enabled
)

const apiUrl = getBrowserApiUrl()

const websiteHistory = websiteAnalytics ?
  aggregateWebsiteAnalytics(websiteAnalytics.history, dashboard.range) :
  []

const websiteDataIsSampled = websiteHistory.some(
  point => point.sampleInterval > 1
)

const operationalHealth = dashboard.operationalHealth

const operationalAvailability = operationalHealth.availabilityPercent === null ?
  '—' :
  `${operationalHealth.availabilityPercent.toFixed(
    operationalHealth.availabilityPercent === 100 ? 0 : 2
  )}%`

const rangeMeta = analyticsRangeMeta[dashboard.range]
const rangeLabel = rangeMeta.longLabel

const websiteTrafficSeries = [
  {
    data: websiteHistory.map(point => ({
      label: `${formatNumber(point.pageViews)} page views`,
      x: formatHistoryLabel(point.periodStart, dashboard.range),
      y: point.pageViews
    })),
    id: 'page-views',
    label: 'Page views',
    tone: 'brand'
  },
  {
    data: websiteHistory.map(point => ({
      label: `${formatNumber(point.visits)} visits`,
      x: formatHistoryLabel(point.periodStart, dashboard.range),
      y: point.visits
    })),
    id: 'visits',
    label: 'Visits',
    tone: 'accent'
  }
] as const

const npmChart = getNpmChart(dashboard.npmAnalytics, dashboard.range)
const npmPackageCount = dashboard.npmAnalytics.packages.length

const npmRawDownloads = dashboard.npmAnalytics.packages.reduce(
  (total, packageDownloads) => total + packageDownloads.downloads,
  0
)

const npmLast7Days =
  dashboard.npmAnalytics.daily.length >= 7 ?
    dashboard.npmAnalytics.daily
      .slice(-7)
      .reduce((total, point) => total + point.downloads, 0) :
    null

let npmLast7DaysContext = 'Requires 7 completed days'

if (npmLast7Days !== null)
  npmLast7DaysContext = npmPackageCount === 1 ?
    'Same time window npm highlights' :
    `Average of ${formatNumber(npmPackageCount)} packages`

const formatNpmPeriodLabel = (value: string): string => {
  let options: Intl.DateTimeFormatOptions

  if (npmChart.cadence === 'yearly') options = { year: 'numeric' }
  else if (npmChart.cadence === 'monthly')
    options = { month: 'short', year: '2-digit' }
  else options = { day: 'numeric', month: 'short' }

  return new Intl.DateTimeFormat('en', options).format(new Date(value))
}

const downloadHistorySeries = [
  {
    data: npmChart.points.map(point => ({
      label: `${formatNumber(point.downloads)} downloads`,
      x: formatNpmPeriodLabel(point.periodStart),
      y: point.downloads
    })),
    id: 'downloads',
    label: 'Downloads',
    tone: 'brand'
  }
] as const

const vscodeHistorySeries = [
  {
    data: dashboard.vscodeAnalytics.history.map(point => ({
      label: `${formatNumber(point.downloads)} downloads`,
      x: formatHistoryLabel(point.collectedAt, dashboard.range),
      y: point.downloads
    })),
    id: 'vscode-downloads',
    label: 'Marketplace downloads',
    tone: 'brand'
  }
] as const

const openVsxHistorySeries = [
  {
    data: dashboard.openVsxAnalytics.history.map(point => ({
      label: `${formatNumber(point.downloads)} downloads`,
      x: formatHistoryLabel(point.collectedAt, dashboard.range),
      y: point.downloads
    })),
    id: 'open-vsx-downloads',
    label: 'Open VSX downloads',
    tone: 'accent'
  }
] as const

const releaseHistorySeries = [
  {
    data: dashboard.releaseAnalytics.history.map(point => ({
      label: `${formatNumber(point.downloads)} downloads`,
      x: formatHistoryLabel(point.collectedAt, dashboard.range),
      y: point.downloads
    })),
    id: 'release-downloads',
    label: 'Release downloads',
    tone: 'brand'
  }
] as const

const releaseChannelLabels = {
  direct: 'Direct download',
  homebrew: 'Homebrew',
  'homebrew-or-update': 'Homebrew or update',
  update: 'In-app update',
  website: 'Website'
} as const

const getOpenVsxUrl = (extensionId: string): string => {
  const extensionParts = extensionId.split('.', 2)
  const namespace = extensionParts[0] ?? 'santi020k'
  const name = extensionParts[1] ?? extensionId

  return `https://open-vsx.org/extension/${namespace}/${name}`
}

const formatSignedNumber = (value: number): string => `${value > 0 ? '+' : ''}${formatNumber(value)}`

interface ProjectPulseMetric {
  context: string
  icon: 'activity' | 'download' | 'monitor' | 'mouse-pointer-click' | 'star'
  label: string
  value: string
}

let primaryReachMetric: ProjectPulseMetric = {
  context: `${formatNumber(project.forks)} forks on GitHub`,
  icon: 'star',
  label: 'Total stars',
  value: formatNumber(project.stars)
}

if (project.sources.npm.length > 0)
  primaryReachMetric = {
    context: `${npmPackageCount === 1 ? 'Exact package total' : `Average of ${formatNumber(npmPackageCount)} packages`} · ${rangeLabel}`,
    icon: 'download',
    label: 'Project downloads',
    value: formatNumber(dashboard.npmAnalytics.totalDownloads)
  }
else if (dashboard.releaseAnalytics.assets.length > 0)
  primaryReachMetric = {
    context: 'Cumulative GitHub release asset requests',
    icon: 'download',
    label: 'Release downloads',
    value: formatNumber(dashboard.releaseAnalytics.totalDownloads)
  }
else if (websiteAnalytics)
  primaryReachMetric = {
    context: `Cloudflare total · ${rangeLabel}`,
    icon: 'mouse-pointer-click',
    label: 'Page views',
    value: formatNumber(websiteAnalytics.pageViews)
  }
else if (dashboard.vscodeAnalytics.extensions.length > 0)
  primaryReachMetric = {
    context: `${formatNumber(dashboard.vscodeAnalytics.totalInstalls)} current installs`,
    icon: 'monitor',
    label: 'Extension downloads',
    value: formatNumber(dashboard.vscodeAnalytics.totalDownloads)
  }

let momentumMetric: ProjectPulseMetric = {
  context: `Net change · ${rangeLabel}`,
  icon: 'star',
  label: 'Stars gained',
  value: formatSignedNumber(dashboard.period.starsGained)
}

if (project.sources.npm.length > 0)
  momentumMetric = {
    context: `Rolling 30-day velocity · ${rangeLabel}`,
    icon: 'activity',
    label: 'Download momentum',
    value: formatSignedNumber(dashboard.period.downloadVelocityChange)
  }

if (dashboard.releaseAnalytics.assets.length > 0)
  momentumMetric = {
    context: `Observed cumulative growth · ${rangeLabel}`,
    icon: 'activity',
    label: 'New release downloads',
    value: formatSignedNumber(dashboard.releaseAnalytics.downloadsGained)
  }

let momentumTrendValues = dashboard.history.map(point => point.stars)

if (project.sources.npm.length > 0)
  momentumTrendValues = dashboard.history.map(point => point.npmDownloads30d)

if (dashboard.releaseAnalytics.assets.length > 0)
  momentumTrendValues = dashboard.releaseAnalytics.history.map(
    point => point.downloads
  )

const growthPercent = dashboard.growth.downloadVelocityPercent === null ?
  null :
  `${new Intl.NumberFormat('en', {
    maximumFractionDigits: 1,
    signDisplay: 'exceptZero'
  }).format(dashboard.growth.downloadVelocityPercent)}%`

const getGrowthBadgeVariant = (): 'outline' | 'secondary' | 'success' | 'warning' => {
  if (
    dashboard.growth.signal === 'accelerating' ||
    dashboard.growth.signal === 'growing'
  )
    return 'success'

  if (dashboard.growth.signal === 'slowing') return 'warning'

  if (dashboard.growth.signal === 'steady') return 'secondary'

  return 'outline'
}

const growthBadgeVariant = getGrowthBadgeVariant()

const growthGuidance = (() => {
  if (dashboard.growth.signal === 'accelerating')
    return {
      action:
        'Ship the next high-confidence improvement and amplify the channels already producing adoption.',
      heading: 'Protect the momentum'
    }

  if (dashboard.growth.signal === 'growing')
    return {
      action:
        'Repeat the release and distribution loop that created this traction, then watch whether velocity compounds.',
      heading: 'Turn traction into a repeatable loop'
    }

  if (dashboard.growth.signal === 'slowing')
    return {
      action:
        'Check release cadence, discovery channels, and recent product friction before investing more build time.',
      heading: 'Diagnose the slowdown'
    }

  if (dashboard.growth.signal === 'steady')
    return {
      action:
        'Run one focused product or distribution experiment with a measurable outcome for the next sync window.',
      heading: 'Create a measurable catalyst'
    }

  return {
    action:
      'Run another successful sync in this range to establish a trustworthy direction before making a growth decision.',
    heading: 'Establish the baseline'
  }
})()
---

<AppLayout
  description={`Analytics and operational health for ${project.name}.`}
  title={`${project.name} · Observatory`}
>
  <div class="app-shell">
    <AppSidebar projects={sidebarProjects} range={dashboard.range} />
    <div class="app-workspace">
      <AppHeader
        apiUrl={apiUrl}
        lastSync={dashboard.sync.completedAt ?
          formatRelativeDate(dashboard.sync.completedAt) :
          'awaiting first sync'}
        syncStatus={dashboard.sync.status}
      />

      <main class="dashboard project-dashboard" id="main-content">
        <nav aria-label="Breadcrumb" class="breadcrumb">
          <a href={`/dashboard/?range=${dashboard.range}`}>Overview</a>
          <Icon aria-hidden="true" name="chevron-right" />
          <span aria-current="page">{project.name}</span>
        </nav>

        <section class="hero-row" aria-labelledby="project-title">
          <div>
            <span class="eyebrow">{project.category} dashboard</span>
            <h1 id="project-title">{project.name}</h1>
            <p>{project.description ?? `Analytics for ${project.slug}.`}</p>
            <div class="project-meta">
              <StatusBadge status={project.status} />
              <Badge variant="outline">
                <span
                  class:list={[
                    'health-dot',
                    `health-dot--${project.healthStatus}`
                  ]}
                >
                </span>
                {project.healthStatus}
              </Badge>
              {
                project.latestVersion && (
                  <Badge variant="secondary">v{project.latestVersion}</Badge>
                )
              }
              <Badge variant="outline">
                <Icon aria-hidden="true" name="history" />
                Pushed {formatRelativeDate(project.pushedAt)}
              </Badge>
            </div>
          </div>
          <div class="hero-controls">
            <RangePicker range={dashboard.range} />
            <div class="source-legend">
              <ButtonLink
                href={project.sources.github}
                newTab
                variant="secondary"
              >
                <Icon aria-hidden="true" name="git-fork" />
                Repository
              </ButtonLink>
              {
                project.sources.website && (
                  <ButtonLink
                    href={project.sources.website}
                    newTab
                    variant="secondary"
                  >
                    <Icon aria-hidden="true" name="globe" />
                    Website
                  </ButtonLink>
                )
              }
              {
                project.sources.vscode[0] && (
                  <ButtonLink
                    href={project.sources.vscode[0]}
                    newTab
                    variant="secondary"
                  >
                    <Icon aria-hidden="true" name="monitor" />
                    VS Code
                  </ButtonLink>
                )
              }
              {
                project.sources.openVsx[0] && (
                  <ButtonLink
                    href={project.sources.openVsx[0]}
                    newTab
                    variant="secondary"
                  >
                    <Icon aria-hidden="true" name="blocks" />
                    Open VSX
                  </ButtonLink>
                )
              }
            </div>
          </div>
        </section>

        <Tabs class="dashboard-tabs project-tabs" initialValue="pulse">
          <div
            aria-label={`${project.name} dashboard views`}
            class="dashboard-tablist"
            role="tablist"
          >
            <button aria-selected="true" data-value="pulse" role="tab">
              <Icon aria-hidden="true" name="gauge" />
              Pulse
            </button>
            {
              project.sources.website && (
                <button aria-selected="false" data-value="website" role="tab">
                  <Icon aria-hidden="true" name="globe" />
                  Website
                </button>
              )
            }
            {
              dashboard.releaseAnalytics.assets.length > 0 && (
                <button aria-selected="false" data-value="downloads" role="tab">
                  <Icon aria-hidden="true" name="download" />
                  Downloads
                </button>
              )
            }
            {
              project.sources.npm.length > 0 && (
                <button aria-selected="false" data-value="packages" role="tab">
                  <Icon aria-hidden="true" name="package" />
                  Packages
                </button>
              )
            }
            {
              (project.sources.vscode.length > 0 ||
                project.sources.openVsx.length > 0) && (
                <button
                  aria-selected="false"
                  data-value="extensions"
                  role="tab"
                >
                  <Icon aria-hidden="true" name="blocks" />
                  Extensions
                </button>
              )
            }
            <button aria-selected="false" data-value="details" role="tab">
              <Icon aria-hidden="true" name="list-tree" />
              Details
            </button>
          </div>

          <div
            class="dashboard-tab-panel dashboard-tab-panel--pulse"
            data-value="pulse"
            role="tabpanel"
          >
            <Card
              as="section"
              class="project-growth-brief"
              aria-labelledby="project-growth-heading"
            >
              <div class="project-growth-brief__summary">
                <span class="project-growth-brief__icon">
                  <Icon aria-hidden="true" name="chart-no-axes-combined" />
                </span>
                <div>
                  <span class="eyebrow">Recommended next move</span>
                  <h2 id="project-growth-heading">{growthGuidance.heading}</h2>
                  <p>{growthGuidance.action}</p>
                </div>
              </div>
              <div class="project-growth-brief__signal">
                <Badge variant={growthBadgeVariant}>
                  {dashboard.growth.signal}
                </Badge>
                <span>
                  {dashboard.growth.observations}{' '}
                  {dashboard.growth.observations === 1 ?
                    'observation' :
                    'observations'}
                </span>
              </div>
              <dl class="project-growth-evidence">
                <div>
                  <dt>Download velocity</dt>
                  <dd>
                    {formatSignedNumber(
                      dashboard.growth.downloadVelocityChange
                    )}
                    {growthPercent && <small>{growthPercent}</small>}
                  </dd>
                </div>
                <div>
                  <dt>Stars gained</dt>
                  <dd>{formatSignedNumber(dashboard.growth.starsGained)}</dd>
                </div>
                <div>
                  <dt>Issue change</dt>
                  <dd>{formatSignedNumber(dashboard.growth.issueChange)}</dd>
                </div>
              </dl>
            </Card>

            <section
              class="metric-grid project-metric-grid"
              aria-label={`${project.name} metrics`}
            >
              <MetricCard {...primaryReachMetric} />
              <MetricCard
                {...momentumMetric}
                trend={{
                  label: `${project.name} momentum trend for ${rangeLabel}`,
                  tone: 'brand',
                  values: momentumTrendValues
                }}
              />
              <MetricCard
                context="Current authenticated 14-day traffic"
                icon="eye"
                label="GitHub views"
                value={formatNumber(project.githubViews14d)}
              />
              <MetricCard
                context={`Change ${dashboard.period.issueChange >= 0 ? '+' : ''}${formatNumber(dashboard.period.issueChange)} in range`}
                icon="circle-dot-dashed"
                label="Open issues"
                trend={{
                  label: `${project.name} issue trend for ${rangeLabel}`,
                  tone:
                    dashboard.period.issueChange > 0 ? 'warning' : 'neutral',
                  values: dashboard.history.map(point => point.openIssues)
                }}
                value={formatNumber(project.openIssues)}
              />
            </section>
          </div>

          {
            project.sources.website && (
              <div
                class="dashboard-tab-panel"
                data-value="website"
                role="tabpanel"
              >
                <section
                  class="website-analytics-section"
                  aria-labelledby="website-analytics-heading"
                >
                  <div class="section-heading">
                    <div>
                      <span class="eyebrow">Cloudflare Web Analytics</span>
                      <h2 id="website-analytics-heading">Website traffic</h2>
                      <p>
                        Privacy-first page activity for{' '}
                        {websiteAnalytics?.hostname ??
                          new URL(project.sources.website).hostname}
                        .
                      </p>
                    </div>
                    {websiteAnalytics && (
                      <Badge variant="outline">{rangeLabel}</Badge>
                    )}
                  </div>

                  <div
                    class="website-metric-grid"
                    aria-label={`${project.name} operational health metrics`}
                  >
                    <MetricCard
                      context={`${formatNumber(operationalHealth.observations)} checks · ${operationalHealth.availabilityTarget}% objective`}
                      icon="activity"
                      label="Observed availability"
                      value={operationalAvailability}
                    />
                    <MetricCard
                      context={`Median ${formatDuration(operationalHealth.latencyP50Ms)}`}
                      icon="history"
                      label="p95 response time"
                      value={formatDuration(operationalHealth.latencyP95Ms)}
                    />
                    <MetricCard
                      context={operationalHealth.lastOutageStartedAt ?
                        `Last outage ${formatRelativeDate(operationalHealth.lastOutageStartedAt)}` :
                        'No outage observed in this range'}
                      icon="circle-dot-dashed"
                      label="Failed checks"
                      value={formatNumber(operationalHealth.failedChecks)}
                    />
                    <MetricCard
                      context={operationalHealth.lastRecoveredAt ?
                        `Last recovery ${formatRelativeDate(operationalHealth.lastRecoveredAt)}` :
                        `Current status: ${operationalHealth.currentStatus}`}
                      icon="activity"
                      label="Consecutive failures"
                      value={formatNumber(
                        operationalHealth.consecutiveFailures
                      )}
                    />
                  </div>

                  {websiteAnalytics ?
                    (
                      <div class="website-analytics-grid">
                        <div
                          class="website-metric-grid"
                          aria-label={`${project.name} website metrics`}
                        >
                          <MetricCard
                            context={`Cloudflare total · ${rangeLabel}`}
                            icon="mouse-pointer-click"
                            label="Page views"
                            value={formatNumber(websiteAnalytics.pageViews)}
                          />
                          <MetricCard
                            context="Direct or externally referred sessions"
                            icon="users"
                            label="Visits"
                            value={formatNumber(websiteAnalytics.visits)}
                          />
                        </div>

                        <Card
                          as="section"
                          class="panel website-traffic-panel"
                          aria-labelledby="website-traffic-history-heading"
                        >
                          <div class="panel-heading">
                            <div>
                              <span class="eyebrow">Traffic over time</span>
                              <h3 id="website-traffic-history-heading">
                                Page views and visits
                              </h3>
                            </div>
                          </div>

                          <LineChart
                            area
                            aria-label={`${project.name} website traffic history`}
                            caption={`${rangeMeta.bucketLabel} Cloudflare totals.${
                              websiteDataIsSampled ?
                                ' Cloudflare adaptive sampling is present in this range.' :
                                ''
                            }`}
                            series={websiteTrafficSeries}
                          />
                        </Card>
                      </div>
                    ) :
                    (
                      <Card class="panel website-analytics-empty">
                        <Empty>
                          <span class="empty-icon">
                            <Icon
                              aria-hidden="true"
                              name="chart-no-axes-column"
                            />
                          </span>
                          <h3>No Cloudflare traffic yet</h3>
                          <p>
                            Data will appear after the Web Analytics beacon
                            reports activity and the next analytics sync
                            completes.
                          </p>
                        </Empty>
                      </Card>
                    )}
                </section>
              </div>
            )
          }

          {
            dashboard.releaseAnalytics.assets.length > 0 && (
              <div
                class="dashboard-tab-panel project-channel-panel"
                data-value="downloads"
                role="tabpanel"
              >
                <section
                  class="vscode-analytics-section"
                  aria-labelledby="project-release-downloads-heading"
                >
                  <div class="section-heading">
                    <div>
                      <span class="eyebrow">GitHub Releases</span>
                      <h2 id="project-release-downloads-heading">
                        Application downloads
                      </h2>
                      <p>
                        Asset requests are cumulative provider counters, not
                        unique users or confirmed installations.
                      </p>
                    </div>
                    <Badge variant="outline">{rangeLabel}</Badge>
                  </div>

                  <div
                    class="website-metric-grid"
                    aria-label={`${project.name} release download metrics`}
                  >
                    <MetricCard
                      context="Across every tracked release asset"
                      icon="download"
                      label="Lifetime downloads"
                      value={formatNumber(
                        dashboard.releaseAnalytics.totalDownloads
                      )}
                    />
                    <MetricCard
                      context={`Observed cumulative growth · ${rangeLabel}`}
                      icon="activity"
                      label="Downloads gained"
                      value={formatSignedNumber(
                        dashboard.releaseAnalytics.downloadsGained
                      )}
                    />
                  </div>

                  <div class="vscode-project-grid">
                    {dashboard.releaseAnalytics.history.length > 1 && (
                      <Card
                        as="section"
                        class="panel"
                        aria-labelledby="project-release-history-heading"
                      >
                        <div class="panel-heading">
                          <div>
                            <span class="eyebrow">Observed growth</span>
                            <h3 id="project-release-history-heading">
                              Cumulative downloads
                            </h3>
                          </div>
                        </div>
                        <LineChart
                          markers={
                            dashboard.releaseAnalytics.history.length <= 24
                          }
                          aria-label={`${project.name} cumulative GitHub release downloads for ${rangeLabel}`}
                          caption="Cumulative release asset requests reported by GitHub at each Observatory sync."
                          series={releaseHistorySeries}
                        />
                      </Card>
                    )}

                    <Card class="panel">
                      <Table>
                        <caption class="sr-only">
                          {project.name} GitHub release asset downloads
                        </caption>
                        <thead>
                          <tr>
                            <th scope="col">Channel</th>
                            <th scope="col">Release</th>
                            <th scope="col">Asset</th>
                            <th scope="col">Downloads</th>
                          </tr>
                        </thead>
                        <tbody>
                          {dashboard.releaseAnalytics.assets.map(asset => (
                            <tr>
                              <td>{releaseChannelLabels[asset.channel]}</td>
                              <td>{asset.releaseTag}</td>
                              <td><code>{asset.assetName}</code></td>
                              <td>{formatNumber(asset.downloads)}</td>
                            </tr>
                          ))}
                        </tbody>
                        <tfoot>
                          <tr>
                            <th colspan={3} scope="row">All assets</th>
                            <td>
                              <strong>
                                {formatNumber(
                                  dashboard.releaseAnalytics.totalDownloads
                                )}
                              </strong>
                            </td>
                          </tr>
                        </tfoot>
                      </Table>
                    </Card>
                  </div>
                </section>
              </div>
            )
          }

          {
            (project.sources.vscode.length > 0 ||
              project.sources.openVsx.length > 0) && (
              <div
                class="dashboard-tab-panel project-channel-panel"
                data-value="extensions"
                role="tabpanel"
              >
                {dashboard.vscodeAnalytics.extensions.length > 0 && (
                  <section
                    class="vscode-analytics-section"
                    aria-labelledby="project-vscode-heading"
                  >
                    <div class="section-heading">
                      <div>
                        <span class="eyebrow">VS Code Marketplace</span>
                        <h2 id="project-vscode-heading">Extension reach</h2>
                        <p>
                          Marketplace data stays separate from npm package
                          downloads and GitHub repository activity.
                        </p>
                      </div>
                      <Badge variant="outline">Marketplace snapshot</Badge>
                    </div>
                    <div class="vscode-project-grid">
                      {dashboard.vscodeAnalytics.history.length > 1 && (
                        <Card
                          as="section"
                          class="panel"
                          aria-labelledby="project-vscode-history-heading"
                        >
                          <div class="panel-heading">
                            <div>
                              <span class="eyebrow">Observed growth</span>
                              <h3 id="project-vscode-history-heading">
                                Cumulative downloads
                              </h3>
                            </div>
                          </div>
                          <LineChart
                            markers={
                              dashboard.vscodeAnalytics.history.length <= 24
                            }
                            aria-label={`${project.name} VS Code Marketplace downloads for ${rangeLabel}`}
                            caption="Cumulative downloads reported by the VS Code Marketplace at each Observatory sync."
                            series={vscodeHistorySeries}
                          />
                        </Card>
                      )}
                      <Card class="panel">
                        <Table>
                          <caption class="sr-only">
                            {project.name} VS Code Marketplace extensions
                          </caption>
                          <thead>
                            <tr>
                              <th scope="col">Extension</th>
                              <th scope="col">Version</th>
                              <th scope="col">Downloads</th>
                              <th scope="col">Installs</th>
                            </tr>
                          </thead>
                          <tbody>
                            {dashboard.vscodeAnalytics.extensions.map(
                              extension => (
                                <tr>
                                  <td>
                                    <a
                                      class="npm-package-link"
                                      href={
                                        'https://marketplace.visualstudio.com/items?itemName=' +
                                        extension.extensionId
                                      }
                                      rel="noreferrer"
                                      target="_blank"
                                    >
                                      {extension.extensionId}
                                      <Icon
                                        aria-hidden="true"
                                        name="arrow-up-right"
                                      />
                                    </a>
                                  </td>
                                  <td>{extension.version}</td>
                                  <td>{formatNumber(extension.downloads)}</td>
                                  <td>{formatNumber(extension.installs)}</td>
                                </tr>
                              )
                            )}
                          </tbody>
                        </Table>
                      </Card>
                    </div>
                  </section>
                )}

                {dashboard.openVsxAnalytics.extensions.length > 0 && (
                  <section
                    class="vscode-analytics-section"
                    aria-labelledby="project-open-vsx-heading"
                  >
                    <div class="section-heading">
                      <div>
                        <span class="eyebrow">Open VSX Registry</span>
                        <h2 id="project-open-vsx-heading">Open editor reach</h2>
                        <p>
                          Downloads from Open VSX stay separate from Microsoft
                          Marketplace installs and npm package usage.
                        </p>
                      </div>
                      <Badge variant="outline">Open VSX snapshot</Badge>
                    </div>
                    <div class="vscode-project-grid">
                      {dashboard.openVsxAnalytics.history.length > 1 && (
                        <Card
                          as="section"
                          class="panel"
                          aria-labelledby="project-open-vsx-history-heading"
                        >
                          <div class="panel-heading">
                            <div>
                              <span class="eyebrow">Observed growth</span>
                              <h3 id="project-open-vsx-history-heading">
                                Cumulative downloads
                              </h3>
                            </div>
                          </div>
                          <LineChart
                            markers={
                              dashboard.openVsxAnalytics.history.length <= 24
                            }
                            aria-label={`${project.name} Open VSX downloads for ${rangeLabel}`}
                            caption="Cumulative downloads reported by Open VSX at each Observatory sync."
                            series={openVsxHistorySeries}
                          />
                        </Card>
                      )}
                      <Card class="panel">
                        <Table>
                          <table>
                            <caption class="sr-only">
                              {project.name} Open VSX extensions
                            </caption>
                            <thead>
                              <tr>
                                <th scope="col">Extension</th>
                                <th scope="col">Version</th>
                                <th scope="col">Downloads</th>
                                <th scope="col">Reviews</th>
                              </tr>
                            </thead>
                            <tbody>
                              {dashboard.openVsxAnalytics.extensions.map(
                                extension => (
                                  <tr>
                                    <td>
                                      <a
                                        class="npm-package-link"
                                        href={getOpenVsxUrl(
                                          extension.extensionId
                                        )}
                                        rel="noreferrer"
                                        target="_blank"
                                      >
                                        {extension.extensionId}
                                        <Icon
                                          aria-hidden="true"
                                          name="arrow-up-right"
                                        />
                                      </a>
                                    </td>
                                    <td>{extension.version}</td>
                                    <td>{formatNumber(extension.downloads)}</td>
                                    <td>
                                      {formatNumber(extension.reviewCount)}
                                    </td>
                                  </tr>
                                )
                              )}
                            </tbody>
                          </table>
                        </Table>
                      </Card>
                    </div>
                  </section>
                )}

                {dashboard.vscodeAnalytics.extensions.length === 0 &&
                  dashboard.openVsxAnalytics.extensions.length === 0 && (
                  <Empty class="project-channel-empty">
                    <span class="empty-icon">
                      <Icon aria-hidden="true" name="blocks" />
                    </span>
                    <h2>Extension analytics start with the next sync</h2>
                    <p>
                      Observatory knows which registries this project uses and
                      will keep each provider's reach separate once a snapshot
                      succeeds.
                    </p>
                    <div class="project-channel-actions">
                      {project.sources.vscode[0] && (
                        <ButtonLink
                          href={project.sources.vscode[0]}
                          newTab
                          variant="secondary"
                        >
                          <Icon aria-hidden="true" name="monitor" />
                          Open VS Code Marketplace
                        </ButtonLink>
                      )}
                      {project.sources.openVsx[0] && (
                        <ButtonLink
                          href={project.sources.openVsx[0]}
                          newTab
                          variant="secondary"
                        >
                          <Icon aria-hidden="true" name="blocks" />
                          Open VSX Registry
                        </ButtonLink>
                      )}
                    </div>
                  </Empty>
                )}
              </div>
            )
          }

          {
            project.sources.npm.length > 0 && (
              <div
                class="dashboard-tab-panel"
                data-value="packages"
                role="tabpanel"
              >
                <section
                  aria-labelledby="project-packages-heading"
                  class="npm-analytics-section"
                >
                  <div class="section-heading">
                    <div>
                      <span class="eyebrow">npm registry</span>
                      <h2 id="project-packages-heading">Package downloads</h2>
                      <p>
                        Registry downloads are requests for package tarballs,
                        not unique users or installations.
                      </p>
                    </div>
                    <Badge variant="outline">{rangeLabel}</Badge>
                  </div>

                  <dl class="npm-summary-grid">
                    <div>
                      <dt>Project-adjusted</dt>
                      <dd>
                        {formatNumber(dashboard.npmAnalytics.totalDownloads)}
                      </dd>
                      <small>
                        {npmPackageCount === 1 ?
                          'Exact package total' :
                          `Average of ${formatNumber(npmPackageCount)} packages`}
                      </small>
                    </div>
                    <div>
                      <dt>Last 7 completed days</dt>
                      <dd>
                        {npmLast7Days === null ?
                          '—' :
                          formatNumber(npmLast7Days)}
                      </dd>
                      <small>{npmLast7DaysContext}</small>
                    </div>
                    <div>
                      <dt>Raw package total</dt>
                      <dd>{formatNumber(npmRawDownloads)}</dd>
                      <small>All mapped packages · {rangeLabel}</small>
                    </div>
                    <div>
                      <dt>Mapped packages</dt>
                      <dd>{formatNumber(npmPackageCount)}</dd>
                      <small>Compared individually below</small>
                    </div>
                  </dl>

                  <Card
                    as="section"
                    class="panel history-panel project-reach-panel"
                    aria-labelledby="project-history-heading"
                  >
                    <div class="panel-heading">
                      <div>
                        <span class="eyebrow">Reach over time</span>
                        <h3 id="project-history-heading">{npmChart.heading}</h3>
                      </div>
                    </div>
                    {npmChart.points.length > 0 ?
                      (
                        <LineChart
                          area
                          markers={npmChart.points.length <= 31}
                          aria-label={`${project.name} ${npmChart.heading.toLocaleLowerCase()} for ${rangeLabel}`}
                          caption={npmChart.caption}
                          series={downloadHistorySeries}
                        />
                      ) :
                      (
                        <Empty>
                          <p>
                            No npm download history is stored for {rangeLabel}.
                          </p>
                        </Empty>
                      )}
                  </Card>

                  <Card
                    as="section"
                    class="npm-package-panel"
                    aria-labelledby="project-package-table-heading"
                  >
                    <div class="npm-package-heading">
                      <div>
                        <span class="eyebrow">Package-by-package comparison</span>
                        <h3 id="project-package-table-heading">
                          Downloads by package
                        </h3>
                      </div>
                      <Badge variant="secondary">
                        {formatNumber(npmPackageCount)} packages
                      </Badge>
                    </div>
                    <Table class="npm-package-table">
                      <table>
                        <caption class="sr-only">
                          {project.name} npm package downloads for {rangeLabel}
                        </caption>
                        <thead>
                          <tr>
                            <th scope="col">Package</th>
                            <th scope="col">Period</th>
                            <th scope="col">Downloads</th>
                          </tr>
                        </thead>
                        <tbody>
                          {dashboard.npmAnalytics.packages.map(
                            packageDownloads => (
                              <tr>
                                <td>
                                  <a
                                    class="npm-package-link"
                                    href={`https://www.npmjs.com/package/${packageDownloads.packageName}`}
                                    rel="noreferrer"
                                    target="_blank"
                                  >
                                    {packageDownloads.packageName}
                                    <Icon
                                      aria-hidden="true"
                                      name="arrow-up-right"
                                    />
                                  </a>
                                </td>
                                <td>{rangeLabel}</td>
                                <td>
                                  <strong>
                                    {formatNumber(packageDownloads.downloads)}
                                  </strong>
                                </td>
                              </tr>
                            )
                          )}
                        </tbody>
                        <tfoot>
                          <tr>
                            <th colspan={2} scope="row">
                              Raw package total
                            </th>
                            <td>
                              <strong>{formatNumber(npmRawDownloads)}</strong>
                            </td>
                          </tr>
                        </tfoot>
                      </table>
                    </Table>
                    <p class="npm-method-note">
                      npm’s package page usually highlights a 7-day count. Match
                      both the package and period before comparing figures.
                    </p>
                  </Card>
                </section>
              </div>
            )
          }

          <div class="dashboard-tab-panel" data-value="details" role="tabpanel">
            <Card
              as="section"
              class="panel project-facts project-facts--full"
              aria-labelledby="project-facts-heading"
            >
              <div class="panel-heading">
                <div>
                  <span class="eyebrow">Details</span>
                  <h2 id="project-facts-heading">Project facts</h2>
                </div>
              </div>
              <dl>
                <div>
                  <dt>Last push</dt>
                  <dd>{formatRelativeDate(project.pushedAt)}</dd>
                </div>
                <div>
                  <dt>Exact date</dt>
                  <dd>{formatDate(project.pushedAt)}</dd>
                </div>
                <div>
                  <dt>npm packages</dt>
                  <dd>{formatNumber(project.sources.npm.length)}</dd>
                </div>
                <div>
                  <dt>VS Code extensions</dt>
                  <dd>{formatNumber(project.sources.vscode.length)}</dd>
                </div>
                <div>
                  <dt>Open VSX extensions</dt>
                  <dd>{formatNumber(project.sources.openVsx.length)}</dd>
                </div>
                <div>
                  <dt>Response time</dt>
                  <dd>{formatDuration(project.responseTimeMs)}</dd>
                </div>
                <div>
                  <dt>Snapshots in range</dt>
                  <dd>{formatNumber(dashboard.period.syncs)}</dd>
                </div>
                <div>
                  <dt>GitHub stars</dt>
                  <dd>{formatNumber(project.stars)}</dd>
                </div>
                <div>
                  <dt>GitHub forks</dt>
                  <dd>{formatNumber(project.forks)}</dd>
                </div>
              </dl>
              {
                project.topics.length > 0 && (
                  <div class="topic-list" aria-label="Repository topics">
                    {project.topics.map(topic => (
                      <Badge variant="outline">{topic}</Badge>
                    ))}
                  </div>
                )
              }
            </Card>
          </div>
        </Tabs>
      </main>

      <footer class="app-footer">
        <span>{project.name} analytics</span>
        <span>Generated {formatDate(dashboard.generatedAt)}</span>
      </footer>
    </div>
  </div>
</AppLayout>
