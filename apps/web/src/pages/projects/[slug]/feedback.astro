---
import AppHeader from '@/components/AppHeader.astro'
import AppSidebar from '@/components/AppSidebar.astro'
import AppLayout from '@/layouts/AppLayout.astro'

import {
  getAdminFeedback,
  getBrowserApiUrl,
  getProjectSettings
} from '@/lib/api'
import { formatRelativeDate } from '@/lib/format'

import {
  Alert,
  AlertDialog,
  Badge,
  Button,
  ButtonLink,
  Card,
  Empty,
  Field,
  FilterBar,
  Icon,
  Label,
  Link,
  NativeSelect,
  ScrollReveal,
  SearchField,
  VisuallyHidden
} from '@santi020k/lumen-astro'

const slug = Astro.params.slug

if (!slug) return Astro.redirect('/feedback/')

const [feedbackResponse, settingsResponse] = await Promise.all([
  getAdminFeedback(Astro.request, Astro.url, slug),
  getProjectSettings(Astro.request, Astro.url)
])

if (
  feedbackResponse.status === 401 ||
  settingsResponse.status === 401
) return Astro.redirect('/login/')

if (feedbackResponse.status === 404) return Astro.redirect('/404/')

if (
  !feedbackResponse.ok || !feedbackResponse.parsed ||
  !settingsResponse.ok || !settingsResponse.parsed
) throw new Error('Observatory feedback is unavailable.')

const { items, project } = feedbackResponse.parsed.data

if (!project) throw new Error('Feedback project metadata is unavailable.')

const settings = settingsResponse.parsed
const apiUrl = getBrowserApiUrl()

const statuses = [
  { label: 'Inbox', value: 'inbox' },
  { label: 'Under review', value: 'under_review' },
  { label: 'Planned', value: 'planned' },
  { label: 'In progress', value: 'in_progress' },
  { label: 'Released', value: 'shipped' },
  { label: 'Closed', value: 'closed' }
]

const moderationOptions = [
  { label: 'Pending', value: 'pending' },
  { label: 'Approved', value: 'approved' },
  { label: 'Rejected', value: 'rejected' }
]
---

<AppLayout
  description={`Private ${project.displayName} feedback moderation board.`}
  title={`${project.displayName} feedback · Observatory`}
>
  <div class="app-shell">
    <AppSidebar projects={settings.projects.filter(candidate => candidate.enabled)} />
    <div class="app-workspace">
      <AppHeader
        apiUrl={apiUrl}
        lastSync={settings.sync.completedAt ?
          formatRelativeDate(settings.sync.completedAt) :
          'awaiting first sync'}
        syncStatus={settings.sync.status}
      />

      <main
        class="dashboard feedback-dashboard"
        data-feedback-api={apiUrl}
        data-feedback-project={project.slug}
        id="main-content"
      >
        <ScrollReveal
          as="section"
          animation="fade"
          duration="fast"
          threshold={0}
          class="hero-row feedback-board-hero"
          aria-labelledby="board-title"
        >
          <div>
            <ButtonLink href="/feedback/" variant="ghost">
              <Icon aria-hidden="true" name="arrow-left" />
              All feedback
            </ButtonLink>
            <span class="eyebrow">{project.displayName} · Feedback</span>
            <h1 id="board-title">Delivery board</h1>
            <p>Moderate incoming ideas and private reports, then manage accepted work.</p>
          </div>
          <Badge variant="outline" data-board-total>{items.length} items</Badge>
        </ScrollReveal>

        <FilterBar
          class="feedback-filter-bar"
          data-feedback-filters
          label="Find feedback"
          resultLabel={`${items.length} items`}
        >
          <div class="feedback-toolbar">
            <SearchField
              aria-label="Search feedback"
              data-feedback-search
              placeholder="Search title, details, or email"
            />
            <NativeSelect
              aria-label="Filter by feedback type"
              data-feedback-type-filter
              options={[
                { label: 'All feedback', value: '' },
                { label: 'Ideas', value: 'idea' },
                { label: 'Bugs', value: 'bug' },
                { label: 'Messages', value: 'message' }
              ]}
              value=""
            />
            <NativeSelect
              aria-label="Filter by moderation status"
              data-feedback-moderation-filter
              options={[
                { label: 'All moderation states', value: '' },
                ...moderationOptions
              ]}
              value=""
            />
          </div>
        </FilterBar>

        <Alert
          aria-live="polite"
          class="feedback-board-alert"
          data-feedback-alert
          hidden
          tabindex="-1"
        />

        <VisuallyHidden id="feedback-board-instructions">
          Move controls support Left and Right Arrow keys. Every card also has a status selector.
        </VisuallyHidden>

        <div
          aria-describedby="feedback-board-instructions"
          aria-label={`${project.displayName} feedback kanban`}
          class="feedback-kanban"
          data-feedback-board
          tabindex="0"
        >
          {statuses.map(status => {
            const columnItems = items.filter(item => item.status === status.value)

            return (
              <section
                class="feedback-kanban-column"
                data-feedback-column={status.value}
                aria-labelledby={`column-${status.value}`}
              >
                <header>
                  <h2 id={`column-${status.value}`}>{status.label}</h2>
                  <Badge variant="outline" data-column-count>{columnItems.length}</Badge>
                </header>
                <div class="feedback-kanban-items" data-column-items>
                  {columnItems.map(item => (
                    <Card
                      as="article"
                      class="feedback-admin-card"
                      data-description={item.description}
                      data-email={item.email ?? ''}
                      data-feedback-item={item.id}
                      data-moderation={item.moderationStatus}
                      data-status={item.status}
                      data-title={item.title}
                      data-type={item.type}
                    >
                      <div class="feedback-admin-card__badges">
                        <div>
                          <Badge variant="outline">{item.type}</Badge>
                          <Badge
                            data-item-moderation-badge
                            variant={item.moderationStatus === 'pending' ? 'warning' : 'secondary'}
                          >
                            {item.moderationStatus}
                          </Badge>
                        </div>
                        <Button
                          aria-keyshortcuts="ArrowLeft ArrowRight"
                          aria-label={`Move ${item.title}. Use Left or Right Arrow, or drag to another column.`}
                          data-feedback-drag-handle
                          draggable="true"
                          size="sm"
                          variant="ghost"
                        >
                          <Icon aria-hidden="true" name="grip-vertical" />
                          Move
                        </Button>
                      </div>
                      <h3>{item.title}</h3>
                      <p>{item.description}</p>
                      <small>
                        {item.source} · {item.locale} · {new Date(item.createdAt).toLocaleDateString('en')}
                      </small>
                      {item.email && <Link href={`mailto:${item.email}`}>{item.email}</Link>}
                      {item.diagnosticReport && (
                        <details>
                          <summary>Diagnostic report</summary>
                          <pre>{item.diagnosticReport}</pre>
                        </details>
                      )}
                      <Field controlId={`feedback-status-${item.id}`}>
                        <Label for={`feedback-status-${item.id}`}>Status</Label>
                        <NativeSelect
                          data-item-status
                          id={`feedback-status-${item.id}`}
                          options={statuses}
                          value={item.status}
                        />
                      </Field>
                      <Field controlId={`feedback-moderation-${item.id}`}>
                        <Label for={`feedback-moderation-${item.id}`}>Moderation</Label>
                        <NativeSelect
                          data-item-moderation
                          id={`feedback-moderation-${item.id}`}
                          options={moderationOptions}
                          value={item.moderationStatus}
                        />
                      </Field>
                      <div class="feedback-admin-card__actions">
                        <Button data-item-visibility size="sm" variant="outline">
                          {item.isPublic ? 'Make private' : 'Make public'}
                        </Button>
                        <Button data-item-delete size="sm" variant="destructive">
                          Delete
                        </Button>
                      </div>
                    </Card>
                  ))}
                  <Empty
                    class="feedback-kanban-empty"
                    data-column-empty
                    hidden={columnItems.length > 0}
                  >
                    <p>No feedback in this column.</p>
                  </Empty>
                </div>
              </section>
            )
          })}
        </div>
      </main>

      <AlertDialog
        aria-describedby="delete-feedback-description"
        aria-labelledby="delete-feedback-title"
        id="delete-feedback-dialog"
      >
        <Card class="feedback-delete-dialog-card">
          <div class="feedback-project-card__icon">
            <Icon aria-hidden="true" name="trash-2" />
          </div>
          <h2 id="delete-feedback-title">Delete feedback permanently?</h2>
          <p id="delete-feedback-description">
            This removes the report and its votes. This action cannot be undone.
          </p>
          <div class="feedback-admin-card__actions">
            <Button data-ui-alert-dialog-close variant="outline">Cancel</Button>
            <Button data-feedback-delete-confirm variant="destructive">
              Delete permanently
            </Button>
          </div>
        </Card>
      </AlertDialog>
    </div>
  </div>
</AppLayout>

<script>
import { initializeFeedbackBoard } from '@/scripts/feedback-board'

initializeFeedbackBoard()
</script>
