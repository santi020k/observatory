---
import Brand from '@/components/Brand.astro'
import AppLayout from '@/layouts/AppLayout.astro'

import { getBrowserApiUrl } from '@/lib/api'

import Alert from '@santi020k/lumen-astro/components/Alert'
import Button from '@santi020k/lumen-astro/components/Button'
import Card from '@santi020k/lumen-astro/components/Card'
import Field from '@santi020k/lumen-astro/components/Field'
import Icon from '@santi020k/lumen-astro/components/Icon'
import Input from '@santi020k/lumen-astro/components/Input'
import Label from '@santi020k/lumen-astro/components/Label'
import ThemeToggle from '@santi020k/lumen-astro/components/ThemeToggle'

const apiUrl = getBrowserApiUrl()
---

<AppLayout
  description="Private sign in for Santiago's project analytics dashboard."
  title="Sign in · Observatory"
>
  <ThemeToggle class="auth-theme-toggle" title="Toggle color theme" />
  <main class="auth-shell" id="main-content">
    <section class="auth-story" aria-labelledby="auth-story-title">
      <Brand />
      <div>
        <span class="eyebrow">One view. Every signal.</span>
        <h1 id="auth-story-title">Your projects, under one sky.</h1>
        <p>
          Track product reach, release momentum, maintenance load, and
          deployment health without opening ten different dashboards.
        </p>
      </div>
      <ul class="auth-signals" aria-label="Available analytics">
        <li><Icon aria-hidden="true" name="git-fork" /> Repository momentum</li>
        <li><Icon aria-hidden="true" name="package" /> Package downloads</li>
        <li><Icon aria-hidden="true" name="activity" /> Website health</li>
      </ul>
    </section>

    <section class="auth-panel" aria-labelledby="sign-in-title">
      <Card class="auth-card">
        <span class="auth-card__icon">
          <Icon aria-hidden="true" name="fingerprint" />
        </span>
        <span class="eyebrow">Private access</span>
        <h2 id="sign-in-title">Sign in to Observatory</h2>
        <p data-auth-description>
          Use Face ID, Touch ID, Windows Hello, or your device lock.
        </p>

        <Alert
          aria-atomic="true"
          aria-live="assertive"
          data-form-alert
          hidden
          role="alert"
          variant="destructive"
        />

        <div class="passkey-login-actions" data-api-url={apiUrl}>
          <Button data-passkey-login size="lg" type="button">
            <Icon aria-hidden="true" name="fingerprint" />
            <span data-passkey-label>Continue with a passkey</span>
            <Icon aria-hidden="true" name="arrow-right" />
          </Button>
          <Button data-show-recovery type="button" variant="ghost">
            <Icon aria-hidden="true" name="key-round" />
            Use recovery code
          </Button>
        </div>

        <form data-recovery-form data-ui-form hidden>
          <Field>
            <Label for="passcode">Recovery code</Label>
            <Input
              autocomplete="current-password"
              id="passcode"
              minlength="8"
              name="passcode"
              required
              size="lg"
              type="password"
            />
          </Field>
          <Button size="lg" type="submit">
            <span data-recovery-label>Open Observatory</span>
            <Icon aria-hidden="true" name="arrow-right" />
          </Button>
          <Button data-hide-recovery type="button" variant="ghost">
            Back to passkey
          </Button>
        </form>
        <p class="auth-note">
          <Icon aria-hidden="true" name="shield" /> Owner-only access. Passkeys
          stay on your devices.
        </p>
      </Card>
    </section>
  </main>

  <script>
  import {
    authenticateWithPasskey,
    supportsPasskeys
  } from '@/lib/passkeys'

  const actions = document.querySelector<HTMLElement>('.passkey-login-actions')

  const passkeyButton = document.querySelector<HTMLButtonElement>(
    '[data-passkey-login]'
  )

  const passkeyLabel = document.querySelector<HTMLElement>('[data-passkey-label]')

  const showRecovery = document.querySelector<HTMLButtonElement>(
    '[data-show-recovery]'
  )

  const hideRecovery = document.querySelector<HTMLButtonElement>(
    '[data-hide-recovery]'
  )

  const recoveryForm = document.querySelector<HTMLFormElement>(
    '[data-recovery-form]'
  )

  const alert = document.querySelector<HTMLElement>('[data-form-alert]')
  const apiUrl = actions?.dataset.apiUrl ?? '/api'

  const displayError = (error: unknown, fallback: string) => {
    if (!alert) return

    alert.hidden = false

    alert.textContent = error instanceof Error ? error.message : fallback
  }

  const toggleRecovery = (visible: boolean) => {
    actions?.toggleAttribute('hidden', visible)

    if (recoveryForm) recoveryForm.hidden = !visible

    if (visible) recoveryForm?.querySelector<HTMLInputElement>('input')?.focus()
    else passkeyButton?.focus()
  }

  if (!supportsPasskeys()) toggleRecovery(true)

  showRecovery?.addEventListener('click', () => toggleRecovery(true))

  hideRecovery?.addEventListener('click', () => toggleRecovery(false))

  passkeyButton?.addEventListener('click', async () => {
    passkeyButton.disabled = true

    if (passkeyLabel) passkeyLabel.textContent = 'Checking your passkey…'

    if (alert) alert.hidden = true

    try {
      await authenticateWithPasskey(apiUrl)

      window.location.assign('/dashboard/')
    } catch (error) {
      displayError(error, 'The passkey could not be verified.')

      passkeyButton.disabled = false

      if (passkeyLabel) passkeyLabel.textContent = 'Continue with a passkey'
    }
  })

  const setRecoverySubmitting = (
    button: HTMLButtonElement | null,
    label: HTMLElement | null,
    submitting: boolean
  ) => {
    if (button) button.disabled = submitting

    if (label) label.textContent = submitting ? 'Verifying…' : 'Open Observatory'
  }

  recoveryForm?.addEventListener('submit', async event => {
    event.preventDefault()

    const button = recoveryForm.querySelector<HTMLButtonElement>(
      'button[type="submit"]'
    )

    const label = recoveryForm.querySelector<HTMLElement>(
      '[data-recovery-label]'
    )

    const passcode = String(new FormData(recoveryForm).get('passcode') ?? '')

    setRecoverySubmitting(button, label, true)

    if (alert) alert.hidden = true

    try {
      const response = await fetch(`${apiUrl}/auth/recovery`, {
        body: JSON.stringify({ passcode }),
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        method: 'POST'
      })

      const result = await response.json()

      if (!response.ok) {
        throw new Error(result.error?.message ?? 'The recovery code is invalid.')
      }

      recoveryForm.reset()

      window.location.assign('/dashboard/')
    } catch (error) {
      displayError(error, 'The recovery code could not be verified.')

      setRecoverySubmitting(button, label, false)
    }
  })
  </script>
</AppLayout>
