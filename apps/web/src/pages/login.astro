---
import Brand from '@/components/Brand.astro'
import AppLayout from '@/layouts/AppLayout.astro'

import { getBrowserApiUrl } from '@/lib/api'

import Alert from '@santi020k/lumen-astro/components/Alert'
import Button from '@santi020k/lumen-astro/components/Button'
import Card from '@santi020k/lumen-astro/components/Card'
import Field from '@santi020k/lumen-astro/components/Field'
import Icon from '@santi020k/lumen-astro/components/Icon'
import Input from '@santi020k/lumen-astro/components/Input'
import Label from '@santi020k/lumen-astro/components/Label'
import ThemeToggle from '@santi020k/lumen-astro/components/ThemeToggle'

const apiUrl = getBrowserApiUrl()
---

<AppLayout
  description="Private sign in for Santiago's project analytics dashboard."
  title="Sign in · Observatory"
>
  <ThemeToggle class="auth-theme-toggle" title="Toggle color theme" />
  <main class="auth-shell" id="main-content">
    <section class="auth-story" aria-labelledby="auth-story-title">
      <Brand />
      <div>
        <span class="eyebrow">One view. Every signal.</span>
        <h1 id="auth-story-title">Your projects, under one sky.</h1>
        <p>
          Track product reach, release momentum, maintenance load, and
          deployment health without opening ten different dashboards.
        </p>
      </div>
      <ul class="auth-signals" aria-label="Available analytics">
        <li><Icon aria-hidden="true" name="git-fork" /> Repository momentum</li>
        <li><Icon aria-hidden="true" name="package" /> Package downloads</li>
        <li><Icon aria-hidden="true" name="activity" /> Website health</li>
      </ul>
    </section>

    <section class="auth-panel" aria-labelledby="sign-in-title">
      <Card class="auth-card">
        <span class="auth-card__icon">
          <Icon aria-hidden="true" name="mail" />
        </span>
        <span class="eyebrow">Private access</span>
        <h2 id="sign-in-title">Sign in to Observatory</h2>
        <p data-auth-description>
          Enter your authorized email. We’ll send a six-digit code that expires
          in ten minutes.
        </p>

        <Alert
          aria-atomic="true"
          aria-live="assertive"
          data-form-alert
          hidden
          role="alert"
          variant="destructive"
        />

        <form data-api-url={apiUrl} data-login-form data-ui-form>
          <Field>
            <Label for="email">Email address</Label>
            <Input
              autocomplete="email"
              id="email"
              inputmode="email"
              name="email"
              placeholder="you@example.com"
              required
              size="lg"
              type="email"
            />
          </Field>
          <Button size="lg" type="submit">
            <span data-submit-label>Send verification code</span>
            <Icon aria-hidden="true" name="arrow-right" />
          </Button>
        </form>

        <div class="auth-options-divider" data-auth-options-divider>
          <span>or use another secure method</span>
        </div>

        <div class="passkey-login-actions" data-auth-options>
          <Button data-passkey-login type="button" variant="ghost">
            <Icon aria-hidden="true" name="fingerprint" />
            <span data-passkey-label>Continue with a passkey</span>
          </Button>
          <Button data-show-recovery type="button" variant="ghost">
            <Icon aria-hidden="true" name="key-round" />
            Use recovery code
          </Button>
        </div>

        <form data-recovery-form data-ui-form hidden>
          <Field>
            <Label for="passcode">Recovery code</Label>
            <Input
              autocomplete="current-password"
              id="passcode"
              minlength="8"
              name="passcode"
              required
              size="lg"
              type="password"
            />
          </Field>
          <Button size="lg" type="submit">
            <span data-recovery-label>Open Observatory</span>
            <Icon aria-hidden="true" name="arrow-right" />
          </Button>
          <Button data-hide-recovery type="button" variant="ghost">
            Back to sign in
          </Button>
        </form>
        <p class="auth-note">
          <Icon aria-hidden="true" name="shield" /> No password stored. This
          device stays signed in for up to 30 days.
        </p>
      </Card>
    </section>
  </main>

  <script>
  import {
    authenticateWithPasskey,
    supportsPasskeys
  } from '@/lib/passkeys'

  const loginForm = document.querySelector<HTMLFormElement>('[data-login-form]')
  const authOptions = document.querySelector<HTMLElement>('[data-auth-options]')

  const authOptionsDivider = document.querySelector<HTMLElement>(
    '[data-auth-options-divider]'
  )

  const passkeyButton = document.querySelector<HTMLButtonElement>(
    '[data-passkey-login]'
  )

  const passkeyLabel = document.querySelector<HTMLElement>('[data-passkey-label]')

  const showRecovery = document.querySelector<HTMLButtonElement>(
    '[data-show-recovery]'
  )

  const hideRecovery = document.querySelector<HTMLButtonElement>(
    '[data-hide-recovery]'
  )

  const recoveryForm = document.querySelector<HTMLFormElement>(
    '[data-recovery-form]'
  )

  const alert = document.querySelector<HTMLElement>('[data-form-alert]')
  const apiUrl = loginForm?.dataset.apiUrl ?? '/api'
  const isRecord = (value: unknown): value is Record<string, unknown> => typeof value === 'object' && value !== null

  const readString = (value: unknown, key: string): string | undefined => {
    if (!isRecord(value)) return undefined

    const field = value[key]

    return typeof field === 'string' ? field : undefined
  }

  const readErrorMessage = (value: unknown): string | undefined => {
    if (!isRecord(value)) return undefined

    return readString(value.error, 'message')
  }

  const displayError = (error: unknown, fallback: string) => {
    if (!alert) return

    alert.hidden = false

    alert.textContent = error instanceof Error ? error.message : fallback
  }

  const toggleRecovery = (visible: boolean) => {
    loginForm?.toggleAttribute('hidden', visible)

    authOptions?.toggleAttribute('hidden', visible)

    authOptionsDivider?.toggleAttribute('hidden', visible)

    if (recoveryForm) recoveryForm.hidden = !visible

    if (visible) recoveryForm?.querySelector<HTMLInputElement>('input')?.focus()
    else loginForm?.querySelector<HTMLInputElement>('input')?.focus()
  }

  if (!supportsPasskeys()) passkeyButton?.setAttribute('hidden', '')

  showRecovery?.addEventListener('click', () => toggleRecovery(true))

  hideRecovery?.addEventListener('click', () => toggleRecovery(false))

  const setSubmitting = (
    button: HTMLButtonElement | null,
    label: HTMLElement | null | undefined,
    submitting: boolean,
    idleLabel: string,
    submittingLabel: string
  ) => {
    if (button) {
      button.disabled = submitting

      button.toggleAttribute('aria-busy', submitting)
    }

    if (label) label.textContent = submitting ? submittingLabel : idleLabel
  }

  loginForm?.addEventListener('submit', async event => {
    event.preventDefault()

    const button = loginForm.querySelector<HTMLButtonElement>(
      'button[type="submit"]'
    )

    const label = loginForm.querySelector<HTMLElement>('[data-submit-label]')
    const email = String(new FormData(loginForm).get('email') ?? '').trim()

    setSubmitting(
      button, label, true, 'Send verification code', 'Sending code…'
    )

    if (alert) alert.hidden = true

    try {
      const response = await fetch(`${apiUrl}/auth/request-code`, {
        body: JSON.stringify({ email }),
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        method: 'POST'
      })

      const result: unknown = await response.json()

      if (!response.ok) {
        throw new Error(readErrorMessage(result) ?? 'Could not send the code.')
      }

      const developmentCode = readString(result, 'developmentCode')

      sessionStorage.setItem('observatory:pending-login-email', email)

      if (developmentCode)
        sessionStorage.setItem(
          'observatory:pending-login-development-code', developmentCode
        )
      else
        sessionStorage.removeItem(
          'observatory:pending-login-development-code'
        )

      window.location.assign('/verify/')
    } catch (error) {
      displayError(error, 'Could not send the code.')

      setSubmitting(
        button, label, false, 'Send verification code', 'Sending code…'
      )
    }
  })

  passkeyButton?.addEventListener('click', async () => {
    passkeyButton.disabled = true

    if (passkeyLabel) passkeyLabel.textContent = 'Checking your passkey…'

    if (alert) alert.hidden = true

    try {
      await authenticateWithPasskey(apiUrl)

      window.location.assign('/dashboard/')
    } catch (error) {
      displayError(error, 'The passkey could not be verified.')

      passkeyButton.disabled = false

      if (passkeyLabel) passkeyLabel.textContent = 'Continue with a passkey'
    }
  })

  recoveryForm?.addEventListener('submit', async event => {
    event.preventDefault()

    const button = recoveryForm.querySelector<HTMLButtonElement>(
      'button[type="submit"]'
    )

    const label = recoveryForm.querySelector<HTMLElement>(
      '[data-recovery-label]'
    )

    const passcode = String(new FormData(recoveryForm).get('passcode') ?? '')

    setSubmitting(button, label, true, 'Open Observatory', 'Verifying…')

    if (alert) alert.hidden = true

    try {
      const response = await fetch(`${apiUrl}/auth/recovery`, {
        body: JSON.stringify({ passcode }),
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        method: 'POST'
      })

      const result: unknown = await response.json()

      if (!response.ok) {
        throw new Error(
          readErrorMessage(result) ?? 'The recovery code is invalid.'
        )
      }

      recoveryForm.reset()

      window.location.assign('/dashboard/')
    } catch (error) {
      displayError(error, 'The recovery code could not be verified.')

      setSubmitting(button, label, false, 'Open Observatory', 'Verifying…')
    }
  })
  </script>
</AppLayout>
