---
import Brand from '@/components/Brand.astro'
import AppLayout from '@/layouts/AppLayout.astro'

import Alert from '@santi020k/lumen-astro/components/Alert'
import Button from '@santi020k/lumen-astro/components/Button'
import ButtonLink from '@santi020k/lumen-astro/components/ButtonLink'
import Card from '@santi020k/lumen-astro/components/Card'
import Field from '@santi020k/lumen-astro/components/Field'
import Icon from '@santi020k/lumen-astro/components/Icon'
import Input from '@santi020k/lumen-astro/components/Input'
import Label from '@santi020k/lumen-astro/components/Label'
import ThemeToggle from '@santi020k/lumen-astro/components/ThemeToggle'

if (import.meta.env.PUBLIC_AUTH_PILOT_ENABLED !== 'true')
  return Astro.redirect('/login/')
---

<AppLayout
  description="Private sign in for Santiago's project analytics dashboard."
  title="Sign in · Observatory"
>
  <ThemeToggle class="auth-theme-toggle" title="Toggle color theme" />
  <main class="auth-shell" id="main-content">
    <section class="auth-story" aria-labelledby="auth-story-title">
      <Brand />
      <div>
        <span class="eyebrow">One view. Every signal.</span>
        <h1 id="auth-story-title">Your projects, under one sky.</h1>
        <p>
          Track product reach, release momentum, maintenance load, and
          deployment health without opening ten different dashboards.
        </p>
      </div>
      <ul class="auth-signals" aria-label="Available analytics">
        <li><Icon aria-hidden="true" name="git-fork" /> Repository momentum</li>
        <li><Icon aria-hidden="true" name="package" /> Package downloads</li>
        <li><Icon aria-hidden="true" name="activity" /> Website health</li>
      </ul>
    </section>

    <section class="auth-panel" aria-label="Observatory authentication">
      <div class="auth-panel-stack">
        <Card class="auth-card" data-login-card>
          <span class="auth-card__icon"><Icon aria-hidden="true" name="mail" /></span
          >
          <span class="eyebrow">Private access</span>
          <h2 id="sign-in-title">Sign in to Observatory</h2>
          <p>
            Enter your authorized email. We’ll send a six-digit code that
            expires in ten minutes.
          </p>

          <Alert
            aria-atomic="true"
            aria-live="polite"
            class="auth-status"
            data-pilot-status
            hidden
            role="status"
            variant="default"
          />

          <form data-email-form data-ui-form>
            <Field>
              <Label for="pilot-email">Email address</Label>
              <Input
                autocomplete="email"
                id="pilot-email"
                inputmode="email"
                name="email"
                required
                type="email"
              />
            </Field>
            <Button size="lg" type="submit">
              <span>Send verification code</span>
              <Icon aria-hidden="true" name="arrow-right" />
            </Button>
          </form>

          <form data-code-form data-ui-form hidden>
            <Field>
              <Label for="pilot-code">Six-digit code</Label>
              <Input
                autocomplete="one-time-code"
                id="pilot-code"
                inputmode="numeric"
                maxlength="6"
                minlength="6"
                name="code"
                pattern="[0-9]{6}"
                required
              />
            </Field>
            <Button size="lg" type="submit">
              <span>Open Observatory</span>
              <Icon aria-hidden="true" name="arrow-right" />
            </Button>
          </form>

          <div class="auth-pilot-actions">
            <Button data-passkey-sign-in type="button" variant="secondary">
              <Icon aria-hidden="true" name="fingerprint" />
              Continue with a passkey
            </Button>
            <ButtonLink href="/login/" variant="inline">
              Use recovery code
            </ButtonLink>
          </div>
          <p class="auth-note">
            <Icon aria-hidden="true" name="shield" /> No password stored. This device
            stays signed in for up to 30 days.
          </p>
        </Card>

        <Card class="auth-card" data-session-card hidden>
          <span class="auth-card__icon"><Icon aria-hidden="true" name="shield-check" /></span
          >
          <span class="eyebrow">Private access</span>
          <h2 data-session-title tabindex="-1">You’re signed in</h2>
          <p>
            Signed in as <strong data-session-email></strong>. You can continue
            to the dashboard or manage this device.
          </p>
          <Alert
            aria-atomic="true"
            aria-live="polite"
            class="auth-status"
            data-pilot-status
            hidden
            role="status"
            variant="default"
          />
          <Field>
            <Label for="pilot-passkey-name">Passkey name</Label>
            <Input
              id="pilot-passkey-name"
              maxlength="64"
              name="passkeyName"
              placeholder="This device"
            />
          </Field>
          <div class="auth-pilot-actions">
            <Button data-add-passkey type="button">
              <Icon aria-hidden="true" name="fingerprint" />
              Create a passkey
            </Button>
            <Button data-revoke-others type="button" variant="secondary">
              Sign out other devices
            </Button>
            <ButtonLink href="/dashboard/" variant="secondary">
              Open dashboard
            </ButtonLink>
            <Button data-sign-out type="button" variant="ghost">
              Sign out
            </Button>
          </div>
        </Card>
      </div>
    </section>
  </main>

  <script>
    import { createSantiAuthHelpers } from '@santi020k/auth-client'

    const auth = createSantiAuthHelpers({
      baseURL: window.location.origin,
      basePath: '/api/auth-v2'
})

    const statuses = document.querySelectorAll<HTMLElement>(
      '[data-pilot-status]'
)

    const emailForm =
      document.querySelector<HTMLFormElement>('[data-email-form]')

    const codeForm = document.querySelector<HTMLFormElement>('[data-code-form]')
    const loginCard = document.querySelector<HTMLElement>('[data-login-card]')
    const emailInput = emailForm?.querySelector<HTMLInputElement>('input')

    const sessionCard = document.querySelector<HTMLElement>(
      '[data-session-card]'
)

    const sessionEmail = document.querySelector<HTMLElement>(
      '[data-session-email]'
)

    const sessionTitle = document.querySelector<HTMLElement>(
      '[data-session-title]'
)

    const passkeySignIn = document.querySelector<HTMLButtonElement>(
      '[data-passkey-sign-in]'
)

    const addPasskey =
      document.querySelector<HTMLButtonElement>('[data-add-passkey]')

    const revokeOthers = document.querySelector<HTMLButtonElement>(
      '[data-revoke-others]'
)

    const signOut = document.querySelector<HTMLButtonElement>('[data-sign-out]')

    const passkeyName = document.querySelector<HTMLInputElement>(
      '#pilot-passkey-name'
)

    let pendingEmail = ''

    const setStatus = (message: string, destructive = false) => {
      for (const status of statuses) {
        status.textContent = message

        status.hidden = false

        status.dataset.variant = destructive ? 'destructive' : 'default'

        status.classList.toggle('ui-alert--destructive', destructive)

        status.setAttribute('role', destructive ? 'alert' : 'status')

        status.setAttribute('aria-live', destructive ? 'assertive' : 'polite')
      }
    }

    const requireSuccess = (
      result: { error: { message: string } | null },
      fallback: string
): void => {
      if (result.error) throw new Error(result.error.message ?? fallback)
    }

    const setButtonBusy = (button: HTMLButtonElement | null, busy: boolean) => {
      if (!button) return

      button.disabled = busy

      button.toggleAttribute('aria-busy', busy)
    }

    const resetLoginFlow = (): void => {
      emailForm?.reset()

      codeForm?.reset()

      codeForm?.setAttribute('hidden', '')

      pendingEmail = ''
    }

    const refreshSession = async (): Promise<void> => {
      const result = await auth.getSession()

      requireSuccess(result, 'Could not check your session.')

      const email = result.data?.email
      const authenticated = typeof email === 'string'

      if (loginCard) loginCard.hidden = authenticated

      if (sessionCard) sessionCard.hidden = !authenticated

      if (sessionEmail) sessionEmail.textContent = email ?? ''

      if (authenticated) setStatus('Signed in securely.')
      else for (const status of statuses) status.hidden = true
    }

    emailForm?.addEventListener('submit', async event => {
      event.preventDefault()

      const button = emailForm.querySelector<HTMLButtonElement>('button')
      const email = String(new FormData(emailForm).get('email') ?? '').trim()

      setButtonBusy(button, true)

      try {
        const result = await auth.requestEmailOtp(email)

        requireSuccess(result, 'Could not request a verification code.')

        pendingEmail = email

        if (codeForm) codeForm.hidden = false

        codeForm?.querySelector<HTMLInputElement>('input')?.focus()

        setStatus(
          'If this address is authorized, a verification code is on its way.'
    )
      } catch (error) {
        setStatus(
          error instanceof Error ?
        error.message :
        'Could not request a verification code.',
          true
    )
      } finally {
        setButtonBusy(button, false)
      }
    })

    codeForm?.addEventListener('submit', async event => {
      event.preventDefault()

      const button = codeForm.querySelector<HTMLButtonElement>('button')
      const otp = String(new FormData(codeForm).get('code') ?? '')

      setButtonBusy(button, true)

      try {
        const result = await auth.signInWithEmailOtp(pendingEmail, otp)

        requireSuccess(result, 'The verification code is invalid or expired.')

        codeForm.reset()

        codeForm.hidden = true

        await refreshSession()

        resetLoginFlow()

        sessionTitle?.focus()
      } catch (error) {
        setStatus(
          error instanceof Error ? error.message : 'Could not verify the code.',
          true
    )
      } finally {
        setButtonBusy(button, false)
      }
    })

    passkeySignIn?.addEventListener('click', async () => {
      setButtonBusy(passkeySignIn, true)

      try {
        const result = await auth.signInWithPasskey()

        requireSuccess(result, 'The passkey could not be verified.')

        await refreshSession()

        resetLoginFlow()

        sessionTitle?.focus()
      } catch (error) {
        setStatus(
          error instanceof Error ?
        error.message :
        'Could not verify the passkey.',
          true
    )
      } finally {
        setButtonBusy(passkeySignIn, false)
      }
    })

    addPasskey?.addEventListener('click', async () => {
      setButtonBusy(addPasskey, true)

      try {
        const name = passkeyName?.value.trim() || 'Observatory device'
        const result = await auth.addPasskey({ name })

        requireSuccess(result, 'The passkey could not be created.')

        if (passkeyName) passkeyName.value = ''

        setStatus('Passkey created for this device.')
      } catch (error) {
        setStatus(
          error instanceof Error ?
        error.message :
        'Could not create the passkey.',
          true
    )
      } finally {
        setButtonBusy(addPasskey, false)
      }
    })

    revokeOthers?.addEventListener('click', async () => {
      setButtonBusy(revokeOthers, true)

      try {
        const result = await auth.revokeOtherSessions()

        requireSuccess(result, 'Other devices could not be signed out.')

        setStatus('Other devices were signed out. This session remains active.')
      } catch (error) {
        setStatus(
          error instanceof Error ?
        error.message :
        'Could not sign out other devices.',
          true
    )
      } finally {
        setButtonBusy(revokeOthers, false)
      }
    })

    signOut?.addEventListener('click', async () => {
      setButtonBusy(signOut, true)

      try {
        const result = await auth.signOut()

        requireSuccess(result, 'You could not be signed out.')

        await refreshSession()

        resetLoginFlow()

        emailInput?.focus()
      } catch (error) {
        setStatus(
          error instanceof Error ? error.message : 'Could not sign out.',
          true
    )
      } finally {
        setButtonBusy(signOut, false)
      }
    })

    void refreshSession().catch(() => {
      setStatus(
        'We could not reach authentication. Try again in a moment.',
        true
  )
    })
</script>
</AppLayout>

<style>
  .auth-panel-stack {
    display: grid;
    gap: var(--space-4);
    width: min(100%, 29rem);
  }

  .auth-panel-stack > :global(.auth-card) {
    width: 100%;
  }

  .auth-status {
    margin-top: var(--space-5);
  }

  .auth-pilot-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .auth-pilot-actions > :global(.ui-button),
  .auth-pilot-actions > :global(.ui-button-link) {
    flex: 1 1 12rem;
  }

  @media (max-width: 38rem) {
    .auth-panel-stack {
      width: 100%;
    }

    .auth-pilot-actions {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }

    .auth-pilot-actions > :global(.ui-button),
    .auth-pilot-actions > :global(.ui-button-link) {
      width: 100%;
    }
  }
</style>
