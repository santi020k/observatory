---
import Brand from '@/components/Brand.astro'
import AppLayout from '@/layouts/AppLayout.astro'

import { getBrowserApiUrl } from '@/lib/api'

import Alert from '@santi020k/lumen-astro/components/Alert'
import Button from '@santi020k/lumen-astro/components/Button'
import ButtonLink from '@santi020k/lumen-astro/components/ButtonLink'
import Card from '@santi020k/lumen-astro/components/Card'
import Field from '@santi020k/lumen-astro/components/Field'
import Icon from '@santi020k/lumen-astro/components/Icon'
import InputOTP from '@santi020k/lumen-astro/components/InputOTP'
import Label from '@santi020k/lumen-astro/components/Label'
import ThemeToggle from '@santi020k/lumen-astro/components/ThemeToggle'

const apiUrl = getBrowserApiUrl()
---

<AppLayout
  description="Verify your Observatory login code."
  title="Verify · Observatory"
>
  <ThemeToggle class="auth-theme-toggle" title="Toggle color theme" />
  <main class="verify-shell" id="main-content">
    <Brand />
    <Card class="auth-card verify-card">
      <span class="auth-card__icon"><Icon aria-hidden="true" name="mail-check" />
      </span
      >
      <span class="eyebrow">Check your inbox</span>
      <h1>Enter your code</h1>
      <p>
        We sent a six-digit code to
        <strong data-masked-email>your authorized email</strong>. It expires in
        ten minutes.
      </p>

      <Alert data-development-code-alert hidden variant="default">
        Local development code: <strong data-development-code></strong>
      </Alert>
      <Alert
        aria-atomic="true"
        aria-live="assertive"
        data-form-alert
        hidden
        role="alert"
        variant="destructive"
      />

      <form
        data-api-url={apiUrl}
        data-ui-form
        data-verify-form
      >
        <Field>
          <Label for="code">Verification code</Label>
          <InputOTP id="code" name="code" length={6} required />
        </Field>
        <Button size="lg" type="submit">
          <span data-submit-label>Open Observatory</span>
          <Icon aria-hidden="true" name="arrow-right" />
        </Button>
      </form>
      <ButtonLink href="/login/" variant="inline">
        <Icon aria-hidden="true" name="arrow-left" />
        Use a different email
      </ButtonLink>
    </Card>
  </main>

  <script>
  const form = document.querySelector<HTMLFormElement>('[data-verify-form]')
  const alert = document.querySelector<HTMLElement>('[data-form-alert]')
  const apiUrl = form?.dataset.apiUrl ?? '/api'
  const emailStorageKey = 'observatory:pending-login-email'

  const developmentCodeStorageKey =
    'observatory:pending-login-development-code'

  const email = sessionStorage.getItem(emailStorageKey) ?? ''

  const maskEmail = (value: string): string => {
    const separatorIndex = value.lastIndexOf('@')

    if (separatorIndex <= 0) return value

    return `${value.slice(0, 1)}••${value.slice(separatorIndex)}`
  }

  if (!email) window.location.replace('/login/')

  const maskedEmail = document.querySelector<HTMLElement>(
    '[data-masked-email]'
  )

  if (maskedEmail && email) maskedEmail.textContent = maskEmail(email)

  if (import.meta.env.DEV) {
    const developmentCode = sessionStorage.getItem(
      developmentCodeStorageKey
    )

    const developmentCodeAlert = document.querySelector<HTMLElement>(
      '[data-development-code-alert]'
    )

    const developmentCodeValue = document.querySelector<HTMLElement>(
      '[data-development-code]'
    )

    if (developmentCode && developmentCodeAlert && developmentCodeValue) {
      developmentCodeValue.textContent = developmentCode

      developmentCodeAlert.hidden = false
    }
  }

  const isRecord = (value: unknown): value is Record<string, unknown> => typeof value === 'object' && value !== null

  const readErrorMessage = (value: unknown): string | undefined => {
    if (!isRecord(value) || !isRecord(value.error)) return undefined

    return typeof value.error.message === 'string' ?
      value.error.message :
      undefined
  }

  const setSubmitting = (
    button: HTMLButtonElement | null,
    buttonLabel: HTMLElement | null | undefined,
    submitting: boolean
  ) => {
    if (button) {
      button.disabled = submitting

      button.toggleAttribute('aria-busy', submitting)

      if (buttonLabel)
        buttonLabel.textContent =
          submitting ? 'Verifying…' : 'Open Observatory'
    }
  }

  const displayError = (error: unknown) => {
    if (!alert) return

    alert.hidden = false

    alert.textContent =
      error instanceof Error ?
        error.message :
        'The code could not be verified.'
  }

  const verifyCode = async (code: string) => {
    const response = await fetch(`${apiUrl}/auth/verify-code`, {
      body: JSON.stringify({ code, email }),
      credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
      method: 'POST'
    })

    const result: unknown = await response.json()

    if (!response.ok)
      throw new Error(
        readErrorMessage(result) ?? 'The code could not be verified.'
      )

    sessionStorage.removeItem(emailStorageKey)

    sessionStorage.removeItem(developmentCodeStorageKey)

    window.location.assign('/dashboard/')
  }

  form?.addEventListener('submit', async event => {
    event.preventDefault()

    const button = form.querySelector('button')

    const buttonLabel = button?.querySelector<HTMLElement>(
      '[data-submit-label]'
    )

    const formData = new FormData(form)
    const code = String(formData.get('code') ?? '')

    setSubmitting(button, buttonLabel, true)

    if (alert) alert.hidden = true

    try {
      await verifyCode(code)
    } catch (error) {
      displayError(error)

      setSubmitting(button, buttonLabel, false)
    }
  })
  </script>
</AppLayout>
