---
import AppHeader from '@/components/AppHeader.astro'
import AppSidebar from '@/components/AppSidebar.astro'
import RangePicker from '@/components/RangePicker.astro'
import AppLayout from '@/layouts/AppLayout.astro'

import { analyticsRangeMeta } from '@/lib/analytics-range'
import {
  getBrowserApiUrl,
  getProjectSettings,
  getStoreAnalytics
} from '@/lib/api'
import { formatDate, formatNumber, formatRelativeDate } from '@/lib/format'
import {
  metricLabels,
  primaryMetric,
  providerLabels,
  statusMeta
} from '@/lib/store-presentation'

import { Badge, ButtonLink, Card, Icon } from '@santi020k/lumen-astro'
import { analyticsRangeSchema } from '@santi020k/observatory-api-types'

const range = analyticsRangeSchema
  .catch('30d')
  .parse(Astro.url.searchParams.get('range'))

const [analyticsResponse, settingsResponse] = await Promise.all([
  getStoreAnalytics(range, Astro.request, Astro.url),
  getProjectSettings(Astro.request, Astro.url)
])

if (analyticsResponse.status === 401) return Astro.redirect('/login/')

if (
  !analyticsResponse.ok ||
  !analyticsResponse.parsed ||
  !settingsResponse.ok ||
  !settingsResponse.parsed
)
  throw new Error('Store analytics are unavailable.')

const analytics = analyticsResponse.parsed

const sidebarProjects = settingsResponse.parsed.projects.filter(
  project => project.enabled
)

const syncTimes = analytics.apps
  .flatMap(app => app.providers)
  .map(provider => provider.lastSyncAt)
  .filter((value): value is string => value !== null)
  .sort()

const latestStoreSync = syncTimes[syncTimes.length - 1]

const hasFailedSync = analytics.apps.some(app => app.providers.some(
  provider => provider.status === 'failed'
))

const syncStatus = hasFailedSync ? 'failed' : 'succeeded'

const appIcon = (slug: string): 'activity' | 'camera' | 'package' => {
  if (slug === 'lumen') return 'package'

  if (slug === 'postlens') return 'camera'

  return 'activity'
}

const reportingProviders = analytics.apps
  .flatMap(app => app.providers)
  .filter(provider => provider.status === 'available').length

const publishedListings = analytics.apps.reduce(
  (count, app) => count + app.providers.length,
  0
)
---

<AppLayout
  description="Privacy-safe store intelligence for published applications."
  title="Published apps · Observatory"
>
  <div class="app-shell">
    <AppSidebar projects={sidebarProjects} range={analytics.range} />
    <div class="app-workspace">
      <AppHeader
        apiUrl={getBrowserApiUrl()}
        lastSync={latestStoreSync ?
          formatRelativeDate(latestStoreSync) :
          'awaiting store setup'}
        syncPath="/sync/stores"
        syncStatus={latestStoreSync ? syncStatus : 'idle'}
        syncSubject="App Store and Google Play analytics data"
      />

      <main class="dashboard store-dashboard store-overview" id="main-content">
        <section class="hero-row" aria-labelledby="store-title">
          <div>
            <span class="eyebrow">Published apps</span><h1 id="store-title">
              Store intelligence
            </h1><p>
              See where each app is published, whether reporting is connected,
              and which provider has issued usable aggregate data.
            </p>
          </div>
          <div class="hero-controls">
            <RangePicker range={analytics.range} />
          </div>
        </section>

        <section class="store-summary" aria-label="Store coverage summary">
          <div>
            <strong>{analytics.apps.length}</strong><span>Published apps</span>
          </div>
          <div>
            <strong>{publishedListings}</strong><span>Live listings</span>
          </div>
          <div>
            <strong>{reportingProviders}</strong><span>Reporting now</span>
          </div>
        </section>

        <section class="store-app-grid" aria-label="Published applications">
          {
            analytics.apps.map(app => {
              const appPrimary = app.providers
                .map(provider => ({
                  metric: primaryMetric(provider.provider, provider.metrics),
                  provider
                }))
                .find(item => item.metric !== undefined)

              return (
                <Card as="article" class="store-app-card">
                  <div class="store-app-card__topline">
                    <>
                      <span class="store-app-card__icon">
                        <Icon
                          aria-hidden="true"
                          name={appIcon(app.slug)}
                        />
                      </span>
                      <Badge variant="outline">
                        {app.providers.length}{' '}
                        {app.providers.length === 1 ? 'store' : 'stores'}
                      </Badge>
                    </>
                  </div>
                  <div class="store-app-card__copy">
                    <>
                      <span class="eyebrow">Native application</span>
                      <h2>{app.displayName}</h2>
                      <p>
                        {analyticsRangeMeta[analytics.range].longLabel} of
                        provider-reported activity.
                      </p>
                    </>
                  </div>
                  {appPrimary?.metric ?
(
                    <div class="store-app-card__metric">
                      <strong>
                        {formatNumber(
                          appPrimary.provider.metrics[appPrimary.metric] ??
                          null
                        )}
                      </strong>
                      <span>
                        {metricLabels[appPrimary.metric]} ·{' '}
                        {providerLabels[appPrimary.provider.provider]}
                      </span>
                    </div>
                  ) :
(
                    <p class="store-app-card__pending">
                      No aggregate metrics have been issued yet.
                    </p>
                  )}
                  <div class="store-app-card__providers">
                    {app.providers.map(provider => (
                      <div>
                        <span>{providerLabels[provider.provider]}</span>
                        <Badge variant={statusMeta[provider.status].variant}>
                          {statusMeta[provider.status].label}
                        </Badge>
                      </div>
                    ))}
                  </div>
                  <ButtonLink
                    href={`/store/${app.slug}/?range=${analytics.range}`}
                    variant="secondary"
                  >
                    View app details{' '}
                    <Icon aria-hidden="true" name="arrow-right" />
                  </ButtonLink>
                </Card>
              )
            })
          }
        </section>

        <Card
as="section"
class="store-definition-note"
        ><span class="store-definition-note__icon"><Icon aria-hidden="true" name="shield-check" /></span
          ><div>
            <h2>Provider numbers stay comparable, not interchangeable</h2><p>
              Apple downloads and installations use different reporting
              populations from Google Play’s active install base. Observatory
              preserves those definitions and never fills withheld rows with
              zero.
            </p>
          </div></Card
        >
      </main>

      <footer class="app-footer">
        <span>Store analytics remain owner-only</span><span >Generated {formatDate(analytics.generatedAt)}</span>
      </footer>
    </div>
  </div>
</AppLayout>
