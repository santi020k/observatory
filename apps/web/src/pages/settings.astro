---
import AppHeader from '@/components/AppHeader.astro'
import AppLayout from '@/layouts/AppLayout.astro'
import { getBrowserApiUrl, getProjectSettings } from '@/lib/api'

import Badge from '@santi020k/lumen-astro/components/Badge'
import Card from '@santi020k/lumen-astro/components/Card'
import Empty from '@santi020k/lumen-astro/components/Empty'
import Icon from '@santi020k/lumen-astro/components/Icon'

const response = await getProjectSettings(Astro.request, Astro.url)

if (response.status === 401) return Astro.redirect('/login/')
if (!response.ok || !response.parsed)
  throw new Error('Observatory API is unavailable.')

const settings = response.parsed
const apiUrl = getBrowserApiUrl()
const enabledCount = settings.projects.filter(
  (project) => project.enabled,
).length
---

<AppLayout
  description="Control which projects Observatory includes in dashboards and analysis."
  title="Settings · Observatory"
>
  <div class="app-shell">
    <AppHeader
      apiUrl={apiUrl}
      lastSync="when the catalog was synced"
      syncStatus="succeeded"
    />

    <main class="dashboard settings-dashboard" id="main-content">
      <section class="hero-row" aria-labelledby="settings-title">
        <div>
          <span class="eyebrow">Workspace preferences</span>
          <h1 id="settings-title">Project visibility</h1>
          <p>
            Decide which projects contribute to your overview, historical
            analysis, attention queue, and individual project dashboards.
          </p>
        </div>
        <Badge variant="outline" data-enabled-count>
          {enabledCount} of {settings.projects.length} included
        </Badge>
      </section>

      <div class="settings-callout">
        <Icon aria-hidden="true" name="info" />
        <p>
          Disabled projects continue collecting snapshots so they can be
          restored without losing history. Their data is excluded from all
          analysis while disabled.
        </p>
      </div>

      {
        settings.projects.length === 0 ? (
          <Empty class="first-sync">
            <Icon aria-hidden="true" name="telescope" />
            <h2>No projects to configure yet</h2>
            <p>
              Run a sync from the overview to discover your public projects.
            </p>
          </Empty>
        ) : (
          <Card
            as="section"
            class="settings-panel"
            aria-labelledby="project-settings-heading"
            data-settings-panel
            data-total={settings.projects.length}
          >
            <div class="settings-panel__heading">
              <div>
                <h2 id="project-settings-heading">Included projects</h2>
                <p>Changes save immediately and apply on the next page load.</p>
              </div>
              <span class="save-state" aria-live="polite" data-save-state>
                All changes saved
              </span>
            </div>
            <ul class="project-settings-list">
              {settings.projects.map((project) => (
                <li>
                  <span class="project-icon">
                    <Icon
                      aria-hidden="true"
                      name={
                        project.category === 'app'
                          ? 'layout-dashboard'
                          : project.category === 'content'
                            ? 'notebook-tabs'
                            : project.category === 'tool'
                              ? 'wrench'
                              : 'blocks'
                      }
                    />
                  </span>
                  <div>
                    <strong>{project.name}</strong>
                    <span>
                      {project.category} · {project.status}
                    </span>
                  </div>
                  <label class="project-switch">
                    <span class="sr-only">
                      Include {project.name} in analytics
                    </span>
                    <input
                      checked={project.enabled}
                      data-project-toggle
                      data-slug={project.slug}
                      type="checkbox"
                    />
                    <span aria-hidden="true" class="project-switch__track">
                      <span />
                    </span>
                  </label>
                </li>
              ))}
            </ul>
          </Card>
        )
      }
    </main>

    <footer class="app-footer">
      <span>Preferences are private to this Observatory workspace.</span>
      <a href="/dashboard/">Return to overview</a>
    </footer>
  </div>
</AppLayout>

<script>
  const panel = document.querySelector<HTMLElement>('[data-settings-panel]')
  const apiUrl =
    document.querySelector<HTMLElement>('.app-header')?.dataset.apiUrl
  const saveState = document.querySelector<HTMLElement>('[data-save-state]')
  const count = document.querySelector<HTMLElement>('[data-enabled-count]')
  const toggles = document.querySelectorAll<HTMLInputElement>(
    '[data-project-toggle]',
  )

  const updateCount = () => {
    const enabled = [...toggles].filter((toggle) => toggle.checked).length
    const total = panel?.dataset.total ?? String(toggles.length)

    if (count) count.textContent = `${enabled} of ${total} included`
  }

  for (const toggle of toggles) {
    toggle.addEventListener('change', async () => {
      const enabled = toggle.checked

      toggle.disabled = true
      if (saveState) saveState.textContent = 'Saving…'
      updateCount()

      try {
        const response = await fetch(`${apiUrl}/settings/projects`, {
          body: JSON.stringify({
            enabled,
            slug: toggle.dataset.slug,
          }),
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          method: 'POST',
        })

        if (!response.ok) throw new Error('Save failed')

        if (saveState) saveState.textContent = 'All changes saved'
      } catch {
        toggle.checked = !enabled
        updateCount()
        if (saveState) saveState.textContent = 'Could not save — try again'
      } finally {
        toggle.disabled = false
      }
    })
  }
</script>
