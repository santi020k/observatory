---
import AppHeader from '@/components/AppHeader.astro'
import AppSidebar from '@/components/AppSidebar.astro'
import AppLayout from '@/layouts/AppLayout.astro'

import { getBrowserApiUrl, getProjectSettings } from '@/lib/api'
import { formatRelativeDate } from '@/lib/format'

import {
  Accordion,
  Alert,
  Badge,
  Button,
  Callout,
  Card,
  Empty,
  Field,
  Icon,
  Input,
  Label,
  NativeSelect,
  SearchField,
  Switch,
  Tabs
} from '@santi020k/lumen-astro'

const response = await getProjectSettings(Astro.request, Astro.url)

if (response.status === 401) return Astro.redirect('/login/')

if (!response.ok || !response.parsed)
  throw new Error('Observatory API is unavailable.')

const settings = response.parsed
const apiUrl = getBrowserApiUrl()

const enabledCount = settings.projects.filter(
  project => project.enabled
).length

const getCategoryIcon = (
  category: (typeof settings.projects)[number]['category']
): 'blocks' | 'layout-dashboard' | 'notebook-tabs' | 'wrench' => {
  if (category === 'app') return 'layout-dashboard'

  if (category === 'content') return 'notebook-tabs'

  if (category === 'tool') return 'wrench'

  return 'blocks'
}
---

<AppLayout
  description="Manage Observatory workspace and interface preferences."
  title="Settings · Observatory"
>
  <div class="app-shell">
    <AppSidebar
      projects={settings.projects.filter(project => project.enabled)}
    />
    <div class="app-workspace">
      <AppHeader
        apiUrl={apiUrl}
        lastSync={settings.sync.completedAt ?
          formatRelativeDate(settings.sync.completedAt) :
          'awaiting first sync'}
        syncStatus={settings.sync.status}
      />

      <main class="dashboard settings-dashboard" id="main-content">
        <section class="hero-row" aria-labelledby="settings-title">
          <div>
            <span class="eyebrow">Workspace preferences</span>
            <h1 id="settings-title">Settings</h1>
            <p>
              Shape what Observatory tracks and how this workspace feels in your
              browser.
            </p>
          </div>
        </section>

        <Tabs
          class="settings-tabs"
          initialValue="projects"
          storageKey="observatory.settings.active-tab"
        >
          <div aria-label="Settings sections" role="tablist">
            <button
              aria-selected="true"
              data-value="projects"
              role="tab"
              type="button"
            >
              <Icon aria-hidden="true" name="blocks" />
              Projects
            </button>
            <button
              aria-selected="false"
              data-value="display"
              role="tab"
              tabindex="-1"
              type="button"
            >
              <Icon aria-hidden="true" name="panel-top" />
              Display
            </button>
            <button
              aria-selected="false"
              data-value="security"
              role="tab"
              tabindex="-1"
              type="button"
            >
              <Icon aria-hidden="true" name="fingerprint" />
              Security
            </button>
            <button
              aria-selected="false"
              data-value="privacy"
              role="tab"
              tabindex="-1"
              type="button"
            >
              <Icon aria-hidden="true" name="shield-check" />
              Privacy
            </button>
          </div>

          <section data-value="projects" role="tabpanel">
            <div class="settings-section-heading">
              <div>
                <span class="eyebrow">Catalog</span>
                <h2>Project controls</h2>
                <p>
                  Tune how every project appears, which signals matter, and what
                  Observatory collects.
                </p>
              </div>
              <Badge variant="outline" data-enabled-count>
                {enabledCount} of {settings.projects.length} included
              </Badge>
            </div>

            <Callout class="settings-callout">
              <Icon aria-hidden="true" name="info" />
              <p>
                Disabled projects continue collecting snapshots so they can be
                restored without losing history. Their data is excluded from
                analysis while disabled.
              </p>
            </Callout>

            {
              settings.projects.length === 0 ?
                (
                  <Empty class="first-sync">
                    <Icon aria-hidden="true" name="telescope" />
                    <h2>No projects to configure yet</h2>
                    <p>
                      Run a sync from the overview to discover your public
                      projects.
                    </p>
                  </Empty>
                ) :
                (
                  <Card
                    as="section"
                    class="settings-panel"
                    aria-labelledby="project-settings-heading"
                    data-settings-panel
                    data-total={settings.projects.length}
                  >
                    <div class="settings-panel__heading">
                      <div>
                        <h3 id="project-settings-heading">Project settings</h3>
                        <p>
                          Open a project to adjust its workspace behavior. Changes
                          save immediately.
                        </p>
                      </div>
                      <span class="save-state" aria-live="polite" data-save-state>
                        All changes saved
                      </span>
                    </div>
                    <div
                      class="project-settings-filters"
                      aria-label="Filter project settings"
                      role="search"
                    >
                      <SearchField
                        aria-label="Search project settings"
                        data-project-settings-search
                        placeholder="Search projects"
                      />
                      <NativeSelect
                        aria-label="Filter by inclusion"
                        data-project-settings-scope
                        options={[
                          { label: 'All projects', value: 'all' },
                          { label: 'Included', value: 'included' },
                          { label: 'Excluded', value: 'excluded' }
                        ]}
                        size="sm"
                      />
                      <span
                        class="project-settings-result"
                        aria-live="polite"
                        data-project-settings-result
                      >
                        {settings.projects.length} projects
                      </span>
                    </div>
                    <Accordion class="project-settings-list" variant="flush">
                      {settings.projects.map((project, index) => (
                        <details
                          data-enabled={String(project.enabled)}
                          data-project-name={project.name.toLocaleLowerCase()}
                          data-project-settings-item
                          id={`project-${project.slug}`}
                          open={index === 0}
                        >
                          <summary>
                            <span class="project-icon">
                              <Icon
                                aria-hidden="true"
                                name={getCategoryIcon(project.category)}
                              />
                            </span>
                            <span class="project-settings-summary">
                              <strong>{project.name}</strong>
                              <span data-project-details>
                                {project.category} · {project.status} · relevance{' '}
                                {project.relevanceScore}
                              </span>
                            </span>
                            <span class="project-settings-badges">
                              <Badge
                                data-project-pin-state
                                data-slug={project.slug}
                                hidden={!project.pinned}
                                variant="secondary"
                              >
                                <Icon aria-hidden="true" name="pin" />
                                Pinned
                              </Badge>
                              <Badge
                                data-enabled={String(project.enabled)}
                                data-project-state
                                data-slug={project.slug}
                                variant={project.enabled ? 'success' : 'outline'}
                              >
                                {project.enabled ? 'Included' : 'Excluded'}
                              </Badge>
                            </span>
                          </summary>

                          <div class="project-settings-content">
                            <div class="project-settings-grid">
                              <section class="project-setting-card">
                                <span class="project-setting-icon">
                                  <Icon
                                    aria-hidden="true"
                                    name="chart-no-axes-combined"
                                  />
                                </span>
                                <div>
                                  <h4 id={`analytics-${project.slug}`}>
                                    Include in Observatory
                                  </h4>
                                  <p id={`analytics-help-${project.slug}`}>
                                    Contribute to portfolio metrics, history, and
                                    project dashboards.
                                  </p>
                                </div>
                                <Switch
                                  aria-describedby={`analytics-help-${project.slug}`}
                                  aria-labelledby={`analytics-${project.slug}`}
                                  checked={project.enabled}
                                  data-project-control
                                  data-project-setting="enabled"
                                  data-saved-value={String(project.enabled)}
                                  data-slug={project.slug}
                                />
                              </section>

                              <section class="project-setting-card">
                                <span class="project-setting-icon">
                                  <Icon aria-hidden="true" name="pin" />
                                </span>
                                <div>
                                  <h4 id={`pin-${project.slug}`}>
                                    Pin in navigation
                                  </h4>
                                  <p id={`pin-help-${project.slug}`}>
                                    Keep this project ahead of the rest in the
                                    sidebar.
                                  </p>
                                </div>
                                <Switch
                                  aria-describedby={`pin-help-${project.slug}`}
                                  aria-labelledby={`pin-${project.slug}`}
                                  checked={project.pinned}
                                  data-project-control
                                  data-project-setting="pinned"
                                  data-saved-value={String(project.pinned)}
                                  data-slug={project.slug}
                                />
                              </section>

                              <section class="project-setting-card">
                                <span class="project-setting-icon">
                                  <Icon aria-hidden="true" name="list-filter" />
                                </span>
                                <div>
                                  <label for={`attention-${project.slug}`}>
                                    Attention signals
                                  </label>
                                  <p id={`attention-help-${project.slug}`}>
                                    Decide what can place this project in the
                                    attention queue.
                                  </p>
                                </div>
                                <NativeSelect
                                  aria-describedby={`attention-help-${project.slug}`}
                                  data-project-control
                                  data-project-setting="attentionMode"
                                  data-saved-value={project.attentionMode}
                                  data-slug={project.slug}
                                  id={`attention-${project.slug}`}
                                  size="sm"
                                >
                                  <option
                                    selected={project.attentionMode === 'all'}
                                    value="all"
                                  >
                                    All signals
                                  </option>
                                  <option
                                    selected={project.attentionMode === 'health'}
                                    value="health"
                                  >
                                    Health only
                                  </option>
                                  <option
                                    selected={project.attentionMode === 'off'}
                                    value="off"
                                  >
                                    Muted
                                  </option>
                                </NativeSelect>
                              </section>

                              <section
                                class:list={[
                                  'project-setting-card',
                                  !project.hasWebsite &&
                                  'project-setting-card--unavailable'
                                ]}
                              >
                                <span class="project-setting-icon">
                                  <Icon aria-hidden="true" name="globe-2" />
                                </span>
                                <div>
                                  <h4 id={`website-${project.slug}`}>
                                    Website analytics
                                  </h4>
                                  <p id={`website-help-${project.slug}`}>
                                    {project.hasWebsite ?
                                      'Collect and show Cloudflare traffic for this project.' :
                                      'Add a website URL to the catalog to enable this source.'}
                                  </p>
                                </div>
                                <Switch
                                  aria-describedby={`website-help-${project.slug}`}
                                  aria-labelledby={`website-${project.slug}`}
                                  checked={
                                    project.hasWebsite &&
                                    project.websiteAnalyticsEnabled
                                  }
                                  data-project-control
                                  data-project-setting="websiteAnalyticsEnabled"
                                  data-saved-value={String(
                                    project.websiteAnalyticsEnabled
                                  )}
                                  data-slug={project.slug}
                                  disabled={!project.hasWebsite}
                                />
                              </section>
                            </div>

                            <div class="project-settings-footer">
                              <span>
                                <Icon aria-hidden="true" name="sparkles" />
                                Relevance score {project.relevanceScore}
                              </span>
                              <a
                                class="project-settings-link"
                                href={`/projects/${project.slug}/`}
                              >
                                View project
                                <Icon aria-hidden="true" name="arrow-up-right" />
                              </a>
                            </div>
                          </div>
                        </details>
                      ))}
                    </Accordion>
                    <Empty data-project-settings-empty hidden>
                      <Icon aria-hidden="true" name="search-x" />
                      <h3>No matching projects</h3>
                      <p>Try another name or inclusion filter.</p>
                    </Empty>
                  </Card>
                )
            }
          </section>

          <section data-value="display" hidden role="tabpanel">
            <div class="settings-section-heading">
              <div>
                <span class="eyebrow">This browser</span>
                <h2>Display preferences</h2>
                <p>
                  Tune the density and motion of Observatory on this device.
                  Changes are applied and saved immediately.
                </p>
              </div>
              <span class="save-state" aria-live="polite" data-local-save-state>
                Saved in this browser
              </span>
            </div>

            <Card as="section" class="settings-panel preference-panel">
              <div class="preference-row">
                <div>
                  <label for="project-row-density">Project row density</label>
                  <p>Control how much vertical space catalog rows use.</p>
                </div>
                <NativeSelect
                  aria-label="Project row density"
                  data-preference="density"
                  id="project-row-density"
                  options={[
                    { label: 'Comfortable', value: 'comfortable' },
                    { label: 'Compact', value: 'compact' }
                  ]}
                  size="sm"
                />
              </div>
              <div class="preference-row">
                <div>
                  <label for="show-project-details">
                    Show project metadata
                  </label>
                  <p id="show-project-details-description">
                    Display category and health status below project names.
                  </p>
                </div>
                <Switch
                  aria-describedby="show-project-details-description"
                  aria-label="Show project metadata"
                  data-preference="showDetails"
                  id="show-project-details"
                />
              </div>
              <div class="preference-row">
                <div>
                  <label for="reduce-interface-motion">
                    Reduce interface motion
                  </label>
                  <p id="reduce-interface-motion-description">
                    Minimize nonessential transitions in this workspace.
                  </p>
                </div>
                <Switch
                  aria-describedby="reduce-interface-motion-description"
                  aria-label="Reduce interface motion"
                  data-preference="reduceMotion"
                  id="reduce-interface-motion"
                />
              </div>
            </Card>
          </section>

          <section data-value="security" hidden role="tabpanel">
            <div class="settings-section-heading">
              <div>
                <span class="eyebrow">Owner access</span>
                <h2>Passkeys</h2>
                <p>
                  Use Face ID, Touch ID, Windows Hello, or a hardware security
                  key to open Observatory without typing a code.
                </p>
              </div>
              <Badge data-passkey-count variant="outline">Loading…</Badge>
            </div>

            <Alert
              aria-atomic="true"
              aria-live="polite"
              data-passkey-alert
              hidden
              role="status"
            />

            <Card
              as="section"
              aria-labelledby="passkey-devices-heading"
              class="settings-panel passkey-panel"
            >
              <div class="settings-panel__heading">
                <div>
                  <h3 id="passkey-devices-heading">Trusted devices</h3>
                  <p>
                    The private key remains in your device or password manager.
                  </p>
                </div>
                <Icon aria-hidden="true" name="shield-check" />
              </div>

              <div
                aria-live="polite"
                class="passkey-list"
                data-passkey-list
              >
                <p data-passkey-loading>Loading registered passkeys…</p>
              </div>

              <form
                class="passkey-create"
                data-api-url={apiUrl}
                data-passkey-form
                data-ui-form
              >
                <Field>
                  <Label for="passkey-name">Device name</Label>
                  <Input
                    id="passkey-name"
                    maxlength="80"
                    name="name"
                    placeholder="My MacBook"
                    required
                  />
                </Field>
                <Button data-passkey-create type="submit">
                  <Icon aria-hidden="true" name="key-round" />
                  <span data-passkey-create-label>Create passkey</span>
                </Button>
              </form>
            </Card>

            <Callout class="settings-callout">
              <Icon aria-hidden="true" name="life-buoy" />
              <p>
                Your private recovery code remains available if a trusted
                device is lost. Observatory never displays or returns it.
              </p>
            </Callout>
          </section>

          <section data-value="privacy" hidden role="tabpanel">
            <div class="settings-section-heading">
              <div>
                <span class="eyebrow">Data controls</span>
                <h2>Privacy & storage</h2>
                <p>
                  Review where your settings live and clear preferences stored
                  by this browser.
                </p>
              </div>
            </div>

            <div class="privacy-grid">
              <Card as="article" class="privacy-card">
                <span class="preference-icon">
                  <Icon aria-hidden="true" name="lock-keyhole" />
                </span>
                <div>
                  <h3>Private workspace</h3>
                  <p>
                    Project names and private metrics are only returned to the
                    authenticated owner of this Observatory.
                  </p>
                </div>
                <Badge variant="success">Owner only</Badge>
              </Card>
              <Card as="article" class="privacy-card">
                <span class="preference-icon">
                  <Icon aria-hidden="true" name="monitor" />
                </span>
                <div>
                  <h3>Browser preferences</h3>
                  <p>
                    Display choices and the last-opened settings tab remain on
                    this device. Project visibility stays in Observatory.
                  </p>
                </div>
                <Button
                  data-clear-preferences
                  size="sm"
                  type="button"
                  variant="outline"
                >
                  Clear preferences
                </Button>
              </Card>
            </div>
          </section>
        </Tabs>
      </main>

      <footer class="app-footer">
        <span>Preferences are private to this Observatory workspace.</span>
        <a href="/dashboard/">Return to overview</a>
      </footer>
    </div>
  </div>
</AppLayout>

<script>
const preferenceKey = 'observatory.settings.preferences'

interface BrowserPreferences {
  density: 'comfortable' | 'compact'
  reduceMotion: boolean
  showDetails: boolean
}

const defaultPreferences: BrowserPreferences = {
  density: 'comfortable',
  reduceMotion: false,
  showDetails: true
}

const readPreferences = (): BrowserPreferences => {
  try {
    const stored = JSON.parse(
      localStorage.getItem(preferenceKey) ?? '{}'
    ) as Partial<BrowserPreferences>

    return { ...defaultPreferences, ...stored }
  } catch {
    return defaultPreferences
  }
}

const applyPreferences = (preferences: BrowserPreferences) => {
  document.documentElement.dataset.observatoryDensity = preferences.density

  document.documentElement.dataset.observatoryReduceMotion = String(
    preferences.reduceMotion
  )

  document.documentElement.dataset.observatoryShowDetails = String(
    preferences.showDetails
  )

  const densitySelect = document.querySelector<HTMLSelectElement>(
    '[data-preference="density"]'
  )

  const showDetails = document.querySelector<HTMLInputElement>(
    '[data-preference="showDetails"]'
  )

  const reduceMotion = document.querySelector<HTMLInputElement>(
    '[data-preference="reduceMotion"]'
  )

  if (densitySelect) densitySelect.value = preferences.density

  if (showDetails) showDetails.checked = preferences.showDetails

  if (reduceMotion) reduceMotion.checked = preferences.reduceMotion
}

let browserPreferences = readPreferences()

applyPreferences(browserPreferences)

const localSaveState = document.querySelector<HTMLElement>(
  '[data-local-save-state]'
)

const readPreferenceControls = (): BrowserPreferences => ({
  density:
    document.querySelector<HTMLSelectElement>(
      '[data-preference="density"]'
    )?.value === 'compact' ?
      'compact' :
      'comfortable',
  reduceMotion:
    document.querySelector<HTMLInputElement>(
      '[data-preference="reduceMotion"]'
    )?.checked ?? false,
  showDetails:
    document.querySelector<HTMLInputElement>(
      '[data-preference="showDetails"]'
    )?.checked ?? true
})

const saveBrowserPreferences = (preferences: BrowserPreferences): boolean => {
  try {
    localStorage.setItem(preferenceKey, JSON.stringify(preferences))

    return true
  } catch {
    return false
  }
}

const announcePreferenceSave = (saved: boolean) => {
  if (!localSaveState) return

  if (!saved) {
    localSaveState.textContent = 'Browser storage is unavailable'

    return
  }

  localSaveState.textContent = 'Saved just now'

  window.setTimeout(() => {
    localSaveState.textContent = 'Saved in this browser'
  }, 1_600)
}

for (const control of document.querySelectorAll<
    HTMLInputElement | HTMLSelectElement
>('[data-preference]')) {
  control.addEventListener('change', () => {
    browserPreferences = readPreferenceControls()

    applyPreferences(browserPreferences)

    announcePreferenceSave(saveBrowserPreferences(browserPreferences))
  })
}

document
  .querySelector<HTMLButtonElement>('[data-clear-preferences]')
  ?.addEventListener('click', event => {
    try {
      localStorage.removeItem(preferenceKey)

      localStorage.removeItem('observatory.settings.active-tab')
    } catch {
      // Applying the defaults still works when browser storage is blocked.
    }

    browserPreferences = { ...defaultPreferences }

    applyPreferences(browserPreferences)

    const button = event.currentTarget as HTMLButtonElement

    button.textContent = 'Preferences cleared'

    window.setTimeout(() => {
      button.textContent = 'Clear preferences'
    }, 1_600)
  })

const panel = document.querySelector<HTMLElement>('[data-settings-panel]')

const apiUrl =
  document.querySelector<HTMLElement>('.app-header')?.dataset.apiUrl

const saveState = document.querySelector<HTMLElement>('[data-save-state]')
const count = document.querySelector<HTMLElement>('[data-enabled-count]')

const inclusionToggles = document.querySelectorAll<HTMLInputElement>(
  '[data-project-setting="enabled"]'
)

const projectControls = document.querySelectorAll<
    HTMLInputElement | HTMLSelectElement
>('[data-project-control]')

const projectSearch = document.querySelector<HTMLInputElement>(
  '[data-project-settings-search]'
)

const projectScope = document.querySelector<HTMLSelectElement>(
  '[data-project-settings-scope]'
)

const projectItems = [
  ...document.querySelectorAll<HTMLDetailsElement>(
    '[data-project-settings-item]'
  )
]

const projectResult = document.querySelector<HTMLElement>(
  '[data-project-settings-result]'
)

const projectFilterEmpty = document.querySelector<HTMLElement>(
  '[data-project-settings-empty]'
)

const matchesProjectScope = (
  item: HTMLDetailsElement,
  scope: string
): boolean => scope === 'all' ||
  (scope === 'included' && item.dataset.enabled === 'true') ||
  (scope === 'excluded' && item.dataset.enabled === 'false')

const updateProjectItemVisibility = (
  item: HTMLDetailsElement,
  query: string,
  scope: string
): boolean => {
  const matchesQuery =
    query.length === 0 ||
    item.dataset.projectName?.includes(query) === true

  const visible = matchesQuery && matchesProjectScope(item, scope)

  item.hidden = !visible

  return visible
}

const updateProjectFilterSummary = (visible: number) => {
  if (projectResult)
    projectResult.textContent =
      `${visible} project${visible === 1 ? '' : 's'}`

  projectFilterEmpty?.toggleAttribute('hidden', visible > 0)
}

const updateProjectFilters = () => {
  const query = projectSearch?.value.trim().toLocaleLowerCase() ?? ''
  const scope = projectScope?.value ?? 'all'

  const visible = projectItems.filter(
    item => updateProjectItemVisibility(item, query, scope)
  ).length

  updateProjectFilterSummary(visible)
}

projectSearch?.addEventListener('input', updateProjectFilters)

projectScope?.addEventListener('change', updateProjectFilters)

const updateCount = () => {
  const enabled = [...inclusionToggles].filter(
    toggle => toggle.checked
  ).length

  const total = panel?.dataset.total ?? String(inclusionToggles.length)

  if (count) count.textContent = `${enabled} of ${total} included`
}

const updateProjectState = (slug: string | undefined, enabled: boolean) => {
  if (!slug) return

  const state = document.querySelector<HTMLElement>(
    `[data-project-state][data-slug="${CSS.escape(slug)}"]`
  )

  if (!state) return

  state.textContent = enabled ? 'Included' : 'Excluded'

  state.dataset.enabled = String(enabled)

  const item = state.closest<HTMLDetailsElement>(
    '[data-project-settings-item]'
  )

  if (item) item.dataset.enabled = String(enabled)

  updateProjectFilters()
}

const updatePinnedState = (slug: string | undefined, pinned: boolean) => {
  if (!slug) return

  const state = document.querySelector<HTMLElement>(
    `[data-project-pin-state][data-slug="${CSS.escape(slug)}"]`
  )

  if (state) state.hidden = !pinned
}

const updateSidebar = async () => {
  try {
    const response = await fetch(window.location.href)
    const html = await response.text()
    const doc = new DOMParser().parseFromString(html, 'text/html')
    const newSidebar = doc.querySelector('.sidebar-projects')
    const currentSidebar = document.querySelector('.sidebar-projects')

    if (newSidebar && currentSidebar) {
      currentSidebar.replaceWith(newSidebar)
    }
  } catch {
    // Ignore failures
  }
}

const setControlValue = (
  control: HTMLInputElement | HTMLSelectElement,
  value: string
) => {
  if (control instanceof HTMLInputElement) {
    control.checked = value === 'true'

    return
  }

  control.value = value
}

const getControlValue = (
  control: HTMLInputElement | HTMLSelectElement
): boolean | string => control instanceof HTMLInputElement ? control.checked : control.value

const getSavedControlValue = (
  control: HTMLInputElement | HTMLSelectElement
): string => control.dataset.savedValue ??
  (control instanceof HTMLInputElement ?
    String(!control.checked) :
    control.value)

const applyOptimisticProjectState = (
  field: string,
  slug: string,
  value: boolean | string
) => {
  if (field === 'enabled') {
    updateCount()

    updateProjectState(slug, Boolean(value))
  }

  if (field === 'pinned') updatePinnedState(slug, Boolean(value))
}

const restoreProjectState = (
  control: HTMLInputElement | HTMLSelectElement,
  field: string,
  slug: string,
  savedValue: string
) => {
  setControlValue(control, savedValue)

  if (field === 'enabled') {
    updateCount()

    updateProjectState(slug, savedValue === 'true')
  }

  if (field === 'pinned') updatePinnedState(slug, savedValue === 'true')
}

const persistProjectSetting = async (
  field: string,
  slug: string,
  value: boolean | string
) => {
  const response = await fetch(`${apiUrl}/settings/projects`, {
    body: JSON.stringify({
      [field]: value,
      slug
    }),
    credentials: 'include',
    headers: { 'Content-Type': 'application/json' },
    method: 'POST'
  })

  if (!response.ok) throw new Error('Save failed')

  if (field === 'enabled' || field === 'pinned') await updateSidebar()
}

for (const control of projectControls) {
  control.addEventListener('change', async () => {
    const field = control.dataset.projectSetting
    const slug = control.dataset.slug

    if (!field || !slug) return

    const savedValue = getSavedControlValue(control)
    const value = getControlValue(control)

    control.disabled = true

    if (saveState) saveState.textContent = 'Saving…'

    applyOptimisticProjectState(field, slug, value)

    try {
      await persistProjectSetting(field, slug, value)

      control.dataset.savedValue = String(value)

      if (saveState) saveState.textContent = 'All changes saved'
    } catch {
      restoreProjectState(control, field, slug, savedValue)

      if (saveState) saveState.textContent = 'Could not save — try again'
    } finally {
      control.disabled = false
    }
  })
}
</script>

<script>
import {
  deletePasskey,
  listPasskeys,
  registerPasskey,
  supportsPasskeys
} from '@/lib/passkeys'

import type { PasskeyCredential } from '@santi020k/observatory-api-types'

const passkeyForm = document.querySelector<HTMLFormElement>('[data-passkey-form]')
const passkeyList = document.querySelector<HTMLElement>('[data-passkey-list]')
const passkeyCount = document.querySelector<HTMLElement>('[data-passkey-count]')
const passkeyAlert = document.querySelector<HTMLElement>('[data-passkey-alert]')
const passkeyApiUrl = passkeyForm?.dataset.apiUrl ?? '/api'
let passkeys: PasskeyCredential[] = []

const formatPasskeyDate = (value: number | null): string => value === null ?
  'Not used yet' :
  `Last used ${new Intl.DateTimeFormat(undefined, {
    dateStyle: 'medium',
    timeStyle: 'short'
  }).format(new Date(value))}`

const showPasskeyMessage = (message: string, destructive = false) => {
  if (!passkeyAlert) return

  passkeyAlert.hidden = false

  passkeyAlert.textContent = message

  passkeyAlert.dataset.variant = destructive ? 'destructive' : 'default'
}

const renderPasskeys = () => {
  if (passkeyCount) {
    passkeyCount.textContent = `${passkeys.length} registered`
  }

  if (!passkeyList) return

  passkeyList.replaceChildren()

  if (passkeys.length === 0) {
    const empty = document.createElement('p')

    empty.className = 'passkey-empty'

    empty.textContent = 'No passkeys registered yet. Create one on this device.'

    passkeyList.append(empty)

    return
  }

  for (const credential of passkeys) {
    const row = document.createElement('div')
    const details = document.createElement('div')
    const name = document.createElement('strong')
    const metadata = document.createElement('span')
    const remove = document.createElement('button')

    row.className = 'passkey-row'

    details.className = 'passkey-row__details'

    name.textContent = credential.name

    metadata.textContent = formatPasskeyDate(credential.lastUsedAt)

    remove.className = 'passkey-remove'

    remove.type = 'button'

    remove.textContent = 'Remove'

    remove.setAttribute('aria-label', `Remove ${credential.name}`)

    remove.addEventListener('click', async () => {
      remove.disabled = true

      try {
        await deletePasskey(passkeyApiUrl, credential.id)

        passkeys = passkeys.filter(item => item.id !== credential.id)

        renderPasskeys()

        showPasskeyMessage('Passkey removed.')
      } catch (error) {
        remove.disabled = false

        showPasskeyMessage(
          error instanceof Error ? error.message : 'Could not remove the passkey.', true
        )
      }
    })

    details.append(name, metadata)

    row.append(details, remove)

    passkeyList.append(row)
  }
}

const loadPasskeys = async () => {
  try {
    passkeys = await listPasskeys(passkeyApiUrl)

    renderPasskeys()
  } catch (error) {
    showPasskeyMessage(
      error instanceof Error ? error.message : 'Could not load passkeys.', true
    )
  }
}

if (!supportsPasskeys()) {
  const createButton = passkeyForm?.querySelector<HTMLButtonElement>(
    '[data-passkey-create]'
  )

  if (createButton) createButton.disabled = true

  showPasskeyMessage('This browser does not support passkeys.', true)
}

passkeyForm?.addEventListener('submit', async event => {
  event.preventDefault()

  const button = passkeyForm.querySelector<HTMLButtonElement>(
    '[data-passkey-create]'
  )

  const label = passkeyForm.querySelector<HTMLElement>(
    '[data-passkey-create-label]'
  )

  const name = String(new FormData(passkeyForm).get('name') ?? '').trim()

  if (!name) return

  if (button) button.disabled = true

  if (label) label.textContent = 'Creating…'

  if (passkeyAlert) passkeyAlert.hidden = true

  try {
    const credential = await registerPasskey(passkeyApiUrl, name)

    passkeys = [...passkeys, credential]

    passkeyForm.reset()

    renderPasskeys()

    showPasskeyMessage('Passkey created. You can use it on your next sign-in.')
  } catch (error) {
    showPasskeyMessage(
      error instanceof Error ? error.message : 'Could not create the passkey.', true
    )
  } finally {
    if (button) button.disabled = false

    if (label) label.textContent = 'Create passkey'
  }
})

loadPasskeys()
</script>
