---
import '@santi020k/lumen-astro/styles.css'
import '@/styles/global.css'

import SkipLink from '@santi020k/lumen-astro/components/SkipLink'
import UIPrimitives from '@santi020k/lumen-astro/runtime'
import { colors, typography } from '@santi020k/theme'

interface Props {
  description: string
  title: string
}

const { description, title } = Astro.props

const typographyVariables = `
  --santi020k-font-sans: ${typography.body};
  --santi020k-font-display: ${typography.display};
  --santi020k-font-mono: ${typography.mono};
`

const lightVariables = colors
  .map(token => `--${token.name}: ${token.light};`)
  .join('')

const darkVariables = colors
  .map(token => `--${token.name}: ${token.dark};`)
  .join('')

const lightContrastVariables = colors
  .map(token => `--${token.name}: ${token.lightContrast ?? token.light};`)
  .join('')

const darkContrastVariables = colors
  .map(token => `--${token.name}: ${token.darkContrast ?? token.dark};`)
  .join('')

const themeCss = `
  :root,
  :root[data-theme='light'] {
    color-scheme: light;
    ${typographyVariables}
    ${lightVariables}
  }

  :root[data-theme='dark'] {
    color-scheme: dark;
    ${darkVariables}
  }

  @media (prefers-contrast: more) {
    :root,
    :root[data-theme='light'] {
      ${lightContrastVariables}
    }

    :root[data-theme='dark'] {
      ${darkContrastVariables}
    }
  }
`
---

<!doctype html>
<html lang="en" class="dark" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="hsl(260 43% 8%)" />
    <style is:global set:html={themeCss}></style>
    <script is:inline>
    const readStoredTheme = () => {
      const storedTheme = localStorage.getItem('lumen-theme')

      if (storedTheme === 'light' || storedTheme === 'santi020k-light')
        return 'light'

      return 'dark'
    }

    const applyStoredPreferences = root => {
      const preferences = JSON.parse(
        localStorage.getItem('observatory.settings.preferences') ?? '{}'
      )

      root.dataset.observatoryDensity =
        preferences.density === 'compact' ? 'compact' : 'comfortable'

      root.dataset.observatoryReduceMotion = String(
        preferences.reduceMotion === true
      )

      root.dataset.observatoryShowDetails = String(
        preferences.showDetails !== false
      )
    }

    const applyObservatoryPreferences = () => {
      const root = document.documentElement
      let theme = 'dark'

      try {
        theme = readStoredTheme()

        localStorage.setItem('lumen-theme', theme)
        applyStoredPreferences(root)
      } catch {
        // Storage may be unavailable; retain Observatory's defaults.
      }

      root.dataset.theme = theme

      root.classList.toggle('dark', theme === 'dark')

      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute(
          'content', theme === 'dark' ? 'hsl(260 43% 8%)' : 'hsl(268 20% 98%)'
    )
    }

    applyObservatoryPreferences()
    </script>
    <title>{title}</title>
  </head>
  <body>
    <SkipLink href="#main-content">Skip to main content</SkipLink>
    <slot />
    <UIPrimitives />
    <script>
    document.addEventListener('ui:theme-change', event => {
      const theme = (event as CustomEvent<{ theme?: string }>).detail?.theme

      if (theme !== 'light' && theme !== 'dark') return

      document
        .querySelector<HTMLMetaElement>('meta[name="theme-color"]')
        ?.setAttribute(
          'content', theme === 'dark' ? 'hsl(260 43% 8%)' : 'hsl(268 20% 98%)'
    )
    })
    </script>
  </body>
</html>
