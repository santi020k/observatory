{
  "name": "@santi020k/observatory-web",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "check": "astro check",
    "clean": "rm -rf .astro dist",
    "deploy": "wrangler deploy",
    "dev": "astro dev --port 4321",
    "doctor": "astro-doctor --dir . --preset recommended --fail-on error",
    "lint": "eslint src --cache --no-warn-ignored --max-warnings=0",
    "lint:fix": "eslint src --cache --fix --no-warn-ignored --max-warnings=0",
    "preview": "astro preview",
    "test": "vitest run",
    "type-check": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "catalog:",
    "@santi020k/auth-client": "catalog:",
    "@santi020k/lumen-astro": "catalog:",
    "@santi020k/observatory-api-types": "workspace:*",
    "@santi020k/theme": "catalog:",
    "@simplewebauthn/browser": "catalog:",
    "astro": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@santi020k/astro-doctor": "catalog:",
    "@types/node": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
